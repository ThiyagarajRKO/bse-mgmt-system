{
  "name": "bse-mgmt-system",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run build:fast && npm run copy-assets && node --max-old-space-size=4096 dist",
    "start:dev": "npm run copy-assets && nodemon --exec babel-node --max-old-space-size=8192 src/index.js",
    "dev": "npm run copy-assets && nodemon --exec babel-node --max-old-space-size=8192 src/index.js",
    "clean": "rm -rf dist",
    "build": "npm run clean && babel src --out-dir dist --ignore '**/*.test.js,**/*.spec.js' --no-babelrc",
    "build:fast": "babel src --out-dir dist --ignore '**/*.test.js,**/*.spec.js' --no-babelrc",
    "build:watch": "babel src --out-dir dist --watch --ignore '**/*.test.js,**/*.spec.js' --no-babelrc",
    "rebuild": "rm -rf dist && babel src --out-dir dist --ignore '**/*.test.js,**/*.spec.js' --no-babelrc",
    "build:parallel": "npm run clean && babel src --out-dir dist --no-babelrc",
    "copy-assets": "node scripts/utilities/copy-assets.js",
    "migrate": "node_modules/sequelize-cli/lib/sequelize db:migrate",
    "seed": "node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "migrate:product-master": "node scripts/run-product-master-migration.js",
    "seed:product-master": "node scripts/run-product-master-seeder.js",
    "setup:product-master": "node scripts/run-product-master-full.js",
    "lint": "eslint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.24.0",
    "@babel/node": "^7.23.9",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.24.0",
    "@fastify/autoload": "^5.8.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/middie": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/session": "^10.9.0",
    "@fastify/static": "^7.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/view": "^9.0.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "aws-sdk": "^2.1580.0",
    "axios": "^1.6.8",
    "bad-words": "^3.0.4",
    "bcrypt": "^5.1.1",
    "boom": "^7.3.0",
    "connect-session-sequelize": "^7.1.7",
    "cron": "^3.1.6",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.9",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "firebase-admin": "^12.0.0",
    "googleapis": "^134.0.0",
    "i": "^0.3.7",
    "jquery": "^3.7.1",
    "js-beautify": "^1.15.4",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "node-fetch": "^3.3.2",
    "node-schedule": "^2.1.1",
    "nodemon": "^3.1.0",
    "npm": "^10.5.0",
    "otp-generator": "^4.0.1",
    "pg": "^8.16.3",
    "point-of-view": "^6.3.0",
    "qrcode": "^1.5.3",
    "select2": "^4.1.0-rc.0",
