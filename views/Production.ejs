            const response = await fetch('/api/qa/autopopulate', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({}),
              credentials: 'include',
            });

            if (response.ok) {
              const result = await response.json();
              console.log('Auto-populate result:', result);
              if (result.created > 0) {
                toastr.success(`Created ${result.created} new QA records from peeling data`);
              }
            } else {
              console.warn('Auto-populate failed:', response.status);
            }
          } catch (err) {
            console.error('Error auto-populating QA records:', err);
          }
        }

        // Load QA Table Data
        function loadQATableData() {
          // Properly destroy and reinitialize the table
          if ($.fn.DataTable.isDataTable("#qaTable")) {
            var table = $("#qaTable").DataTable();
            table.destroy(false); // false parameter keeps the DOM intact
          }
