                            0%
                          </text>
                        </svg>
                      </td>
                      <td>
                        <div class="d-flex flex-column">
                          <span class="progressBar-label heading">Peeling</span>
                          <div class="weightContainer">
                            <span
                              class="progressBar-weight weight preprocessingWeight"
                              style="font-weight: RedditMono-Regular"
                              >0</span
                            >
                            <span class="progressBar-weight-unit">kg</span>
                          </div>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="col qaMetric">
              <div class="stepper-menu border rounded">
                <table>
                  <tbody>
                    <tr>
                      <td class="p-3">
                        <svg
                          class="radial-progress"
                          id="qaCircle"
                          data-percentage="0"
                          viewBox="0 0 80 80"
                        >
                          <circle
                            class="incomplete"
                            cx="40"
                            cy="40"
                            r="35"
                          ></circle>
                          <circle
                            class="complete"
                            cx="40"
                            cy="40"
                            r="35"
                            style="stroke-dashoffset: 0"
                          ></circle>
                          <text
                            id="qaPercentage"
                            class="percentage"
                            x="50%"
                            y="57%"
                            transform="matrix(0, 1, -1, 0, 80, 0)"
