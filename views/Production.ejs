        let globalPackagingData = []; // Store packaging data globally

        function loadPackingPackage(productId = null, market = "RETAIL") {
          console.log("=== loadPackingPackage called ===");
          // Load packaging options from the packaging master API
          $.ajax({
            url: `/api/master/packaging`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: true,
            success: (response) => {
              console.log("Packaging master response received, count:", response?.data?.count);
              let packagingData = [];

              if (response?.data?.rows && Array.isArray(response.data.rows)) {
                // Transform packaging master data to select2 format
                packagingData = response.data.rows.map(pkg => ({
                  id: pkg.id,
                  text: pkg.packaging_code || pkg.packaging_name || 'Unknown',
                  packaging_type: pkg.packaging_type,
                  packaging_weight: pkg.packaging_weight,
                  dimensions: {
                    height: pkg.packaging_height,
                    width: pkg.packaging_width,
                    length: pkg.packaging_length
                  },
                  is_ai_recommended: false,
                  ai_score: null
                }));
              }

              // Store globally
              globalPackagingData = packagingData;
              console.log("Stored packaging data, length:", globalPackagingData.length);

              // Initialize select2 with all packaging options
              initializePackagingSelect2(packagingData);
              console.log("Initialized select2 with packaging data");

              // Check if we have quantity - if yes, load AI recommendations and merge
              const quantity = $("#packing_quantity").val();
              console.log("Current quantity:", quantity);
              if (quantity && parseFloat(quantity) > 0) {
                console.log("Quantity exists, calling loadAndMergeAIRecommendations");
                loadAndMergeAIRecommendations();
              }

              $("#packingPackage").val(null).trigger("change");
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("Packaging Master API Error:", jqXhr);
              if (jqXhr.status == 420) {
                toastr["warning"](jqXhr.responseJSON?.message || "Warning loading packaging options");
              }

              // Fallback: still initialize select2 even if API fails
              initializePackagingSelect2([]);
            },
          });
        }

        function initializePackagingSelect2(packagingData) {
          console.log("Initializing select2 with", packagingData.length, "items");

          try {
            // Try to destroy existing select2 instance if it exists
            if ($("#packingPackage").data("select2")) {
              $("#packingPackage").select2("destroy");
            }
          } catch (e) {
            console.log("No existing select2 instance to destroy");
          }

          // Clear the select element
          $("#packingPackage").empty();

          // Add placeholder option
          $("#packingPackage").append('<option></option>');

          // Sort packaging data: AI-recommended first (by AI score descending), then rest
          const sortedData = [...packagingData].sort((a, b) => {
            // If both are AI recommended, sort by score descending
            if (a.is_ai_recommended && b.is_ai_recommended) {
              return (b.ai_score || 0) - (a.ai_score || 0);
            }
            // AI recommended items come first
            if (a.is_ai_recommended) return -1;
            if (b.is_ai_recommended) return 1;
            // Rest remain in original order
            return 0;
          });

          // Add all packaging options (sorted)
          sortedData.forEach(item => {
            const optionText = item.text + (item.dimensions?.length ? ` [${item.dimensions.length}x${item.dimensions.width}x${item.dimensions.height}cm]` : '');
            const $option = $('<option></option>')
              .val(item.id)
              .text(optionText)
              .data('packaging', item);

            $("#packingPackage").append($option);
          });

          // Initialize select2
          $("#packingPackage").select2({
            placeholder: "Select packaging for product",
            allowClear: true,
            templateResult: function (item) {
              if (!item.id) return item.text;

              const data = item.element ? $(item.element).data('packaging') : null;
              if (!data) return item.text;

              let badge = '';
              if (data.is_ai_recommended) {
                const badgeColor = data.ai_score >= 100 ? 'success' : 'info';
                badge = `<span class="badge badge-${badgeColor}" style="margin-left: 8px;">⭐ AI (${data.ai_score})</span>`;
              }

              return $(`<span>${item.text}${badge}</span>`);
            },
            templateSelection: function (item) {
              if (!item.id) return item.text;
              const data = item.element ? $(item.element).data('packaging') : null;
              let badge = data?.is_ai_recommended ? ' ⭐ AI' : '';
              return item.text + badge;
            }
          });

          console.log("Select2 initialized successfully");
        }

        async function loadAndMergeAIRecommendations() {
          const quantity = $("#packing_quantity").val();

          if (!quantity || quantity <= 0) {
            console.log("Quantity not valid for AI recommendations");
            return;
          }

          console.log(`Loading AI recommendations for quantity: ${quantity}kg`);

          try {
            const response = await $.ajax({
              url: "/api/packing/ai-containers",
              method: "POST",
              dataType: "json",
              contentType: "application/json",
              data: JSON.stringify({
                product_id: "1",
                quantity_kg: parseFloat(quantity),
                market: "EXPORT",
                grade: "PREMIUM",
                size: "MEDIUM"
              })
            });

            console.log("AI Response:", response);

            if (response.statusCode === 200 && response.data.top_recommendations) {
              console.log("Found AI recommendations, updating dropdown");

              // Mark AI-recommended packages in the global data
              response.data.top_recommendations.forEach(rec => {
                const pkgIndex = globalPackagingData.findIndex(p => p.id === rec.packaging_id);
                if (pkgIndex >= 0) {
                  globalPackagingData[pkgIndex].is_ai_recommended = true;
                  globalPackagingData[pkgIndex].ai_score = rec.ai_score;
                  globalPackagingData[pkgIndex].efficiency = rec.efficiency_rating;
                  console.log(`Marked package ${rec.packaging_code} as AI recommended with score ${rec.ai_score}`);
                }
              });

              // Re-initialize select2 with updated data
              initializePackagingSelect2(globalPackagingData);

              // Auto-select the best option
              if (response.data.best_option) {
                console.log(`Auto-selecting best option: ${response.data.best_option.packaging_id}`);
                setTimeout(() => {
                  $("#packingPackage").val(response.data.best_option.packaging_id).trigger("change");
                }, 100);
              }
            } else {
              console.log("No recommendations received");
            }
          } catch (error) {
            console.error("Error loading AI recommendations:", error);
          }
        }


        function savePacking() {
          const packing_id = $("#submitPacking").attr(
            "packing_id"
          );
          const current_packing_weight_balance = $("#balance_peeled_dispatch_quantity").text();

          if (parseFloat(current_packing_weight_balance) <= -1) {
            toastr["warning"]("Invalid packing quantity");
            return;
          }

          // Detect if this is an unprocessed product (from dispatch) or processed (from peeled_dispatch)
          const selectedProduct = $("#packingProductNames").select2("data")[0];
          const isUnprocessedSource = selectedProduct?.source === 'dispatch';

          let url = "/api/packing";
          let method = "POST"
          let input_params = {
            packing_quantity: $("#packing_quantity").val(),
            unit_master_id: $("#packingDistributionLocation").val(),
            packaging_master_id: $("#packingPackage").val(),
            expiry_date: $("#expiry_date").val(),
            packing_notes: $("#packing_notes").val(),
          };

          // Add the appropriate dispatch ID based on product source
          if (isUnprocessedSource) {
            // For unprocessed products from dispatch table
            input_params.dispatch_id = $("#packingProductNames").val();
            console.log("✅ Packing UNPROCESSED product - using dispatch_id:", input_params.dispatch_id);
          } else {
            // For processed products from peeled_dispatch table
            input_params.peeled_dispatch_id = $("#packingProductNames").val();
            console.log("✅ Packing PEELED product - using peeled_dispatch_id:", input_params.peeled_dispatch_id);
          }

          if (packing_id && packing_id != "null") {
            url = "/api/packing";
            method = "PUT"

            input_params = {
              packing_id,
              packing_data: {
                ...input_params,
              },
            };
          }

          $.ajax({
            url,
            method,
            dataType: "json",
            contentType: "application/json",
            data: JSON.stringify(input_params),
            crossDomain: true,
            processData: false,
            success: (data) => {
              toastr["success"](data?.message);

              $("#closePackingPanelBtn").click();

              loadPercentages();

              loadPackingTableData();

              resetAllInputs();
            },
            error: (jqXhr, textStatus, errorThrown) => {
              if (jqXhr["status"] == 420) {
                toastr["warning"](jqXhr["responseJSON"]["message"]);
              } else {
                toastr["error"](
                  jqXhr["responseJSON"]?.message || jqXhr["responseJSON"]
                );
              }
            },
          });
        }

        $("#resetPackingDataBtn").on("click", resetAllInputs);
        <!--End of Packing Container-->
