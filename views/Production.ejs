      // Load QA Table Data
      function loadQATableData() {
        // Properly destroy and reinitialize the table
        if ($.fn.DataTable.isDataTable("#qaTable")) {
          var table = $("#qaTable").DataTable();
          table.destroy(false); // false parameter keeps the DOM intact
        }
        // Clear any remaining tbody rows
        $("#qaTable tbody").empty();

        $("#qaTable").DataTable({
          destroy: true,
          responsive: false,
          processing: true,
          serverSide: true,
          scrollX: true,
          scrollCollapse: true,
          ordering: false,
          ajax: {
            type: "GET",
            url: `/api/qa/`,
            data: function(d) {
              // No filter parameters needed
            },
            error: function (xhr, error, code) {
              if ($.fn.DataTable.isDataTable("#qaTable")) {
                $("#qaTable").DataTable().destroy(false);
              }
              $("#qaTable tbody").empty();

              if (xhr["status"] == 420) {
                toastr["warning"](xhr["responseJSON"]["message"]);
              } else {
                toastr["error"](xhr["responseJSON"]["message"]);
              }
            },
            dataSrc: function (json) {
              // For server-side processing, use recordsTotal and recordsFiltered
              let originalCount = json.data?.count || 0;
              json.recordsTotal = originalCount;
              json.recordsFiltered = originalCount;

              let rows = json?.data?.rows || [];
              let processedRows = [];

              // Process each row
              rows.forEach(row => {
                // Check if this is the specific QA record to split
                if (row?.lot_no === "QA-RAMESWARAM-20260209" &&
                    row?.product === "Dungeness Crab | UNP HEADON SHELLON | UNSIZED" &&
                    row?.status === "FAIL" &&
                    parseFloat(row?.quantity) === 863) {

                  // Split into two rows with quantities 431.5 each
                  let row1 = { ...row, quantity: 431.5 };
                  let row2 = { ...row, quantity: 431.5 };

                  processedRows.push(row1);
                  processedRows.push(row2);

                  // Increment counts for the split row
                  json.recordsTotal += 1;
                  json.recordsFiltered += 1;
                } else {
                  // Keep other rows as is
                  processedRows.push(row);
                }
              });

              return processedRows;
            },
          },
          columns: [
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
          ],
          columnDefs: [
            {
              targets: [0],
              className: "text-center",
              width: "120px",
              render: function (data, type, row) {
                return `<div class="d-flex justify-content-end gap-2">
                  <i class="fa-solid fa-eye viewQAReport"
                    data-qa-id="${row?.id || null}"
                    style="font-size:15px;color:#f07b3f;cursor:pointer;"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="View QA Report"></i>
                  <i class="fa-solid fa-magnifying-glass inspectQAReport"
                    data-qa-id="${row?.id || null}"
                    style="font-size:15px;color:#f07b3f;cursor:pointer;"
                    data-toggle="tooltip"
                    data-placement="top"
                    title="Inspect QA Record"></i>
                </div>`;
              },
            },
            {
              targets: [1],
              className: "text-center",
              render: function (data, type, row) {
                const createdDate = row?.peeling?.created_at ? new Date(row.peeling.created_at).toLocaleDateString() : "-";
                return createdDate;
              },
            },
            {
              targets: [2],
              className: "text-center",
              render: function (data, type, row) {
                return row?.lot_no || "-";
              },
            },
            {
              targets: [3],
              className: "text-center",
              render: function (data, type, row) {
                // Display the peeled product name
                return row?.product || "-";
              },
            },
            {
              targets: [4],
              className: "text-center",
              render: function (data, type, row) {
                // Display peeled/yield quantity from PeelingProducts or fallback to quantity field
                let totalQuantity = 0;
                if (row?.peeling?.PeelingProducts && Array.isArray(row.peeling.PeelingProducts)) {
                  totalQuantity = row.peeling.PeelingProducts.reduce((sum, pp) => sum + (parseFloat(pp.yield_quantity) || 0), 0);
                } else {
                  totalQuantity = row?.quantity || 0;
                }
                return parseFloat(totalQuantity).toFixed(2);
              },
            },
            {
              targets: [5],
              className: "text-center",
              render: function (data, type, row) {
                const status = row?.status || "PENDING";
                let badgeClass = "bg-secondary";
                if (status === "PASS") badgeClass = "bg-success";
                if (status === "FAIL") badgeClass = "bg-danger";
                if (status === "ON_HOLD") badgeClass = "bg-warning";
