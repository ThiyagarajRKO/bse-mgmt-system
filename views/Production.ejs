        function populatePeelingOutputs(peeling_products_obj) {
          if (!Array.isArray(peeling_products_obj)) return;
          let i = 1;
          peeling_products_obj.forEach((product) => {
            if (i == 1) {
              // first output already exists in the DOM
              $(`.peelingProductNames_${i}`)
                .val(product?.ProductMaster?.id)
                .trigger("change");
              $(`.peelingProductNames_${i}`)
                .parent()
