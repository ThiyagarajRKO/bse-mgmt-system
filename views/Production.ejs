        // Load Packing Table Data for Final QA
        async function loadPostPackQATableData() {
          try {
            console.log("📦 Loading Final QA packing data...");
            const response = await fetch("/api/packing/stats");
            const result = await response.json();

            if (!result.success) {
              toastr["error"]("Failed to load packing data");
              return;
            }

            const data = result.data || [];
            console.log("📊 Packing stats received:", data);

