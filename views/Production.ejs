        }
        $("#dispatchProductTable").DataTable({
          // searching: true,
          destroy: true,
          responsive: false,
          processing: true,
          serverSide: true,
          scrollX: true,
          scrollCollapse: true,
          scrollY: "40vh",
          ordering: false,
          ajax: {
            type: "GET",
            url: `/api/dispatch?procurement_lot_id=${lot_no}`,
            error: function (xhr, error, code) {
              $("#dispatchProductTable").DataTable().destroy();
              $("#dispatchProductTable").DataTable({
                scrollX: true,
                ordering: false,
              });

              if (xhr["status"] == 420) {
                toastr["warning"](xhr["responseJSON"]["message"]);
              } else {
                toastr["error"](xhr["responseJSON"]["message"]);
              }
            },
            dataSrc: function (json) {
              // Handle both array and object responses
              const data = Array.isArray(json.data) ? json.data : (json.data?.rows || []);
              const count = Array.isArray(json.data) ? json.data.length : (json.data?.count || 0);

              json.iTotalRecords = count;
              json.iTotalDisplayRecords = count;

              // Return the data to be displayed in the DataTable
              return data;
            },
          },
          columns: [
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
            { data: null },
          ],
          columnDefs: [
            {
              targets: [0],
              className: "text-left",
              render: function (data, type, row) {
                return `<i class="fa fa-pen-to-square edit editDispatch" dispatch_id=${row?.id || null
                  } procurement_id=${row?.id
                  } aria-hidden="true" style="font-size:15px;color:#f07b3f" data-toggle="tooltip" data-placement="top" title="Click this button to edit this product"></i>`;
              },
            },
            {
              targets: [1],
              className: "text-left",
              width: "200px",
              render: function (data, type, row) {
                return `<span procurement_product_id='${row["pp"]?.id
                  }' style="word-wrap: break-word; white-space: normal; display: block;">${row["pp"]?.["ProductMaster"]?.product_name
                  }-${row["pp"]?.procurement_product_type}-${row[
                    "pp"
                  ]?.["SupplierMaster"]?.supplier_name?.replaceAll(" ", "")}</span>`;
              },
            },
            {
              targets: [2],
              className: "text-left",
              render: function (data, type, row) {
                // Show adjusted quantity if available, otherwise procurement quantity
                const quantity = row["pp"]?.adjusted_quantity || row["pp"]?.procurement_quantity || 0;
                return parseFloat(quantity).toFixed(2);
              },
            },
            {
              targets: [3],
              className: "text-left",
              render: function (data, type, row) {
                return row?.dispatch_quantity || 0;
              },
            },
            {
              targets: [4],
              className: "text-left",
              render: function (data, type, row) {
                const qaStatus = row?.qa_status || 'Pending';
                const statusClass = qaStatus === 'Passed' ? 'text-success' :
                                   qaStatus === 'Failed' ? 'text-danger' :
                                   qaStatus === 'Conditional' ? 'text-warning' : 'text-secondary';
                return `<span class="qa-status-link ${statusClass}" style="cursor: pointer; text-decoration: underline;" peeled_dispatch_id="${row?.id}">${qaStatus}</span>`;
              },
            },
            {
              targets: [5],
              className: "text-left",
              render: function (data, type, row) {
                if (row?.temperature !== null && row?.temperature !== undefined && row.temperature !== "") {
                  return parseFloat(row.temperature).toFixed(2);
                }
                return "-";
              },
            },
            {
              targets: [6],
              className: "text-left",
              render: function (data, type, row) {
                return `<span unit_master_id='${row["UnitMaster"]?.id}'>${row["UnitMaster"]?.unit_code || "-"}</i>`;
              },
            },
            {
              targets: [7],
              className: "text-left",
              render: function (data, type, row) {
                return `<span vehicle_master_id='${row["VehicleMaster"]?.id}'>${row["VehicleMaster"]?.vehicle_number || "-"}</i>`;
              },
            },
            {
              targets: [8],
              className: "text-left",
              render: function (data, type, row) {
                return `<a href="tel:${row["DriverMaster"]?.phone?.startsWith("91")
                  ? `+${row["DriverMaster"]?.phone}`
                  : row["DriverMaster"]?.phone?.startsWith("+91")
                    ? row["DriverMaster"]?.phone
                    : `+91${row["DriverMaster"]?.phone}`
                  }" driver_master_id='${row["DriverMaster"]?.id}'>${row["DriverMaster"]?.driver_name || "-"}</i>`;
              },
            },
            {
              targets: [9],
              className: "text-left",
              render: function (data, type, row) {
                return row?.delivery_notes || "-";
              },
            },
            {
              targets: [10],
              className: "text-left",
              render: (data, type, row) => {
                const status = row?.delivery_status || "Pending";
                return `<span class=${status == "In Transit" ? "text-warning" : "text-success"
                  }>${status} <i class="fa-solid ${status == "In Transit"
                    ? "fa-truck-fast fa-fade"
                    : "fa-circle-check"
                  }"></i></span>`;
              },
            },
            {
              targets: [1],
              className: "text-left",
              render: function (data, type, row) {
                const date = new Date(row?.created_at);

                var months = [
                  "Jan",
                  "Feb",
                  "Mar",
                  "Apr",
                  "May",
                  "Jun",
                  "Jul",
                  "Aug",
                  "Sep",
                  "Oct",
                  "Nov",
                  "Dec",
                ];
                var hours = date.getHours();
                var minutes = date.getMinutes();
                var ampm = hours >= 12 ? "PM" : "AM";
                hours = hours % 12;
                hours = hours ? hours : 12; // Handle midnight (0 hours)
                minutes = minutes < 10 ? "0" + minutes : minutes;
                var strTime = hours + ":" + minutes + " " + ampm;
                var month = months[date.getMonth()];
                var day = date.getDate().toString().padStart(2, "0"); // Ensure day is always two digits
                return (
                  day + "-" + month + "-" + date.getFullYear() + " " + strTime
                );
              },
            },
          ],
          drawCallback: () => { },
        });
      }

