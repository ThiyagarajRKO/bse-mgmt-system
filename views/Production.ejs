        // Load QA data for dropdown population
        async function loadQADropdownData() {
          try {
            // Fetch peeling data to get only products with peeled records.  If
            // the page was loaded with an `order_id` query parameter we
            // forward that along so the API can restrict results to a single
            // order and the dropdowns on the QA panel don’t get overwhelmed.
            let apiUrl = '/api/peeling/';
            if (current_order_id) {
              apiUrl += `?order_id=${encodeURIComponent(current_order_id)}`;
            }
            const peelingResponse = await fetch(apiUrl);
            const peelingResult = await peelingResponse.json();

            console.log("[QA] Peeling API Response:", peelingResult);

            // Extract peeling records
            let peelingRecords = [];
            if (peelingResult.data && peelingResult.data.rows) {
              peelingRecords = peelingResult.data.rows;
            } else if (Array.isArray(peelingResult.data)) {
              peelingRecords = peelingResult.data;
            }

            if (!peelingRecords || peelingRecords.length === 0) {
              console.log("[QA] No peeling records found");
              return;
            }

            console.log("[QA] Found " + peelingRecords.length + " peeling records");

            // Extract unique orders, lots, and products from peeling data
            // orderIdMap: order UUID -> order number (string)
            const orderIdMap = new Map();
            // also keep a simple set of order IDs for quick size checks
            const orders = new Set();
            const lots = new Set();
            const products = new Set();
            const orderLotMap = new Map(); // Map order to its lots
            const lotProductMap = new Map(); // Map lot to its products
            const lotIdMap = new Map(); // Map lot number to lot ID for API calls

            peelingRecords.forEach(peeling => {
              // Get order and lot from dispatch/procurement relationship using aliases
              // The peeling API uses aliases: dis (Dispatch), pp (ProcurementProduct), pl (ProcurementLot)
              const dispatch = peeling?.dis;
              const procurementProduct = dispatch?.pp;
              const procurementLot = procurementProduct?.pl;

              // procurementLot.order_id will be the FK; we prefer the human friendly
              // order number if the include pulled it back.
              const orderNo =
                procurementLot?.order?.order_no ||
                procurementLot?.order_id ||
                dispatch?.order?.order_no ||
                "";
              const lotNo = procurementLot?.procurement_lot || "";
              const lotId = procurementLot?.id || "";
              // orderId must be the UUID (not the human-readable number) so we
              // can populate the dropdown value correctly.  procurementLot may
              // include a joined order record when the API returns it, otherwise
              // fall back to the raw FK.
              const orderId =
                procurementLot?.order?.id ||
                procurementLot?.order_id ||
                dispatch?.order_id ||
                "";

              // Get products from PeelingProducts array
              if (Array.isArray(peeling.PeelingProducts)) {
                peeling.PeelingProducts.forEach(peeledProduct => {
                  const productName = peeledProduct?.ProductMaster?.product_name || "";

                  // Add order (store id->number mapping). only include when we
                  // were able to derive an identifier. previously the variable
                  // was undefined so the dropdown remained empty.
                  if (orderId) {
                        orderIdMap.set(orderId, orderNo);
                        orders.add(orderId);
                    if (!orderLotMap.has(orderId)) {
                      orderLotMap.set(orderId, new Set());
                    }
                    if (lotNo) {
                      orderLotMap.get(orderId).add(lotNo);
                    }
                  }

                  // Add lot and store lot ID
                  if (lotNo) {
                    lots.add(lotNo);
                    if (lotId) {
                      lotIdMap.set(lotNo, lotId);
                    }
                    if (!lotProductMap.has(lotNo)) {
                      lotProductMap.set(lotNo, new Set());
                    }
                    if (productName) {
                      lotProductMap.get(lotNo).add(productName);
                    }
                  }

                  // Add product (only if it has peeling data)
                  if (productName) {
                    products.add(productName);
                  }
                });
              }
            });

            // Store maps globally for cross-filtering
            window.qaOrderLotMap = orderLotMap;
            window.qaLotProductMap = lotProductMap;
            window.qaLotIdMap = lotIdMap;
            window.qaOrderIdMap = orderIdMap;

            // Populate Order dropdown
            const orderSelect = $("#qa_order_id");
            orderSelect.html('<option value="">Select Order Number</option>');
            Array.from(orderIdMap.entries())
              .sort((a, b) => a[1].localeCompare(b[1]))
              .forEach(([id, no]) => {
                orderSelect.append(`<option value="${id}">${no}</option>`);
              });

            // Populate Lot dropdown
            const lotSelect = $("#qa_lot_no");
            lotSelect.html('<option value="">Select Lot Number</option>');
            Array.from(lots).sort().forEach(lot => {
              lotSelect.append(`<option value="${lot}">${lot}</option>`);
            });

            // Populate Product dropdown with ONLY peeled products
            const productSelect = $("#qa_product");
            productSelect.html('<option value="">Select Product</option>');
            Array.from(products).sort().forEach(product => {
              productSelect.append(`<option value="${product}">${product}</option>`);
            });

            // debug/logging so we can see what actually populated
            console.log("[QA] built sets - orders:", Array.from(orderIdMap.entries()));
            console.log("[QA] built sets - lots:", Array.from(lots));
            console.log("[QA] built sets - products:", Array.from(products));

            if (orderIdMap.size === 0 && peelingRecords.length > 0) {
              toastr["warning"]("QA orders dropdown empty - check that procurement lots include order info");
            }
            if (lots.size === 0 && peelingRecords.length > 0) {
              toastr["warning"]("QA lots dropdown empty - no lot numbers found in peeling records");
            }
            if (products.size === 0 && peelingRecords.length > 0) {
              toastr["warning"]("QA product dropdown empty - no peeled products detected");
            }

            // Initialize Select2 for QA dropdowns
            $(".qa-dropdown").select2({
              placeholder: "Choose an option",
              allowClear: true,
              width: "100%",
              dropdownParent: $("#qaSlideInPanel")
            });

            console.log("[QA] Dropdown data loaded and Select2 initialized successfully");
          } catch (error) {
            console.error("[QA] Error loading dropdown data:", error);
          }
        }

