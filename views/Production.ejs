                $("#dispatchProductTable").DataTable().destroy();
                $("#dispatchProductTable").DataTable({
                  scrollX: true,
                  ordering: false,
                });

                if (xhr["status"] == 420) {
                  toastr["warning"](xhr["responseJSON"]["message"]);
                } else {
                  toastr["error"](xhr["responseJSON"]["message"]);
                }
              },
              dataSrc: function (json) {
                // Handle both array and object responses
                // Dispatch API returns { count, rows } at top level
                const data = Array.isArray(json.data) ? json.data : (json.data?.rows || json.rows || []);
                const count = Array.isArray(json.data) ? json.data.length : (json.data?.count || json.count || 0);

                json.iTotalRecords = count;
                json.iTotalDisplayRecords = count;

                console.log('[DEBUG] Dispatch dataSrc - data length:', data.length, 'data:', data);

                // Check if all products are unprocessed
                // If all items have procurement_product_type === 'UNPROCESSED', skip peeling/QA
                if (data && data.length > 0) {
                  const allUnprocessed = data.every(item => {
                    const type = item?.pp?.procurement_product_type;
                    console.log('[DEBUG] Item:', item?.id, 'pp:', item?.pp?.id, 'type:', type);
                    return type === 'UNPROCESSED';
                  });
                  console.log('[DEBUG] allUnprocessed:', allUnprocessed);
                  isUnprocessedProductsOnly = allUnprocessed;
                  updateMenuVisibilityForProductType();

                  if (allUnprocessed) {
                    console.log('✓ All products in this lot are UNPROCESSED - Workflow: Dispatch → Packing');
                  } else {
                    console.log('✗ Mixed or processed products detected - Standard workflow with Peeling/QA');
                  }
                } else {
                  console.log('[DEBUG] No dispatch data found');
                }

                // Return the data to be displayed in the DataTable
                return data;
              },
            },
