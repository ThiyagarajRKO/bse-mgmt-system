              if (view_packing_product_id) {
                console.log("🎯 Setting view packing product ID:", view_packing_product_id);
                $("#packingProductNames")
                  .val(view_packing_product_id)
                  .trigger("change");
              } else {
                // Auto-select the first product if only one exists
                if (packingProductNamesArray.length === 1) {
                  const firstProduct = packingProductNamesArray[0];
                  console.log("🎯 Auto-selecting first (and only) product:", firstProduct);
                  $("#packingProductNames")
                    .val(firstProduct.id)
                    .trigger("change");
                } else {
                  console.log("ℹ️ No product auto-selection (multiple or no products)");
                  $("#packingProductNames").val(null).trigger("change");
