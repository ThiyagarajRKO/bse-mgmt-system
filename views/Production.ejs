              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("❌ Error loading packing products:", jqXhr);
              if (jqXhr["status"] == 420) {
                toastr["warning"](jqXhr["responseJSON"]["message"]);
              } else {
                toastr["error"](jqXhr["responseJSON"]["message"] || "Failed to load products");
              }
            },
          });
