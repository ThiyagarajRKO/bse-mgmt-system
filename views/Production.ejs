      // Function to calculate and update QA status in real-time
      function updateQAStatus() {
        const brokenPercent = $("#qa_broken_percentage").val();
        const temperature = $("#qa_temperature").val();
        const foreignMatter = $("input[name='qa_foreign_matter']:checked").val();
        const odourStatus = $("input[name='qa_odour_status']:checked").val();
        const appearanceStatus = $("input[name='qa_appearance_status']:checked").val();

        // Determine QA Status based on criteria (matching submit function logic)
        let qaStatus = "PASS";
        const failureReasons = [];

        // Check broken percentage
        if (brokenPercent && !isNaN(parseFloat(brokenPercent)) && parseFloat(brokenPercent) > 20) {
          qaStatus = "FAIL";
          failureReasons.push("Broken % exceeds Grade C limit");
        }

        // Check temperature
        if (temperature && !isNaN(parseFloat(temperature)) && parseFloat(temperature) > -15) {
          qaStatus = "FAIL";
          failureReasons.push("Temperature above acceptable range");
        }

        // Check foreign matter
        if (foreignMatter === "true") {
          qaStatus = "FAIL";
          failureReasons.push("Foreign matter detected");
        }

        // Check odour and appearance
        if (odourStatus === "UNACCEPTABLE" || appearanceStatus === "POOR") {
          qaStatus = "FAIL";
          if (odourStatus === "UNACCEPTABLE") failureReasons.push("Odour unacceptable");
          if (appearanceStatus === "POOR") failureReasons.push("Appearance poor");
        }

        // Update status display
        const statusText = $("#qa_status_text");
        const statusDisplay = $("#qa_status_display");
        const failureReasonsDiv = $("#qa_failure_reasons");
        const failureList = $("#qa_failure_list");

        statusText.text(qaStatus);

        // Update styling based on status
        statusDisplay.removeClass("alert-success alert-danger alert-warning alert-secondary");
        if (qaStatus === "PASS") {
          statusDisplay.addClass("alert-success");
        } else if (qaStatus === "FAIL") {
          statusDisplay.addClass("alert-danger");
        } else {
          statusDisplay.addClass("alert-secondary");
        }

        // Show/hide failure reasons
        if (failureReasons.length > 0) {
          failureList.empty();
          failureReasons.forEach(reason => {
            failureList.append(`<li>${reason}</li>`);
          });
          failureReasonsDiv.show();
        } else {
          failureReasonsDiv.hide();
        }
      }

      // Add event listeners for real-time status updates
      $("#qa_broken_percentage").on("input change keyup paste", function() {
        updateQAStatus();
      });

      $("#qa_temperature").on("input change keyup paste", function() {
        updateQAStatus();
      });

      $(document).on("change", "input[name='qa_foreign_matter'], input[name='qa_odour_status'], input[name='qa_appearance_status']", function() {
        updateQAStatus();
      });

      // Also trigger on form panel open to show initial status
      $("#openQAPanelBtn").on("click", function() {
        setTimeout(updateQAStatus, 100); // Small delay to ensure form is populated
      });

      // Submit QA Report
      $("#submitQA").on("click", async function () {
        // Validation
        const brokenPercent = $("#qa_broken_percentage").val();
        const temperature = $("#qa_temperature").val();
        const netWeight = $("#qa_net_weight").val();
        const sampleSize = $("#qa_sample_size").val();
        const foreignMatter = $("input[name='qa_foreign_matter']:checked").val();
        const odourStatus = $("input[name='qa_odour_status']:checked").val();
        const appearanceStatus = $("input[name='qa_appearance_status']:checked").val();

        // Check required fields - broken_percentage, temperature, net_weight, sample_size, and foreign_matter
        if (!brokenPercent || !temperature || !netWeight || !sampleSize || foreignMatter === undefined) {
          toastr["warning"]("Please fill in all required fields marked with *");
          return;
        }

        // Prepare QA data
        const qaData = {
          order_id: $("#qa_order_uuid").val() || $("#qa_order_id").val(),
          lot_no: $("#qa_lot_no").val(),
          product: $("#qa_product").val(),
          quantity: $("#qa_quantity").val(),
          broken_percentage: parseFloat(brokenPercent),
          glazing_percentage: $("#qa_glazing_percentage").val() || null,
          temperature: parseFloat(temperature),
          odour_status: odourStatus || "GOOD",
          appearance_status: appearanceStatus || "GOOD",
          foreign_matter: foreignMatter === "true" ? true : false,
          foreign_matter_notes: $("#qa_foreign_matter_notes").val(),
          net_weight_avg: parseFloat(netWeight),
          sample_size: parseInt(sampleSize),
          notes: $("#qa_notes").val(),
        };

        // Calculate status
        let qaStatus = "PASS";
        const failureReasons = [];

        // Check broken percentage
        if (parseFloat(brokenPercent) > 20) {
          qaStatus = "FAIL";
          failureReasons.push("Broken % exceeds Grade C limit");
        }

        // Check temperature
        if (parseFloat(temperature) > -15) {
          qaStatus = "FAIL";
          failureReasons.push("Temperature above acceptable range");
        }

        // Check foreign matter
        if (foreignMatter === "true") {
          qaStatus = "FAIL";
          failureReasons.push("Foreign matter detected");
        }

        // Check odour and appearance
        if (odourStatus === "UNACCEPTABLE" || appearanceStatus === "POOR") {
          qaStatus = "FAIL";
          if (odourStatus === "UNACCEPTABLE") failureReasons.push("Odour unacceptable");
          if (appearanceStatus === "POOR") failureReasons.push("Appearance poor");
        }

        // Let backend recalculate status based on criteria - DO NOT send status from frontend
        const qa_id = $(this).attr("qa_id");
        // IMPORTANT: Do NOT include status in qaData - let backend recalculate it

        // Submit via API
        try {
          const method = qa_id ? "PUT" : "POST";
          const url = qa_id ? `/api/qa/${qa_id}` : `/api/qa/`;

          let requestData = qaData;
          if (qa_id) {
            // For updates, wrap data in qa_data object
            requestData = {
              qa_id: qa_id,
              qa_data: qaData
            };
          }

          const response = await $.ajax({
            url: url,
            method: method,
            dataType: "json",
            contentType: "application/json",
            data: JSON.stringify(requestData)
          });

          // Response is successful if we reach here (AJAX error is caught in catch block)
          toastr["success"](response.message || "QA Report saved successfully!");
          $("#qaSlideInPanel").css("right", "-500px");
          resetQAForm();

          // Reset the edit button state
          $("#submitQA").attr("qa_id", null);
          $("#submitQA").text("Save QA Report");

          // Force table reload to show updated status
          if ($.fn.DataTable.isDataTable("#qaTable")) {
            var table = $("#qaTable").DataTable();
            table.destroy();
            // Clear the table body completely
            $("#qaTable tbody").empty();
          }
          // Small delay to ensure DOM is ready before reloading
          setTimeout(function() {
            loadQATableData();
          }, 100);
        } catch (error) {
          console.error("Error saving QA report:", error);
          toastr["error"](error.responseJSON?.message || "Error saving QA report");
        }
      });

      // View/Edit QA Report
      $(document).on("click", ".performQABtn", async function () {
