        // Load unprocessed (raw) dispatches for packing when peeled dispatches are not available
        function loadUnprocessedDispatchesForPacking(packing_lot_no) {
          console.log("🔄 Trying to load unprocessed dispatches for packing - lot:", packing_lot_no);

          $.ajax({
            url: `/api/dispatch/names?procurement_lot_id=${packing_lot_no}`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (data) => {
              console.log("✅ Dispatch products API response:", data);
              packingProductNamesArray = [];

              // Check if all dispatches are unprocessed
              const hasUnprocessed = data?.data?.some(item =>
                item?.pp?.procurement_product_type === 'UNPROCESSED'
              );

              if (!hasUnprocessed) {
                console.warn("⚠️ No unprocessed dispatches available for this lot");
                toastr["info"]("No products available for packing in this lot");
                $("#packingProductNames").select2({
                  placeholder: "No products available",
                  allowClear: true,
                  data: [],
                  disabled: true,
                });
                return;
              }

              data?.data?.forEach((item) => {
                // Only include unprocessed products
                if (item?.pp?.procurement_product_type === 'UNPROCESSED') {
                  packingProductNamesArray.push({
                    id: item.id,
                    product_master_id: item?.pp?.ProductMaster?.id,
                    quantity: (item?.dispatch_quantity || 0) - (item?.packed_quantity || 0),
                    text: item?.pp?.ProductMaster?.product_name + "-" + ((item?.dispatch_quantity || 0) - (item?.packed_quantity || 0)),
                    qa_status: "PASS",
                    source: "dispatch",  // Mark as raw dispatch, not peeled
                    dispatch_id: item.id,
                    procurement_product_id: item?.procurement_product_id
                  });
                }
              });

              console.log("📦 Mapped unprocessed dispatch products for packing:", packingProductNamesArray);

              if (packingProductNamesArray.length === 0) {
                console.warn("⚠️ No unprocessed products available for packing");
                toastr["info"]("No unprocessed products available for packing in this lot");
                $("#packingProductNames").select2({
                  placeholder: "No products available",
                  allowClear: true,
                  data: [],
                  disabled: true,
                });
              } else {
                console.log("✅ Initializing packingProductNames select2 with", packingProductNamesArray.length, "unprocessed products");
                toastr.info('Unprocessed products detected - Skipping QA. Proceeding directly to Packing');
                $("#packingProductNames").select2({
                  placeholder: "Choose a product",
                  allowClear: true,
                  data: packingProductNamesArray,
                  disabled: false,
                });

                // Auto-select the first product if only one exists
                if (packingProductNamesArray.length === 1) {
                  const firstProduct = packingProductNamesArray[0];
                  console.log("🎯 Auto-selecting first unprocessed product:", firstProduct);
                  $("#packingProductNames")
                    .val(firstProduct.id)
                    .trigger("change");
                }
              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("❌ Error loading unprocessed dispatch products:", jqXhr);
              toastr["error"](jqXhr["responseJSON"]?.message || "Failed to load unprocessed products");
              $("#packingProductNames").select2({
                placeholder: "Error loading products",
                allowClear: true,
                data: [],
                disabled: true,
              });
            },
          });
        }

        let balance_peeled_dispatch_quantity = 0;
        $(document).on("change", "#packingProductNames", () => {
          $("#balance_peeled_dispatch_quantity").text("");

          let lot_no = $("#packingLotNumbers").val();
          const selectedProduct = $("#packingProductNames").select2("data")[0];

          if ($("#packingProductNames").val() && selectedProduct) {
            balance_peeled_dispatch_quantity = selectedProduct?.quantity;

            if (!isNaN(balance_peeled_dispatch_quantity)) {
              $("#balance_peeled_dispatch_quantity").text(
                parseFloat(balance_peeled_dispatch_quantity)
              );

              $("#balance_peeled_dispatch_quantity").css({ color: "white" });
            }

            $("#packingDistributionLocation").empty();

            if (lot_no) {
              loadPackingUnits(lot_no);
            }

            // Load recommended packaging based on selected product
            if (selectedProduct?.product_master_id) {
              // Get product details to determine grade, size, market
              $.ajax({
                url: `/api/master/product/${selectedProduct.product_master_id}`,
                method: "GET",
                dataType: "json",
                success: (productData) => {
                  if (productData?.data) {
                    // Load packaging suggestions for the selected product
                    // Grade and size will be derived from the product on the backend
                    loadPackingPackage(selectedProduct.product_master_id, "RETAIL");
                  } else {
                    // Fallback to all packaging options
                    loadPackingPackage();
                  }
                },
                error: () => {
                  // Fallback to all packaging options if product details can't be fetched
                  loadPackingPackage();
                }
              });
            } else {
              // Fallback to all packaging options
              loadPackingPackage();
            }

            $("#packing_quantity").keyup();
          } else {
            // No product selected, load all packaging options
            loadPackingPackage();
          }
        });

        $(document).on("keyup", "#packing_quantity", (e) => {
          const currentPackingQuantity = $(e.target).val();
          const peeledDispatchQuantity = parseFloat(
            $("#packingProductNames").select2("data")[0]?.quantity
          );

          if (!currentPackingQuantity) {
            $("#balance_packed_quantity").text(balance_peeled_dispatch_quantity);
            $("#balance_packed_quantity").css({ color: "white" });
            return;
          }

          let balancePeeledDispatchQuantity =
            peeledDispatchQuantity - currentPackingQuantity;

          $("#balance_packed_quantity").text(
            !isNaN(balancePeeledDispatchQuantity)
              ? balancePeeledDispatchQuantity
              : currentPackingQuantity
          );

          if (balancePeeledDispatchQuantity > 0) {
            $("#balance_packed_quantity").css({ color: "yellow" });
          } else {
            $("#balance_packed_quantity").css({ color: "red" });
          }

          // Auto-trigger AI recommendations when quantity is entered
          if (currentPackingQuantity > 0 && globalPackagingData.length > 0) {
            console.log("Quantity entered, loading AI recommendations");
            loadAndMergeAIRecommendations();
          }
        });

        function loadPackingUnits(procurement_lot_id) {
          if (!procurement_lot_id) {
            toastr["warning"]("Lot number must not be empty");
            return
          }

          $.ajax({
            url: "/api/master/unit/peeled/dispatch/destination?procurement_lot_id=" + procurement_lot_id,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (data) => {
              console.debug("loadPackingUnits success - data:", data);
              $("#packingDistributionLocation").select2({
                placeholder: "Choose a Production Center",
                allowClear: true,
                data: $.map(data?.data?.rows || [], function (item) {
                  return {
                    id: item.id,
                    text: item.unit_code || item.unit_name,
                  };
                }),
              });

              if (view_packing_location_id) {
                $("#packingDistributionLocation").val(view_packing_location_id).trigger("change");
              } else {
                $("#packingDistributionLocation").val(null).trigger("change");

              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("loadPackingUnits error:", {jqXhr, textStatus, errorThrown});
              if (jqXhr?.responseJSON?.message) {
                if (jqXhr["status"] == 420) {
                  toastr["warning"](jqXhr["responseJSON"]["message"]);
                } else {
                  toastr["error"](jqXhr["responseJSON"]["message"]);
                }
              } else {
                toastr["error"]("Failed to load packing units: " + textStatus);
