                },
              },
              {
                // QA status link column for peeled dispatch products
                targets: [4],
                className: "text-left",
                render: function (data, type, row) {
                  const qaStatusRaw = row?.qa_status || 'PENDING';
                  const qaStatus =
                    qaStatusRaw === 'PASS'
                      ? 'Passed'
                      : qaStatusRaw === 'FAIL'
                      ? 'Failed'
                      : qaStatusRaw === 'CONDITIONAL'
                      ? 'Conditional'
                      : 'Pending';
                  const statusClass = qaStatusRaw === 'PASS'
                    ? 'text-success'
                    : qaStatusRaw === 'FAIL'
                    ? 'text-danger'
                    : qaStatusRaw === 'CONDITIONAL'
                    ? 'text-warning'
                    : 'text-secondary';

                  // Don't make PENDING clickable - just show as plain text
                  if (qaStatusRaw === 'PENDING') {
                    return `<span class="${statusClass}">${qaStatus}</span>`;
                  }

                  return `<span class="qa-status-link ${statusClass}" style="cursor: pointer; text-decoration: underline;" peeled_dispatch_id="${row?.id}">${qaStatus}</span>`;
                },
              },
              {
                targets: [5],
                className: "text-left",
                render: function (data, type, row) {
                  return `<span unit_master_id='${row["UnitMaster"]?.id}'>${data}</i>`;
