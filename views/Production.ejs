          }
          $("#dispatchProductTable").DataTable({
            // searching: true,
            destroy: true,
            responsive: false,
            processing: true,
            serverSide: true,
            scrollX: true,
            scrollCollapse: true,
            scrollY: "40vh",
            ordering: false,
            ajax: {
              type: "GET",
              url: `/api/dispatch?procurement_lot_id=${lot_no}`,
