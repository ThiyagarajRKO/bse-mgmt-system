      function loadPeelingCenters(procurement_lot_id) {
        if (!procurement_lot_id) {
          toastr["warning"]("Lot number must not be empty");
          return
        }

        $.ajax({
          url:
            "/api/master/unit/dispatch/destination?procurement_lot_id=" +
            procurement_lot_id,
          method: "GET",
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          processData: false,
          success: (data) => {
            console.log("loadPeelingCenters - received data:", data);
            console.log("loadPeelingCenters - data?.data:", data?.data);

            const peelingCenterOptions = $.map(data?.data?.rows || [], function (item) {
              console.log("loadPeelingCenters - mapping item:", item);
              return {
                id: item.id,
                text: item.unit_name || item.unit_code,
              };
            });

            console.log("loadPeelingCenters - options:", peelingCenterOptions);

            $("#peelingCenters").select2({
              placeholder: "Choose a peeling center",
              allowClear: true,
              data: peelingCenterOptions,
            });

            if (view_peeling_center_id) {
              $("#peelingCenters")
                .val(view_peeling_center_id)
                .trigger("change");
            } else {
              $("#peelingCenters").val(null).trigger("change");
            }
          },
          error: (jqXhr, textStatus, errorThrown) => {
            if (jqXhr["status"] == 420) {
              toastr["warning"](jqXhr["responseJSON"]["message"]);
            } else {
              toastr["error"](jqXhr["responseJSON"]["message"]);
            }
          },
        });
