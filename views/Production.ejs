      // Check stock availability for production
      async function checkStockForProduction(order) {
        try {
          // Prepare products array for stock check
          const orderedProducts = order.OrderProducts.map(product => ({
            product_master_id: product.product_master_id,
            quantity_required_kg: product.quantity
          }));

          // Check stock for all products in the order
          const stockResponse = await fetch('/api/orders/check-stock', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ ordered_products: orderedProducts })
          });

          if (!stockResponse.ok) {
            throw new Error('Stock check request failed');
          }

          const stockData = await stockResponse.json();
          console.log('Stock check results:', stockData);

          // Handle stock availability results
          if (stockData.success) {
            toastr.success('All products have sufficient stock for production');
          } else {
            toastr.warning('Some products have insufficient stock. Check procurement requirements.');
          }

        } catch (error) {
          console.error('Error checking stock for production:', error);
          toastr.error('Failed to check stock availability');
        }
      }

    });


    // Helper function to get Bootstrap badge class based on status
    function getStatusBadgeClass(status) {
      const statusClassMap = {
        'DRAFT': 'bg-secondary',
        'CONFIRMED': 'bg-info',
        'ALLOCATED': 'bg-primary',
        'PENDING_PURCHASE': 'bg-warning',
        'IN_PRODUCTION': 'bg-success',
        'PRODUCTION_COMPLETE': 'bg-success',
        'DISPATCHED': 'bg-info',
        'PEELING_IN_PROGRESS': 'bg-warning',
        'READY_FOR_SHIPMENT': 'bg-success',
        'SHIPPED': 'bg-success',
        'DELIVERED': 'bg-success'
      };
      return statusClassMap[status] || 'bg-secondary';
    }
