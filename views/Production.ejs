              $(`.yield_quantity_${i}`).val(product?.yield_quantity);
              $(`.peeling_notes_${i}`).val(product?.peeling_notes);
            } else {
              addOutput(
                i,
                product?.id,
                product?.ProductMaster?.id,
                product?.yield_quantity,
                product?.peeling_notes
              );
            }
            i++;
          });
        }

