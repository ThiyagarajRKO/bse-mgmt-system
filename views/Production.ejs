          const appearance = $("input[name='ppqa_appearance']:checked").val();
          const foreign_matter = $("input[name='ppqa_foreign']:checked").val();
          const temperature = $("#postpackqa_temperature").val();
          const carton_weight = $("input[name='ppqa_carton_weight']:checked").val();
