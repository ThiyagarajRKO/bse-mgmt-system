          if (peeled_dispatch_id && peeled_dispatch_id != "null") {
            //if (peeled_product_id && peeled_product_id != "null") {
            url = "/api/peeled/dispatch";
            method = "PUT"

            input_params = {
              peeled_dispatch_id,
              peeled_dispatch_data: {
                ...input_params,
              },
            };
          }

          $.ajax({
