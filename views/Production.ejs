        function loadProducts(lot_no) {
          console.log("loadProducts function called with lot_no:", lot_no);

          if (!lot_no) {
            toastr["warning"]("Invalid lot number!");
            return;
          }

          console.log("loadProducts - starting AJAX call");
          $.ajax({
            url: `/api/procurement/product/names?procurement_lot_id=${lot_no}&dispatch_id=${view_dispatch_id || null
              }`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (data) => {
              console.log("loadProducts - received data:", data);
              console.log("loadProducts - data?.data:", data?.data);

              // aggregate incoming rows by product_master_id so dropdown shows one entry
              // but keep the procurement_product_id of one of the rows so we can
              // send a valid ID back to the server when creating/updating a dispatch.
              const agg = {};
              (data?.data || []).forEach(item => {
                console.log("loadProducts - mapping item:", item);
                const totalQty = parseFloat(
                  String(item?.procurement_quantity || "").replace(/,/g, "")
                ) || 0;
                const dispatchedQty = parseFloat(
                  String(item?.dispatched_quantity || "").replace(/,/g, "")
                ) || 0;
                const remainingQty = totalQty - dispatchedQty;
                const key = item.product_master_id || item.id;
                if (!agg[key]) {
                  agg[key] = {
                    // use the first procurement product encountered as the option value
                    id: item.id,
                    product_master_id: item.product_master_id,
                    overall_total_quantity: item.overall_total_quantity || totalQty,
                    total_quantity: 0,
                    remaining_quantity: 0,
                    quantity: 0,
                    text: `${item?.product_name || item?.ProductMaster?.product_name}-${item?.procurement_product_type}-${(item?.supplier_name || item?.SupplierMaster?.supplier_name)?.replaceAll(" ", "")}`,
                  };
                }
                // if we are editing an existing dispatch, prefer that row's id
                if (view_procurement_product_id && item.id === view_procurement_product_id) {
                  agg[key].id = item.id;
                }
                agg[key].total_quantity += totalQty;
                agg[key].remaining_quantity += remainingQty;
                agg[key].quantity = agg[key].remaining_quantity;
              });
              const productOptions = Object.values(agg);

              console.log("loadProducts - productOptions:", productOptions);

              // Update Select2 data without destroying
              $("#productNames").select2({
                placeholder: "Choose a product",
                allowClear: true,
                data: productOptions,
              });

              $("#productNames").val(null).trigger("change");

              if (view_procurement_product_id) {
                $("#productNames")
                  .val(view_procurement_product_id)
                  .trigger("change");
              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("loadProducts - error:", jqXhr);
              if (jqXhr["status"] == 420) {
                toastr["warning"](jqXhr["responseJSON"]["message"]);
              } else {
                toastr["error"](jqXhr["responseJSON"]["message"]);
              }
            },
          });
        }

        let balance_procure_quantity = 0;
        $(document).on("change", "#productNames", () => {
          $("#balance_procure_quantity").text("");
          $("#total_procure_quantity_display").text("");

          if ($("#productNames").val()) {
            const selected = $("#productNames").select2("data")[0] || {};
            console.log("productNames change selected:", selected);
            // ensure numeric by parsing and stripping any commas
            balance_procure_quantity = parseFloat(
              String(selected.remaining_quantity || "").replace(/,/g, "")
            ) || 0;
            // compute total across all procurements of this product (same master id)
            // the API now returns an overall_total_quantity field containing
            // the sum of procurement_quantity for this product across all lots
            total_procure_quantity = parseFloat(
              String(selected.overall_total_quantity || "").replace(/,/g, "")
            ) || 0;

            if (!isNaN(balance_procure_quantity)) {
              $("#balance_procure_quantity").text(balance_procure_quantity.toLocaleString()).css({ color: "white" });
            }
            if (!isNaN(total_procure_quantity)) {
              $("#total_procure_quantity_display").text(total_procure_quantity.toLocaleString());
            }

            // fire keyup to recalc new balance if dispatch quantity already filled (edit mode)
            $("#dispatch_quantity").keyup();
          }
        });

        $(document).on("keyup", "#dispatch_quantity", (e) => {
          // user may type commas; strip them
          const currentDispatchedQuantity = parseFloat(
            String($(e.target).val() || "").replace(/,/g, "")
          );
          // use the total quantity (overall purchases) for calculations per new requirement
          const procurementQuantity = parseFloat(
            $("#productNames").select2("data")[0]?.overall_total_quantity
          );
          const totalQuantity = parseFloat(
            $("#productNames").select2("data")[0]?.overall_total_quantity
          );

          if (!currentDispatchedQuantity) {
            // no dispatch entered yet; show total purchased quantity instead
              $("#balance_procure_quantity").text(
                isNaN(totalQuantity) ? totalQuantity : totalQuantity.toLocaleString()
              );
            if (!isNaN(totalQuantity)) {
              $("#total_procure_quantity_display").text(
                totalQuantity.toLocaleString()
              );
            }
            $("#balance_procure_quantity").css({ color: "white" });
            return;
          }

          let balanceQuantity = procurementQuantity - currentDispatchedQuantity;
          balance_procure_quantity = balanceQuantity;
            // update calculated balance display (using total quantity)
          $("#balance_procure_quantity").text(
            isNaN(balanceQuantity) ? balanceQuantity : balanceQuantity.toLocaleString()
          );
          if (!isNaN(totalQuantity)) {
            $("#total_procure_quantity_display").text(
              totalQuantity.toLocaleString()
            );
          }
          // adjust colour based on sign
          if (balanceQuantity > 0) {
            $("#balance_procure_quantity").css({ color: "yellow" });
          } else {
            $("#balance_procure_quantity").css({ color: "red" });
          }
        });

