          const current_weight_balance = $("#balance_peeled_quantity").text();

          if (parseFloat(current_weight_balance) <= -1) {
            toastr["warning"]("Invalid dispatch quantity");
            return;
          }

          // Check QA status of selected product
          const selectedProduct = $("#peeledProductNames").select2("data")[0];
          if (selectedProduct && selectedProduct?.qa_status && selectedProduct.qa_status !== "PASS") {
            toastr["error"](
              `❌ Cannot dispatch product with QA status: ${selectedProduct.qa_status}\n\n` +
              "Only products with QA status 'PASS' can be sent to peeled dispatch."
            );
            return;
          }

          let url = "/api/peeled/dispatch";
          let method = "POST"
          let input_params = {
            peeled_product_id: $("#peeledProductNames").val(),
            unit_master_id: $("#distributionLocation").val(),
            peeled_dispatch_quantity: $("#peeled_dispatch_quantity").val(),
            temperature: $("#peeled_dispatch_temperature").val(),
            vehicle_master_id: $("#prodVehicleNumbers").val(),
