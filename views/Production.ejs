        let peeledProductNamesArray = [];
        function loadPeeledProducts(lot_no) {
          $("#peeledProductNames").empty();

          if (!lot_no) {
            toastr["warning"]("Invalid lot number!");
            return;
          }

          $.ajax({
            url: `/api/peeling/product/names?procurement_lot_id=${lot_no}&peeled_dispatch_id=${view_peeled_dispatch_id || null
              }`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (data) => {
              peeledProductNamesArray = [];
              let qaPassedProducts = [];
              let qaFailedProducts = [];

              // For each peeling product, check its QA status
              data?.data?.forEach((item) => {
                const productData = {
                  id: item.id,
                  product_master_id: item?.ProductMaster.id,
                  quantity: parseFloat(item?.peeled_quantity) || 0,
                  text:
                    (item.order_id ? `[Order: ${item.order_id.substring(0, 8)}] ` : "") +
                    item?.ProductMaster.product_name + "-" + item.yield_quantity,
                  qa_status: item?.qa_status || "PENDING",
                  order_id: item.order_id
                };

                // Check if QA status is PASS
                if (item?.qa_status === "PASS") {
                  qaPassedProducts.push(productData);
                } else {
                  qaFailedProducts.push(productData);
                }
              });

              // Show warning if there are products with non-PASS QA status
              if (qaFailedProducts.length > 0) {
                toastr["warning"](
                  `⚠️ ${qaFailedProducts.length} product(s) with QA status not PASS are excluded from selection`
                );
              }

              // Only add PASS products to the selection array
              peeledProductNamesArray = qaPassedProducts;

              if (qaPassedProducts.length === 0) {
                toastr["info"]("No products with PASS QA status available for this lot");
                $("#peeledProductNames").select2({
                  placeholder: "No PASS QA products available",
                  allowClear: true,
                  data: [],
                  disabled: true,
                });
                return;
              }

              $("#peeledProductNames").select2({
                placeholder: "Choose a product (QA PASS only)",
                allowClear: true,
                data: peeledProductNamesArray,
              });

              if (view_peeled_product_id) {
                // Check if previously selected product is still in PASS list
                const isProductInPassList = qaPassedProducts.some(p => p.id === view_peeled_product_id);
                if (isProductInPassList) {
                  $("#peeledProductNames")
                    .val(view_peeled_product_id)
                    .trigger("change");
                } else {
                  toastr["warning"]("Previously selected product no longer has PASS QA status");
                  $("#peeledProductNames").val(null).trigger("change");
                }
              } else {
                $("#peeledProductNames").val(null).trigger("change");
              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              if (jqXhr["status"] == 420) {
                toastr["warning"](jqXhr["responseJSON"]["message"]);
              } else {
                toastr["error"](jqXhr["responseJSON"]["message"]);
              }
            },
          });
        }

        let balance_peeled_quantity = 0;
        $(document).on("change", "#peeledProductNames", () => {
          $("#balance_peeled_quantity").text("");

          if ($("#peeledProductNames").val()) {
            balance_peeled_quantity = $("#peeledProductNames").select2("data")[0]
