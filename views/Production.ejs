            toastr["info"]("Saving inspection status...");

            // Here you would typically send to API endpoint
            // For now, just update the UI
            const row = $("#postpackqaTable").find(`tr:has(td:first:contains('${lotNo}'))`);
            if (row.length > 0) {
              const statusBadge = row.find(".badge");
              statusBadge.removeClass("bg-secondary bg-success bg-danger");

              if (inspectionStatus === "Passed") {
                statusBadge.addClass("bg-success").text("Passed");
              } else if (inspectionStatus === "Failed") {
                statusBadge.addClass("bg-danger").text("Failed");
              } else {
                statusBadge.addClass("bg-secondary").text("Pending");
