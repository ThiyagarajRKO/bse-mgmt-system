        // Function to autopopulate peeled products data
        async function autopopulatePeeledProductData(orderNo, lotNo, productName) {
          try {
            console.log(`[QA] Fetching peeled products for Order: ${orderNo}, Lot: ${lotNo}, Product: ${productName}`);

            // Get the actual lot ID from the map
            const lotId = window.qaLotIdMap?.get(lotNo);
            console.log(`[QA] Lot ID: ${lotId}`);

            if (!lotId) {
              console.log("[QA] Could not find lot ID for lot number:", lotNo);
              return;
            }

            // Fetch peeling data using lot ID (and order if available)
            try {
              let url = `/api/peeling?procurement_lot_id=${lotId}`;
              if (orderNo) {
                // the API now supports filtering by order_id so we can reduce
                // the payload when the user has already chosen an order in the
                // QA panel.  orderNo at this point is the UUID value.
                url += `&order_id=${orderNo}`;
              }
              const peelingResponse = await fetch(url, {
                method: 'GET'
              });

              if (peelingResponse.ok) {
                const peelingResult = await peelingResponse.json();
                console.log("[QA] Peeling response:", peelingResult);

                let totalQuantity = 0;

                if (peelingResult.data) {
                  const peelingRecords = Array.isArray(peelingResult.data?.rows) ? peelingResult.data.rows : peelingResult.data;

                  if (Array.isArray(peelingRecords)) {
                    for (const peeling of peelingRecords) {
                      if (Array.isArray(peeling.PeelingProducts)) {
                        for (const peeledProduct of peeling.PeelingProducts) {
                          if (peeledProduct?.ProductMaster?.product_name === productName) {
                            const yieldQty = parseFloat(peeledProduct.yield_quantity) || 0;
                            totalQuantity += yieldQty;
                            console.log(`[QA] Found matching product with yield_quantity: ${yieldQty}, Running total: ${totalQuantity}`);
                          }
                        }
                      }
                    }
                  }
                }

                // Set the total quantity value
                if (totalQuantity > 0) {
                  $("#qa_quantity").val(totalQuantity.toFixed(2));
                  console.log(`[QA] Autopopulated total quantity: ${totalQuantity.toFixed(2)}`);
                } else {
                  $("#qa_quantity").val("");
                  console.log("[QA] Could not find any matching peeled products");
                }
              } else {
                console.log("[QA] Failed to fetch peeling data:", peelingResponse.status);
                $("#qa_quantity").val("");
              }
            } catch (e) {
              console.error("[QA] Error fetching peeling data:", e.message);
              $("#qa_quantity").val("");
            }

          } catch (error) {
            console.error("[QA] Error autopopulating peeled products:", error);
          }
        }

