        // Handle packing status update
        $(document).on("click", ".updatePackingStatus", (e) => {
          e.preventDefault();

          const packingId = $(e.target).attr("packing_id");
          const currentStatus = $(e.target).attr("packing_status");
          const expiryDate = $(e.target).attr("expiry_date");

          // Validation: Check if expiry date is set
          if (!expiryDate || expiryDate === "null" || expiryDate === "") {
            toastr["warning"]("Cannot mark as ready: Expiry date must be set first!");
            return;
          }

          // Check if already ready
          if (currentStatus === "Ready for Sales") {
            toastr["info"]("This packing is already marked as ready for sales");
            return;
          }

          // Confirm action
          if (confirm("Mark this packing as 'Ready for Sales'? This product will be available for sales inventory.")) {
            updatePackingStatusAPI(packingId, "Ready for Sales");
          }
        });

        function updatePackingStatusAPI(packingId, newStatus) {
          $.ajax({
            url: `/api/packing`,
            method: "PUT",
            dataType: "json",
            contentType: "application/json",
            data: JSON.stringify({
              packing_id: packingId,
              packing_data: {
                packing_status: newStatus
              }
            }),
            success: (data) => {
              toastr["success"]("Packing status updated to: " + newStatus);
              loadPackingProductTableData($("#view_packing_lot_no").attr("procurement_lot_id"));
            },
            error: (jqXhr, textStatus, errorThrown) => {
              if (jqXhr["status"] == 420) {
                toastr["warning"](jqXhr["responseJSON"]["message"]);
              } else {
                toastr["error"](
                  jqXhr["responseJSON"]?.message || "Error updating packing status"
                );
              }
            }
          });
        }

