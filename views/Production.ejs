          console.log("🔄 loadPackingProductNames called with lot:", packing_lot_no);
          $("#packingProductNames").empty();

          if (!packing_lot_no) {
            toastr["warning"]("Invalid lot number!");
            return;
          }

          // Determine product type from the lot mapping (not global flag)
          const lotProductType = packingLotProductTypeMap[packing_lot_no];
          const isUnprocessed = lotProductType === "UNPROCESSED";
          console.log("📌 Lot", packing_lot_no, "product type:", lotProductType, "isUnprocessed:", isUnprocessed);

          // Determine which endpoint to use based on ACTUAL product type of this lot
          const apiUrl = isUnprocessed
            ? `/api/dispatch/names?procurement_lot_id=${packing_lot_no}`
            : `/api/peeled_dispatches/names?procurement_lot_id=${packing_lot_no}`;

          console.log("🔗 Using API endpoint:", apiUrl, "(isUnprocessed:", isUnprocessed, ")");

          $.ajax({
            url: apiUrl,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (data) => {
              console.log("✅ Dispatch products API response:", data);
              packingProductNamesArray = [];

              if (isUnprocessed) {
                // For unprocessed dispatches
                data?.data?.forEach((item) => {
                  packingProductNamesArray.push({
                    id: item.id,
                    product_master_id: item?.pp?.ProductMaster?.id,
                    quantity: (item?.dispatch_quantity || 0) - (item?.packed_quantity || 0),
                    text: item?.pp?.ProductMaster?.product_name + "-" + ((item?.dispatch_quantity || 0) - (item?.packed_quantity || 0)),
                    qa_status: "PASS",
                    source: "dispatch"
                  });
                });
              } else {
                // For peeled dispatches
                data?.data?.forEach((item) => {
                  packingProductNamesArray.push({
                    id: item.id,
                    product_master_id: item?.pp?.ProductMaster?.id,
                    quantity: (item?.peeled_dispatch_quantity || 0) - (item?.packed_quantity || 0),
                    text: item?.pp?.ProductMaster?.product_name + "-" + ((item?.peeled_dispatch_quantity || 0) - (item?.packed_quantity || 0)),
                    qa_status: "PASS",
                    source: "peeled_dispatch"
                  });
                });
              }

              console.log("📦 Mapped packing product names:", packingProductNamesArray);

              if (packingProductNamesArray.length === 0) {
                console.warn("⚠️ No dispatches available");
                if (!isUnprocessed) {
                  console.warn("⚠️ Checking for unprocessed dispatches as fallback");
                  loadUnprocessedDispatchesForPacking(packing_lot_no);
