      let productNamesArray = [];
      function loadPeelingProducts(species_id) {
        $(".peelingProductNames").empty();
        productNamesArray = [];

        const dispatch_id = $("#rawMaterials").val();

        if (!dispatch_id) {
          console.log("No dispatch selected");
          $(".peelingProductNames").select2({
            placeholder: "Select product",
            allowClear: true,
            data: [],
          });
          return;
        }

        console.log("=== loadPeelingProducts ===");
        console.log("Loading ordered products for dispatch_id:", dispatch_id);

        // Fetch dispatch to get ordered products
        $.ajax({
          url: `/api/dispatch/${dispatch_id}`,
          method: "GET",
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          processData: false,
          success: (response) => {
            productNamesArray = [];
            console.log("Dispatch response:", response);

            if (response?.success && response?.data) {
              const dispatch = response.data;

              // Get ordered products from dispatch data
              const orderedProducts = dispatch?.ordered_products || [];
              console.log("Ordered products array:", orderedProducts);

              // Add each ordered product to the dropdown
              if (orderedProducts && orderedProducts.length > 0) {
                orderedProducts.forEach((op) => {
                  if (op?.ProductMaster?.id && op?.ProductMaster?.product_name) {
                    console.log(`✓ Adding ordered product: ${op.ProductMaster.product_name} (ID: ${op.ProductMaster.id})`);

                    productNamesArray.push({
                      id: op.ProductMaster.id,
                      text: op.ProductMaster.product_name,
                    });
                  }
                });
              } else {
                console.warn("No ordered products found in dispatch response");
              }
            } else {
              console.warn("Invalid response structure:", response);
            }

            console.log("Final productNamesArray:", productNamesArray);

            // Populate Select2 dropdowns with ordered products
            $(".peelingProductNames").select2({
              placeholder: "Select product",
              allowClear: true,
              data: productNamesArray,
            });

            if (!is_updated_data) {
              $(".peelingProductNames").val(null).trigger("change");
            }
          },
          error: (jqXhr, textStatus, errorThrown) => {
            console.error("Error fetching dispatch:", textStatus, errorThrown);
            toastr["error"]("Failed to load ordered products from dispatch");

            $(".peelingProductNames").select2({
              placeholder: "Error loading products",
              allowClear: true,
              data: [],
            });
          },
        });
      }

      $(document).on("keyup", "#peeling_quantity", (e) => {
        e.preventDefault();

        const currentPeelingQuantity = $(e.target).val();
        const procurementQuantity = parseFloat(
          $("#rawMaterials").select2("data")[0]?.quantity
        );

        if (!currentPeelingQuantity) {
          $("#balance_dispatched_quantity").text(balance_dispatched_quantity);
          $("#balance_dispatched_quantity").css({ color: "white" });
          return;
        }

        let balanceQuantity = procurementQuantity - currentPeelingQuantity;

        $("#balance_dispatched_quantity").text(
          !isNaN(balanceQuantity) ? balanceQuantity : currentPeelingQuantity
        );

        if (balanceQuantity > 0) {
          $("#balance_dispatched_quantity").css({ color: "yellow" });
        } else {
          $("#balance_dispatched_quantity").css({ color: "red" });
        }

        // Trigger yield recalculation for all selected products when quantity changes
        $(".peelingProductNames").each(function() {
          if ($(this).val()) {
            $(this).trigger('change');
          }
        });
      });

      // Auto-generate yield quantity when product is selected
      $(document).on("change", ".peelingProductNames", function() {
        const productId = $(this).val();
        const peelingQuantity = parseFloat($("#peeling_quantity").val());
        const fieldsetIndex = $(this).attr('class').match(/peelingProductNames_(\d+)/)?.[1] || '1';
        const yieldQuantityField = $(`.yield_quantity_${fieldsetIndex}`);
        const yieldInfoField = $(`.yield-info_${fieldsetIndex}`);

        if (!productId || !peelingQuantity || peelingQuantity <= 0) {
          // Clear yield quantity and info if no product selected or invalid quantity
          yieldQuantityField.val('');
          yieldInfoField.html('<i class="fas fa-info-circle"></i> Select a product to auto-calculate yield');
          return;
        }

        // Show loading state
        yieldInfoField.html('<i class="fas fa-spinner fa-spin"></i> Calculating yield...');

        // Call yield suggestions API
        $.ajax({
          url: '/api/orders/yield-suggestions',
          method: 'POST',
          dataType: 'json',
          contentType: 'application/json',
          data: JSON.stringify({
            product_id: productId,
            raw_quantity: peelingQuantity
          }),
          success: function(response) {
            if (response.success && response.data) {
              const suggestions = response.data;
              if (suggestions.length > 0) {
                const suggestion = suggestions[0]; // Use first suggestion
                yieldQuantityField.val(suggestion.suggested_quantity);

                // Show yield information
                const yieldRate = suggestion.yield_rate ? `${suggestion.yield_rate}%` : 'N/A';
                const requiredRaw = suggestion.required_raw_quantity ? suggestion.required_raw_quantity : 'N/A';
                const inventoryStatus = suggestion.inventory_status || 'Unknown';

                yieldInfoField.html(`
                  <i class="fas fa-check-circle text-success"></i>
                  <strong>Yield Rate:</strong> ${yieldRate} |
                  <strong>Required Raw:</strong> ${requiredRaw} |
                  <strong>Inventory:</strong> ${inventoryStatus}
                `);

                toastr["success"](`Yield auto-calculated: ${suggestion.suggested_quantity} units`);
              } else {
                yieldInfoField.html('<i class="fas fa-exclamation-triangle text-warning"></i> No yield data available');
                yieldQuantityField.val('');
              }
            } else {
              yieldInfoField.html('<i class="fas fa-exclamation-triangle text-warning"></i> No yield suggestions available');
              yieldQuantityField.val('');
            }
          },
          error: function(jqXHR, textStatus, errorThrown) {
            console.error("Error fetching yield suggestions:", textStatus, errorThrown);
            yieldInfoField.html('<i class="fas fa-times-circle text-danger"></i> Failed to calculate yield');
            yieldQuantityField.val('');
            toastr["error"]("Failed to calculate yield quantity");
          }
        });
      });

