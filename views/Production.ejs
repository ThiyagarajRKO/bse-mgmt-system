    <style type="text/css">
      body {
        background-color: #f7f9fd;
        font-family: "Lato-Regular", sans-serif;
        font-size: 14px;
        line-height: 1.5;
        color: #333;
      }

      * {
        font-family: "Lato-Regular", sans-serif;
        font-size: inherit;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Lato-Bold", sans-serif;
        line-height: 1.2;
        margin-bottom: 0.5rem;
      }

      label {
        font-family: "Lato-Regular", sans-serif;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 0.5rem;
      }

      .form-control,
      .form-select,
      textarea,
      select,
      input {
        font-family: "Lato-Regular", sans-serif;
        font-size: 14px;
      }

      .btn {
        font-family: "Lato-Bold", sans-serif;
        font-size: 12px;
        font-weight: 500;
      }

      .toast {
        opacity: 1 !important;
        font-family: "Lato-Regular", sans-serif;
        font-size: 14px;
      }

      a,
      .edit,
      .view,
      .close,
      .del {
        cursor: pointer;
      }

      .panelClose {
        cursor: pointer;
      }

      .select2-dropdown {
        z-index: 10000 !important;
      }

      /* Table Pagination */
      .page-item.active .page-link {
        color: #fff !important;
        background-color: #ea5455 !important;
        border-color: #ea5455 !important;
      }

      .page-link {
        color: #000 !important;
        background-color: #fff !important;
        border: 1px solid #dee2e6 !important;
      }

      .page-link:hover {
        color: #fff !important;
        background-color: #f17979 !important;
        border-color: #ea5455 !important;
      }

      svg.radial-progress {
        width: 60px;
        height: auto;
        transform: rotate(-90deg);
      }

      svg.radial-progress circle {
        fill: none;
        stroke: white;
        stroke-dashoffset: 219.91148575129;
        stroke-width: 6;
        stroke-linecap: round;
      }

      svg.radial-progress circle.incomplete {
        opacity: 0.15;
      }

      svg.radial-progress circle.complete {
        stroke-dasharray: 219.91148575129;
      }

      svg.radial-progress text {
        fill: white;
        text-anchor: middle;
      }

      .topMenu-item {
        cursor: pointer;
      }

      .topMenu-item-active {
        /* box-shadow: 0 -2px 0 0 #ea5455; */
        color: #ea5455;
      }

      .topMenu-item-active .icon-button {
        /* border-bottom: 1px solid #ea5455; */
        background-color: #ea5455 !important;
        color: white;

        /* background-color: #f07b3f; */
        /* border-radius: 8px; */
        transition: right 0.3s ease;
        /* font-weight: bold; */
      }

      .topMenu-item-active .icon-label {
        font-weight: 600;
      }

      .topMenu-item:hover:not(.topMenu-item-active) {
        /* box-shadow: 0 -2px 0 0 #ea5455; */
        color: #ea5455;
      }

      #dispatchProductTable_wrapper {
        margin-top: 60px !important;
      }

      .slideInPanel {
        z-index: 9999;
        position: fixed;
        top: 0;
        bottom: 0;
        right: -600px;
        width: 400px;
        background-color: #1f2d3e;
        color: #e3e3e3;
        height: 90vh;
        /* box-shadow: 0 0 0px rgba(0, 0, 0, 0.2); */
        transition: right 0.3s ease;
        border-radius: 8px;
      }

      /* Input */
      .slideInPanel input {
        background-color: transparent;
        border-color: rgba(98, 114, 147, 0.6);
      }

      .slideInPanel input:focus {
        background-color: transparent;
      }

      .slideInPanel input:hover {
        border-color: #627293;
      }

      /* Select */
      .slideInPanel .select2-container {
        background-color: transparent !important;
        border-color: rgba(98, 114, 147, 0.6) !important;
        color: 627293 !important;
      }

      .select2-container {
        width: 100% !important;
      }

      .select2-selection__rendered,
      .select2-selection__clear,
      .select2-selection__arrow {
        color: white !important;
        margin-top: 0.25rem !important;
      }

      .select2-selection {
        background-color: transparent !important;
        border-color: rgba(98, 114, 147, 0.6) !important;
        height: 35px !important;
      }

      .slideInPanel .select:focus {
        background-color: transparent;
        border-color: #627293;
      }

      .slideInPanel .select2-container:hover {
        border-color: #627293;
      }

      /* TextArea */
      .slideInPanel textarea {
        background-color: transparent;
        border-color: rgba(98, 114, 147, 0.6);
      }

      .slideInPanel textarea:focus {
        background-color: transparent;
      }

      .slideInPanel textarea:hover {
        border-color: #627293;
      }

      /* Form Control */
      .slideInPanel .form-control {
        color: #f7f9fc;
      }

      .slideInPanel .form-control::placeholder {
        color: #627293;
      }

      .select2-selection::placeholder {
        color: #627293;
      }

      /* QA Form Styling */
      .qa-dropdown + .select2-container {
        width: 100% !important;
      }

      .qa-dropdown + .select2-container .select2-selection {
        background-color: transparent !important;
        border-color: rgba(98, 114, 147, 0.6) !important;
        height: 38px;
        display: flex;
        align-items: center;
      }

      .qa-dropdown + .select2-container--open .select2-selection {
        border-color: #627293 !important;
      }

      .qa-dropdown + .select2-container .select2-selection__rendered {
        /* use the same white text that other slide‑panel dropdowns use so the
           order selector visually matches the rest of the app */
        color: #f7f9fc !important;
        padding-left: 0.5rem;
      }

      .qa-dropdown + .select2-container .select2-selection__placeholder {
        color: #627293 !important;
      }

      .qa-dropdown + .select2-container .select2-selection__clear {
        color: #627293;
        cursor: pointer;
      }

      /* QA Metrics Section Styling - keep font sizing/color consistent with
         the generic slideInPanel styles used elsewhere in the app.  most
         of the panel text should simply inherit the panel's base color
         (#e3e3e3) and use the normal 1rem font size.  only tweak weight
         slightly to keep labels legible. */
      #qaSlideInPanel .form-group {
        margin-bottom: 1.25rem;
      }

      #qaSlideInPanel .form-group label {
        /* match generic side‑panel label color/size */
        color: #e3e3e3;
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.5rem;
      }

      #qaSlideInPanel .form-control:focus {
        background-color: rgba(98, 114, 147, 0.1);
        border-color: #627293;
        /* keep focus text color same as regular panel text */
        color: #e3e3e3;
      }

      #qaSlideInPanel .form-check-input:checked {
        background-color: #ea5455;
        border-color: #ea5455;
      }

      #qaSlideInPanel .form-check-label {
        /* match other panels */
        color: #e3e3e3;
        font-weight: 500;
        margin-left: 0.5rem;
      }

      #qaSlideInPanel textarea.form-control {
        background-color: transparent;
        border-color: rgba(98, 114, 147, 0.6);
        /* regular panel text color */
        color: #e3e3e3;
      }

      #qaSlideInPanel textarea.form-control:focus {
        background-color: rgba(98, 114, 147, 0.1);
        border-color: #627293;
      }

      #qaSlideInPanel .alert {
        background-color: rgba(98, 114, 147, 0.15) !important;
        border-color: rgba(98, 114, 147, 0.3) !important;
        color: #e3e3e3;
      }

      #qaSlideInPanel .text-muted {
        /* use the standard bootstrap muted color so it doesn't look
           like a bespoke scheme just for QA */
        color: #6c757d !important;
        font-size: 0.85rem;
      }

      /* enforce 14px base for entire QA panel and its inputs
         as the global body font-size is 14px but bootstrap inputs default
         to 1rem (16px) so we need explicit overrides here */
      #qaSlideInPanel {
        font-size: 14px !important;
        /* ensure panel text colour is the standard grey used elsewhere */
        color: #e3e3e3;
      }

      /* catch any descendants including headings or utility classes that
         might inflate font-size; kicker to 14px with !important */
      #qaSlideInPanel,
      #qaSlideInPanel * {
        font-size: 14px !important;
      }

      /* override bootstrap size utility used on the panel heading */
      #qaSlideInPanel .fs-5 {
        font-size: 14px !important;
      }

      #qaSlideInPanel .form-control,
      #qaSlideInPanel select,
      #qaSlideInPanel textarea,
      #qaSlideInPanel .form-check-label,
      #qaSlideInPanel .select2-selection__rendered {
        font-size: 14px !important;
      }

      /* Peeling panel should mirror the QA/other slide panels styling as well */
      #peelingSlideInPanel .form-group {
        margin-bottom: 1.25rem;
      }

      #peelingSlideInPanel .form-group label {
        color: #e3e3e3;
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.5rem;
      }

      #peelingSlideInPanel .form-control:focus {
        background-color: rgba(98, 114, 147, 0.1);
        border-color: #627293;
        color: #e3e3e3;
      }

      #peelingSlideInPanel .form-check-label {
        color: #e3e3e3;
        font-weight: 500;
        margin-left: 0.5rem;
      }

      #peelingSlideInPanel textarea.form-control {
        background-color: transparent;
        border-color: rgba(98, 114, 147, 0.6);
        color: #e3e3e3;
      }

      #peelingSlideInPanel .alert {
        background-color: rgba(98, 114, 147, 0.15) !important;
        border-color: rgba(98, 114, 147, 0.3) !important;
        color: #e3e3e3;
      }

      table.dataTable th {
        text-align: left !important;
      }

      fieldset {
        border-color: rgba(129, 145, 179, 0.6) !important;
        border-radius: 4px;
      }

      legend {
        margin-top: -1.7rem !important;
        background-color: #e0e0e0;
        color: #1f2d3e;
        border-radius: 4px;
        font-size: inherit !important;
      }

      #appendOutput:hover {
        background-color: rgb(135, 49, 177);
        background-color: linear-gradient(
          90deg,
          rgba(135, 49, 177, 1) 1%,
          rgba(191, 24, 188, 1) 35%,
          rgba(209, 52, 174, 1) 68%,
          rgba(217, 29, 115, 1) 100%
        );
        color: white;
      }

      /*
      #appendOutput {
        color: rgba(98, 114, 147, 0.6) !important;
      } */

      .st-theme-brick > .nav .nav-link.active {
        background-color: #dc4c64 !important;
      }

      .st-theme-brick > .nav .nav-link {
        color: #dc4c64 !important;
      }

      .st-theme-brick > .nav {
        border-color: #dc4c64 !important;
      }

      .vl {
        border-left: 2px dashed rgba(98, 114, 147, 0.6);
        height: 25px;
        position: absolute;
        left: 50%;
        margin-left: -3px;
        /* bottom: -10; */
      }

      .vl-top {
        border-left: 2px dashed rgba(98, 114, 147, 0.6);
        height: 35px;
        position: absolute;
        left: 50%;
        margin-left: -3px;
        /* bottom: -10; */
      }

      .tippy-box {
        /* background-color: white !important; */
        max-width: 100% !important;
        /* box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.175); */
      }

      .progressBar-label {
        font-size: 13px;
        /* font-weight: bold; */
        color: white;
        font-family: var(--secondary-font);
      }

      .progressBar-weight {
        font-size: 20px;
        font-weight: bold;
        color: #b4b4b4;
        font-family: var(--heading-font);
      }

      .progressBar-weight-unit {
        font-size: 12px;
        /* font-weight: bold; */
        color: #b4b4b4;
      }

      .icon-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
        background-color: white;
        /* border: 2px solid #ddd; */
        border-radius: 50%;
        /* box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); */
        text-decoration: none;
        color: #333;
        transition:
          background-color 0.3s,
          color 0.3s,
          box-shadow 0.3s;
      }

      .icon-button i {
        font-size: 12px;
      }

      .icon-label {
        font-size: 14px;
        /* font-weight: 600; */
      }

      .stepper-menu {
        background-color: #293646;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>
  </head>

  <body>
    <div class="container-fluid">
      <div class="row d-flex justify-content-center">
        <!-- ------------------------------------------------------------------------------------------------------------- -->
        <!-- ------------------------------------------ Top Menu Container ----------------------------------------------- -->
        <!-- ------------------------------------------------------------------------------------------------------------- -->
        <div
          class="topMenu-container d-flex justify-content-center overflow-auto mt-0"
