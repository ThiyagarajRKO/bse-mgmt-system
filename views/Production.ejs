        function loadPeelingRawMaterials(lot_no, unit_master_id) {
          if (!lot_no) {
            toastr["warning"]("Invalid lot number!");
            return;
          }

          if (!unit_master_id) {
            toastr["warning"]("Invalid Peeling center!");
            return;
          }

          console.log("loadPeelingRawMaterials called with lot_no:", lot_no, "unit_master_id:", unit_master_id);

          $.ajax({
            url: `/api/dispatch/names?procurement_lot_id=${lot_no}&unit_master_id=${unit_master_id}&peeling_id=${$("#submitPeeling").attr("peeling_id") || null}`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (data) => {
              console.log("loadPeelingRawMaterials - received data:", data);
              console.log("loadPeelingRawMaterials - data?.data:", data?.data);

              const rawMaterialOptions = $.map(data?.data || [], function (item) {
                // log full object and its keys so we can see where dispatch
                // quantity is living in case the API shape changed
                console.log("loadPeelingRawMaterials - mapping item", item);
                console.log("loadPeelingRawMaterials - item keys", Object.keys(item));

                // dispatch quantity may be absent or nested depending on the
                // sequelize/raw settings; attempt multiple fallbacks so we
                // always get a number.
                let dispatchQty = 0;
                if (item && item.dispatch_quantity != null) {
                  dispatchQty = item.dispatch_quantity;
                } else if (item && item.Dispatches && item.Dispatches.dispatch_quantity != null) {
                  dispatchQty = item.Dispatches.dispatch_quantity;
                } else if (item && item.pp && item.pp.dispatch_quantity != null) {
                  dispatchQty = item.pp.dispatch_quantity;
                }
                dispatchQty = parseFloat(String(dispatchQty || "").replace(/,/g, "")) || 0;

                const peelingQ = parseFloat(String(item?.peeling_quantity || "").replace(/,/g, "")) || 0;

                return {
                  id: item?.id,
                  species_id:
                    item?.pp?.ProductMaster
                      ?.ProductCategoryMaster?.species_master_id,
                  quantity: dispatchQty - peelingQ,
                  dispatch_qty: dispatchQty,
                  text: `${item?.pp?.ProductMaster?.product_name
                    }-${item?.pp?.procurement_product_type
                    }-${item?.pp?.SupplierMaster?.supplier_name?.replaceAll(
                      " ",
                      ""
                    )}-${dispatchQty}`,
                };
              });

              console.log("loadPeelingRawMaterials - options:", rawMaterialOptions);

              $("#rawMaterials").select2({
                placeholder: "Choose a raw material",
                allowClear: true,
                data: rawMaterialOptions,
              });

              if (view_raw_material_id) {
                $("#rawMaterials").val(view_raw_material_id).trigger("change");
                // build a map to aggregate products by product_master_id so that the dropdown shows only a single entry per product, with quantities summed
                const agg = {};
                $.each(data?.data || [], function (_, item) {
                  console.log("loadProducts - mapping item:", item);
                  const totalQty = parseFloat(
                    String(item?.procurement_quantity || "").replace(/,/g, "")
                  ) || 0;
                  const dispatchedQty = parseFloat(
                    String(item?.dispatched_quantity || "").replace(/,/g, "")
                  ) || 0;
                  const remainingQty = totalQty - dispatchedQty;
                  const key = item.product_master_id || item.id;
                  if (!agg[key]) {
                    agg[key] = {
                      id: key,
                      product_master_id: item.product_master_id,
                      overall_total_quantity: item.overall_total_quantity || totalQty,
                      total_quantity: 0,
                      remaining_quantity: 0,
                      quantity: 0,
                      text: `${item?.product_name || item?.ProductMaster?.product_name}-${item?.procurement_product_type}-${(item?.supplier_name || item?.SupplierMaster?.supplier_name)?.replaceAll(" ", "")}`,
                    };
                  }
                  // accumulate
                  agg[key].total_quantity += totalQty;
                  agg[key].remaining_quantity += remainingQty;
                  agg[key].quantity = agg[key].remaining_quantity;
                  // ensure overall_total_quantity reflects the latest value (it should be same)
                  agg[key].overall_total_quantity = item.overall_total_quantity || agg[key].overall_total_quantity;
                });
                const productOptions = Object.values(agg);
              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("loadPeelingRawMaterials - error:", jqXhr);
              if (jqXhr["status"] == 420) {
                toastr["warning"](jqXhr["responseJSON"]["message"]);
              } else {
                toastr["error"](jqXhr["responseJSON"]["message"]);
              }
            },
          });
        }

        $(document).on("change", "#rawMaterials", () => {
          if ($("#rawMaterials").val()) {
            $("#balance_dispatched_quantity").text("");

            $(".peelingProductNames").empty();
            productNamesArray = [];

            // Debug: log selected raw material data to help trace incorrect zero values
            const selectedRaw = $("#rawMaterials").select2("data")[0] || {};
            console.log("rawMaterials.change - selected:", selectedRaw);

            // coerce quantity to number robustly (strip commas and non-numeric chars)
            const rawQtyStr = String(selectedRaw.quantity || "").replace(/,/g, "");
            const parsedQty = parseFloat(rawQtyStr);
            balance_dispatched_quantity = Number.isFinite(parsedQty) ? parsedQty : 0;
            console.log("rawMaterials.change - parsedQty:", parsedQty, "balance_dispatched_quantity:", balance_dispatched_quantity);
            // if parsing produced zero but the selected option carries a
            // dispatch_qty field, trust that value instead (handles edge
            // cases where the computed quantity is zero because of missing
            // dispatch data).  note this will be updated again on keyup later.
            if (balance_dispatched_quantity === 0 && selectedRaw.dispatch_qty != null) {
              balance_dispatched_quantity = parseFloat(String(selectedRaw.dispatch_qty).replace(/,/g, "")) || 0;
              console.log("rawMaterials.change - fallback dispatch_qty", selectedRaw.dispatch_qty);
            }

            if (!isNaN(balance_dispatched_quantity)) {
              $("#balance_dispatched_quantity").text(
                parseFloat(balance_dispatched_quantity)
              );

              $("#balance_dispatched_quantity").css({ color: "white" });
            }

            $("#peeling_quantity").keyup();

            const species_id = $("#rawMaterials").select2("data")[0]?.species_id;
            loadPeelingProducts(species_id);
          }
        });

        let productNamesArray = [];
        function loadPeelingProducts(species_id) {
          $(".peelingProductNames").empty();
          productNamesArray = [];

          const dispatch_id = $("#rawMaterials").val();

          if (!dispatch_id) {
            console.log("No dispatch selected");
            // no dispatch chosen yet; still provide generic product list
            loadGenericPeelingProducts();
            return;
          }

          console.log("=== loadPeelingProducts ===");
          console.log("Loading ordered products for dispatch_id:", dispatch_id);

          // Fetch dispatch to get ordered products
          $.ajax({
            url: `/api/dispatch/${dispatch_id}`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (response) => {
              productNamesArray = [];
              console.log("Dispatch response:", response);

              if (response?.success && response?.data) {
                const dispatch = response.data;

                // Get ordered products from dispatch data
                const orderedProducts = dispatch?.ordered_products || [];
                console.log("Ordered products array:", orderedProducts);

                // Add each ordered product to the dropdown
                if (orderedProducts && orderedProducts.length > 0) {
                  orderedProducts.forEach((op) => {
                    if (op?.ProductMaster?.id && op?.ProductMaster?.product_name) {
                      console.log(`✓ Adding ordered product: ${op.ProductMaster.product_name} (ID: ${op.ProductMaster.id})`);

                      productNamesArray.push({
                        id: op.ProductMaster.id,
                        text: op.ProductMaster.product_name,
                      });
                    }
                  });
                } else {
                  console.warn("No ordered products found in dispatch response");
                }
              } else {
                console.warn("Invalid response structure:", response);
              }

              console.log("Final productNamesArray:", productNamesArray);

              // if nothing came back from the dispatch API, fall back to a
              // generic product list so the dropdown isn't totally empty.
              if (productNamesArray.length === 0) {
                console.warn("no ordered products returned, loading generic list");
                loadGenericPeelingProducts();
                return;
              }

              // Populate Select2 dropdowns with ordered products
              $(".peelingProductNames").select2({
                placeholder: "Select product",
                allowClear: true,
                data: productNamesArray,
              });

              if (!is_updated_data) {
                $(".peelingProductNames").val(null).trigger("change");
              }

              // if we were in edit mode and have pending product data, apply it
              // now that the dropdown has actual options available
              if (existingPeelingProducts) {
                populatePeelingOutputs(existingPeelingProducts);
                existingPeelingProducts = null;
              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.error("Error fetching dispatch:", textStatus, errorThrown);
              toastr["error"]("Failed to load ordered products from dispatch");

              $(".peelingProductNames").select2({
                placeholder: "Error loading products",
                allowClear: true,
                data: [],
              });
              // on failure fall back to generic product list so dropdown isn't blank
              loadGenericPeelingProducts();
            },
          });
        }

          // If a dispatch doesn't contain any ordered products we give users a
          // fallback so that the dropdown isn't left completely blank.  Rather
          // than forcing them to create an order we simply load the generic
          // product dropdown used elsewhere in the app.
          function loadGenericPeelingProducts() {
            $.ajax({
              url: "/api/master/product/dropdown",
              method: "GET",
              dataType: "json",
              contentType: "application/json",
              crossDomain: true,
              processData: false,
              success: (response) => {
                productNamesArray = [];
                const items = response?.data?.rows || response?.data || [];
                items.forEach((item) => {
                  productNamesArray.push({
                    id: item.id,
                    text: item.text || item.product_name || item.name,
                  });
                });
                $(".peelingProductNames").select2({
                  placeholder: "Select product",
                  allowClear: true,
                  data: productNamesArray,
                });
                if (existingPeelingProducts) {
                  populatePeelingOutputs(existingPeelingProducts);
                  existingPeelingProducts = null;
                }
              },
              error: (jqXhr) => {
                  console.error("Generic product dropdown load error:", jqXhr);
                  $(".peelingProductNames").select2({
                    placeholder: "Error loading products",
                    allowClear: true,
                    data: [],
                  });
                },
              });
            }

        $(document).on("keyup", "#peeling_quantity", (e) => {
          e.preventDefault();

          const currentPeelingQuantity = $(e.target).val();
          const procurementQuantity = parseFloat(
            $("#rawMaterials").select2("data")[0]?.quantity
          );

          if (!currentPeelingQuantity) {
            $("#balance_dispatched_quantity").text(balance_dispatched_quantity);
            $("#balance_dispatched_quantity").css({ color: "white" });
            return;
          }

          let balanceQuantity = procurementQuantity - currentPeelingQuantity;

          $("#balance_dispatched_quantity").text(
            !isNaN(balanceQuantity) ? balanceQuantity : currentPeelingQuantity
          );

          if (balanceQuantity > 0) {
            $("#balance_dispatched_quantity").css({ color: "yellow" });
          } else {
            $("#balance_dispatched_quantity").css({ color: "red" });
          }

          // Trigger yield recalculation for all selected products when quantity changes
          $(".peelingProductNames").each(function() {
            if ($(this).val()) {
              $(this).trigger('change');
            }
          });
        });

        // Auto-generate yield quantity when product is selected
        $(document).on("change", ".peelingProductNames", function() {
          const productId = $(this).val();
          const peelingQuantity = parseFloat($("#peeling_quantity").val());
          const fieldsetIndex = $(this).attr('class').match(/peelingProductNames_(\d+)/)?.[1] || '1';
          const yieldQuantityField = $(`.yield_quantity_${fieldsetIndex}`);
          const yieldInfoField = $(`.yield-info_${fieldsetIndex}`);

          if (!productId || !peelingQuantity || peelingQuantity <= 0) {
            // Clear yield quantity and info if no product selected or invalid quantity
            yieldQuantityField.val('');
            yieldInfoField.html('<i class="fas fa-info-circle"></i> Select a product to auto-calculate yield');
            return;
          }

          // Show loading state
          yieldInfoField.html('<i class="fas fa-spinner fa-spin"></i> Calculating yield...');

          // Call yield suggestions API
          $.ajax({
            url: '/api/orders/yield-suggestions',
            method: 'POST',
            dataType: 'json',
            contentType: 'application/json',
            data: JSON.stringify({
              product_id: productId,
              raw_quantity: peelingQuantity
            }),
            success: function(response) {
              if (response.success && response.data) {
                const suggestions = response.data;
                if (suggestions.length > 0) {
                  const suggestion = suggestions[0]; // Use first suggestion
                  yieldQuantityField.val(suggestion.suggested_quantity);

                  // Show yield information
                  const yieldRate = suggestion.yield_rate ? `${suggestion.yield_rate}%` : 'N/A';
                  const requiredRaw = suggestion.required_raw_quantity ? suggestion.required_raw_quantity : 'N/A';
                  const inventoryStatus = suggestion.inventory_status || 'Unknown';

                  yieldInfoField.html(`
                    <i class="fas fa-check-circle text-success"></i>
                    <strong>Yield Rate:</strong> ${yieldRate} |
                    <strong>Required Raw:</strong> ${requiredRaw} |
                    <strong>Inventory:</strong> ${inventoryStatus}
                  `);

                  toastr["success"](`Yield auto-calculated: ${suggestion.suggested_quantity} units`);
                } else {
                  yieldInfoField.html('<i class="fas fa-exclamation-triangle text-warning"></i> No yield data available');
                  yieldQuantityField.val('');
                }
              } else {
                yieldInfoField.html('<i class="fas fa-exclamation-triangle text-warning"></i> No yield suggestions available');
                yieldQuantityField.val('');
              }
            },
            error: function(jqXHR, textStatus, errorThrown) {
              console.error("Error fetching yield suggestions:", textStatus, errorThrown);
              yieldInfoField.html('<i class="fas fa-times-circle text-danger"></i> Failed to calculate yield');
              yieldQuantityField.val('');
              toastr["error"]("Failed to calculate yield quantity");
            }
          });
        });

