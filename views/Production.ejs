              console.log("✅ Initializing packingProductNames select2 with", packingProductNamesArray.length, "products");
              // If select2 was previously initialized on this element, destroy it first
              if ($("#packingProductNames").hasClass("select2-hidden-accessible")) {
                $("#packingProductNames").select2("destroy");
