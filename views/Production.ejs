        async function triggerAIRecommendations() {
          const quantity = $("#packing_quantity").val();
          const productName = $("#packingProductNames").text();

          if (!quantity || quantity <= 0) {
            toastr["warning"]("Please enter a quantity first");
            return;
          }

          // Show loading state
          $("#aiRecommendBtn").prop("disabled", true);
          $("#aiRecommendBtn").html('<i class="fa-solid fa-spinner fa-spin"></i> Loading...');

          try {
            const response = await $.ajax({
              url: "/api/packing/ai-containers",
              method: "POST",
              dataType: "json",
              contentType: "application/json",
              data: JSON.stringify({
                product_id: "1",
                quantity_kg: parseFloat(quantity),
                market: "EXPORT",
                grade: "PREMIUM",
                size: "MEDIUM"
              })
            });

            if (response.statusCode === 200 && response.data.top_recommendations) {
              displayAIRecommendations(response.data.top_recommendations);
              // Auto-select the best option
              if (response.data.best_option) {
                selectAIContainer(response.data.best_option.packaging_id, response.data.best_option.packaging_code, response.data.best_option.ai_score, true);
              }
            } else {
              toastr["error"]("Failed to get recommendations");
            }
          } catch (error) {
            console.error("Error fetching recommendations:", error);
            toastr["error"](error.responseJSON?.message || "Error fetching AI recommendations");
          } finally {
            $("#aiRecommendBtn").prop("disabled", false);
            $("#aiRecommendBtn").html('<i class="fa-solid fa-sparkles"></i> Get AI Recommendations');
          }
        }

        function displayAIRecommendations(recommendations) {
          let html = '<div class="text-center mb-3"><strong>Top 3 AI Recommended Containers</strong></div>';

          recommendations.forEach((rec, index) => {
            const badge = index === 0 ? '<span class="badge badge-success me-2">BEST</span>' : '';
            html += `
              <div class="mb-3 p-2 border rounded" style="background-color: white; cursor: pointer;"
                   data-packaging-id="${rec.packaging_id}"
                   data-packaging-code="${rec.packaging_code}"
                   data-ai-score="${rec.ai_score}"
                   class="ai-recommendation-item">
                ${badge}
                <div class="d-flex justify-content-between align-items-center">
                  <div class="flex-grow-1">
                    <strong>${rec.packaging_code}</strong><br>
                    <small class="text-muted">
                      ${rec.containers_needed} containers |
                      ${rec.utilization_rate}% utilized |
                      Score: ${rec.ai_score}
                    </small>
                  </div>
                  <div class="text-right">
                    <span class="badge badge-${rec.efficiency_rating === 'OPTIMAL' ? 'success' : rec.efficiency_rating === 'GOOD' ? 'info' : 'warning'}">
                      ${rec.efficiency_rating}
                    </span>
                  </div>
                </div>
              </div>
            `;
          });

          $("#aiRecommendationsContent").html(html);
          $("#aiRecommendationsPanel").removeClass("d-none");

          // Attach click handlers to recommendation items using event delegation
          $(document).off("click", ".ai-recommendation-item").on("click", ".ai-recommendation-item", function() {
            const packagingId = $(this).data("packaging-id");
            const packagingCode = $(this).data("packaging-code");
            const aiScore = $(this).data("ai-score");
            selectAIContainer(packagingId, packagingCode, aiScore, false);
          });
        }

        function selectAIContainer(packagingId, packagingCode, score, autoSelect = false) {
          // First, ensure the packaging dropdown has the option available
          // If not, we need to add it or load it from the database
          let option = $("#packingPackage option").filter(function() {
            return $(this).val() === packagingId;
          });

          if (option.length > 0) {
            // Option exists, select it
            $("#packingPackage").val(packagingId).trigger("change");

            if (!autoSelect) {
              toastr["success"](`Selected: ${packagingCode} (AI Score: ${score})`);
              // Hide recommendations panel only if manually selected
              $("#aiRecommendationsPanel").addClass("d-none");
            } else {
              // Auto-selected, show a subtle info message
              console.log(`Auto-selected: ${packagingCode} (AI Score: ${score})`);
            }
          } else {
            // Option not found in current list, need to load all packages or search for it
            console.warn(`Packaging ${packagingId} not found in dropdown, attempting to reload packages...`);

            // Reload packaging options from packaging master and try again
            $.ajax({
              url: `/api/master/packaging`,
              method: "GET",
              dataType: "json",
              success: (response) => {
                // Rebuild the packaging dropdown with fresh data
                rebuildPackagingDropdown(response.data?.rows || []);

                // Try selecting again
                const retryOption = $("#packingPackage option").filter(function() {
                  return $(this).val() === packagingId;
                });

                if (retryOption.length > 0) {
                  $("#packingPackage").val(packagingId).trigger("change");
                  if (!autoSelect) {
                    toastr["success"](`Selected: ${packagingCode} (AI Score: ${score})`);
                  }
                } else {
                  toastr["warning"](`Container ${packagingCode} not available in dropdown`);
                }
              },
              error: () => {
                toastr["error"]("Failed to load packaging options");
              }
            });
          }
        }

        function rebuildPackagingDropdown(packagingData) {
          // Transform packaging master data to select2 format
          const options = packagingData.map(pkg => ({
            id: pkg.id,
            text: pkg.packaging_code || pkg.packaging_name || 'Unknown'
          }));

          // Clear and rebuild the select
          $("#packingPackage").empty();
          options.forEach(opt => {
            $("#packingPackage").append(
              $('<option></option>').attr('value', opt.id).text(opt.text)
            );
          });

          $("#packingPackage").select2({
            placeholder: "Choose a packaging",
            allowClear: true,
            data: options
          });
        }

        function changePercentage(
          main_id,
          circle_id,
          percentage_id,
          hr_id,
          weight_id,
          percent,
          weight,
          isPercentage = true
        ) {
          // Ensure percent is a valid number
          percent = isNaN(percent) ? 0 : Number(percent);
          // Extract numeric value from weight (handles "5200.00 kg", "1 Records", etc.)
          const weightNumeric = parseFloat(weight);
          const weightValue = isNaN(weightNumeric) ? 0 : weightNumeric;

          // Determine display suffix - use '%' if it's a percentage
          const suffix = isPercentage ? '%' : '';

          $(`#${circle_id}`).attr("data-percentage", percent);

          $(`#${percentage_id}`).text(`${percent}${suffix}`);

          $(`.${weight_id}`).text(weight);

          // Get radius of the svg's circle.complete
          const radius = $(`#${circle_id}`).find($("circle.complete")).attr("r");
          // Get circumference (2πr)
          const circumference = 2 * Math.PI * radius;
          // Get stroke-dashoffset value for radial circle fill
          // Use the percent value directly for filling the circle (0-100)
          const strokeDashOffset = circumference - (percent * circumference) / 100;
          // Transition progress for 1.25 seconds
          $(`#${circle_id}`)
            .find($("circle.complete"))
            .animate({ "stroke-dashoffset": strokeDashOffset }, 1250);

          $(`#${percentage_id}`)
            .prop("Counter", 0)
            .animate(
              {
                Counter: percent,
              },
              {
                duration: 2000,
                easing: "swing",
                step: function (now) {
                  const displayValue = Number(Math.ceil(parseFloat(now))).toLocaleString("en");
                  $(`#${percentage_id}`).text(`${displayValue}${suffix}`);
                },
              }
            );

          $(`.${weight_id}`)
            .prop("Counter", 0)
            .animate(
              {
                Counter: weightValue,
              },
              {
                duration: 2000,
                easing: "swing",
                step: function (now) {
                  now = Number(Math.ceil(parseFloat(now))).toLocaleString("en");
                  $(`.${weight_id}`).text(`${now}`);
                },
              }
            );

          if (percent > 0) {
            $(`#${hr_id}`).css({ opacity: "0.8" });

            // For percentages: color green at 100%. For counts: color green if any records passed
            const shouldBeGreen = isPercentage ? (percent == 100) : (percent > 0);

            if (shouldBeGreen) {
              $(`.${main_id}`)
                .find($("circle.complete"))
                .css({ stroke: "green" });
              $(`.${main_id}`).find("text").css({ fill: "green" });
              $(`.${main_id}`).find(".heading").css({ color: "green" });
              $(`.${main_id}`).find(".weight").css({ color: "green" });
            } else {
              if ($(`.${main_id}`).hasClass("topMenu-item-active")) {
                $(`.${main_id}`)
                  .find($("circle.complete"))
                  .css({ stroke: "#1f2d3e" });
                $(`.${main_id}`).find("text").css({ fill: "#1f2d3e" });
              } else {
                $(`.${main_id}`)
                  .find($("circle.complete"))
                  .css({ stroke: "#1f2d3e" });
                $(`.${main_id}`).find("text").css({ fill: "#1f2d3e" });
              }
            }
          } else {
            $(`#${hr_id}`).css({ opacity: "0.2" });
          }
        }

        // Load specific order for production processing
        async function loadOrderForProduction(orderId) {
          try {
            toastr.info('Loading order for production...');

            // Fetch order details
            const response = await fetch(`/api/orders/${orderId}`);
            if (!response.ok) {
              throw new Error('Failed to load order');
            }

            const orderData = await response.json();
            const order = orderData.data;

            // Display order information and perform stock checking
            displayOrderForProduction(order);

            // Perform stock check for the order
            await checkStockForProduction(order);

            // Update order status to IN_PRODUCTION via the tracking pipeline
            console.log('Updating order status to IN_PRODUCTION...');
            const initiateResponse = await fetch(`/api/orders/${orderId}/initiate-production`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({})
            });

            if (initiateResponse.ok) {
              console.log('Order status updated to IN_PRODUCTION');
              toastr.success(`Order ${order.order_no || order.id} production initiated - status updated to IN_PRODUCTION`);
            } else {
              console.warn('Failed to update order status, but order loaded successfully');
              toastr.success(`Order ${order.order_no || order.id} loaded for production`);
            }

          } catch (error) {
            console.error('Error loading order for production:', error);
            toastr.error('Failed to load order for production');
          }
        }

        // Display order information in production interface
        function displayOrderForProduction(order) {
          // You can add order display logic here
          // For now, just log the order details
          console.log('Order loaded for production:', order);

          // Could add order info to a header or dedicated section
          // For example: update page title or add order banner
        }

        // Check stock availability for production
        async function checkStockForProduction(order) {
          try {
            // Prepare products array for stock check
            const orderedProducts = order.OrderProducts.map(product => ({
              product_master_id: product.product_master_id,
              quantity_required_kg: product.quantity
            }));

            // Check stock for all products in the order
            const stockResponse = await fetch('/api/orders/check-stock', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ ordered_products: orderedProducts })
            });

            if (!stockResponse.ok) {
              throw new Error('Stock check request failed');
            }

            const stockData = await stockResponse.json();
            console.log('Stock check results:', stockData);

            // Handle stock availability results
            if (stockData.success) {
              toastr.success('All products have sufficient stock for production');
            } else {
              toastr.warning('Some products have insufficient stock. Check procurement requirements.');
            }

          } catch (error) {
            console.error('Error checking stock for production:', error);
            toastr.error('Failed to check stock availability');
          }
        }

      });


      // Helper function to get Bootstrap badge class based on status
      function getStatusBadgeClass(status) {
        const statusClassMap = {
          'DRAFT': 'bg-secondary',
          'CONFIRMED': 'bg-info',
          'ALLOCATED': 'bg-primary',
          'PENDING_PURCHASE': 'bg-warning',
          'IN_PRODUCTION': 'bg-success',
          'PRODUCTION_COMPLETE': 'bg-success',
          'DISPATCHED': 'bg-info',
          'PEELING_IN_PROGRESS': 'bg-warning',
          'READY_FOR_SHIPMENT': 'bg-success',
          'SHIPPED': 'bg-success',
          'DELIVERED': 'bg-success'
        };
        return statusClassMap[status] || 'bg-secondary';
      }
