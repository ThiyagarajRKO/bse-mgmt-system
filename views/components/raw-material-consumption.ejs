<div class="card mb-4">
  <div class="card-header bg-warning text-dark">
    <h5 class="mb-0">
      <i class="fas fa-arrow-right"></i> Consume Raw Material
    </h5>
  </div>
  <div class="card-body">
    <div id="rawMaterialContainer">
      <div class="alert alert-warning">
        <i class="fas fa-info-circle"></i> Select a production order with PLANNED status
      </div>
    </div>
  </div>
</div>

<script>
// Raw Material Consumption Handler
let currentOrderForRawMaterial = null;
let availableLots = [];

function formatDate(dateStr) {
  if (!dateStr) return 'N/A';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}

function calculateConsumptionSummary() {
  const totalAllocated = availableLots.reduce(
    (sum, lot) => sum + (parseFloat(lot.consume_quantity) || 0),
    0
  );
  
  const required = currentOrderForRawMaterial?.planned_quantity_kg || 0;
  const remaining = required - totalAllocated;
  const totalCost = availableLots.reduce(
    (sum, lot) => sum + ((parseFloat(lot.consume_quantity) || 0) * (lot.cost_per_unit || 0)),
    0
  );

  return { totalAllocated, remaining, totalCost };
}

function updateConsumptionUI() {
  const { totalAllocated, remaining, totalCost } = calculateConsumptionSummary();

  // Update lot inputs
  availableLots.forEach(lot => {
    const input = document.querySelector(`input[data-lot-id="${lot.id}"]`);
    if (input) {
      input.max = lot.available_quantity_kg;
    }
  });

  // Update summary display
  const summaryDiv = document.getElementById('consumptionSummary');
  if (summaryDiv) {
    let statusHtml = '';
    if (remaining > 0.01) {
      statusHtml = `<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> Insufficient allocation: ${remaining.toFixed(2)} kg short</div>`;
    } else if (remaining < -0.01) {
      statusHtml = `<div class="alert alert-info"><i class="fas fa-info-circle"></i> Over-allocation by ${Math.abs(remaining).toFixed(2)} kg</div>`;
    } else {
      statusHtml = `<div class="alert alert-success"><i class="fas fa-check-circle"></i> Perfect allocation: All required material allocated</div>`;
    }

    summaryDiv.innerHTML = `
      <div class="row bg-light p-3 rounded mb-3">
        <div class="col-md-3">
          <small class="text-muted">Total Required</small>
          <p class="fw-bold">${(currentOrderForRawMaterial?.planned_quantity_kg || 0).toFixed(2)} kg</p>
        </div>
        <div class="col-md-3">
          <small class="text-muted">Total Allocated</small>
          <p class="fw-bold text-success">${totalAllocated.toFixed(2)} kg</p>
        </div>
        <div class="col-md-3">
          <small class="text-muted">Remaining</small>
          <p class="fw-bold ${remaining >= 0 ? 'text-success' : 'text-danger'}">${remaining.toFixed(2)} kg</p>
        </div>
        <div class="col-md-3">
          <small class="text-muted">Estimated Cost</small>
          <p class="fw-bold">₹${totalCost.toFixed(2)}</p>
        </div>
      </div>
      ${statusHtml}
    `;
  }
}

async function displayRawMaterialConsumption(productionOrder) {
  currentOrderForRawMaterial = productionOrder;

  if (!productionOrder || productionOrder.status !== 'PLANNED') {
    let html = '<div class="alert alert-info">';
    if (productionOrder) {
      html += `Current status: <strong>${productionOrder.status}</strong><br>Production must be PLANNED to consume raw material`;
    } else {
      html += '<i class="fas fa-info-circle"></i> Select a production order with PLANNED status';
    }
    html += '</div>';
    document.getElementById('rawMaterialContainer').innerHTML = html;
    return;
  }

  // Load available lots
  try {
    const response = await fetch(
      `/api/inventory/stock?species_id=${productionOrder.input_species_id}&status=RAW_INVENTORY&page=1&limit=100`
    );
    if (!response.ok) throw new Error('Failed to fetch lots');
    const result = await response.json();
    
    availableLots = (result.data || []).sort((a, b) => 
      new Date(a.received_date || 0) - new Date(b.received_date || 0)
    );
  } catch (error) {
    console.error('Error loading lots:', error);
    availableLots = [];
  }

  let html = `
    <div class="row mb-3">
      <div class="col-md-6">
        <small class="text-muted">Input Species</small>
        <p class="fw-bold">${productionOrder.input_species_name || 'Unknown'}</p>
      </div>
      <div class="col-md-6">
        <small class="text-muted">Required Quantity</small>
        <p class="fw-bold">${productionOrder.planned_quantity_kg} kg</p>
      </div>
    </div>

    <h6 class="mt-4">Available Lots (Ordered by Receipt Date - FIFO)</h6>
    <div class="table-responsive mb-3">
      <table class="table table-sm table-hover">
        <thead class="table-light">
          <tr>
            <th>Lot ID</th>
            <th>Received</th>
            <th>Supplier</th>
            <th>Available (kg)</th>
            <th>Cost/kg</th>
            <th class="text-center">To Consume (kg)</th>
          </tr>
        </thead>
        <tbody>
  `;

  availableLots.forEach(lot => {
    html += `
      <tr>
        <td>
          <strong>${lot.lot_number || 'LOT-' + lot.id}</strong>
          <br>
          <small class="text-muted">${lot.id}</small>
        </td>
        <td>${formatDate(lot.received_date)}</td>
        <td>${lot.supplier_name || 'N/A'}</td>
        <td>${(lot.available_quantity_kg || 0).toFixed(2)}</td>
        <td>₹${(lot.cost_per_unit || 0).toFixed(2)}</td>
        <td class="text-center">
          <input 
            type="number"
            step="0.01"
            class="form-control form-control-sm"
            min="0"
            max="${lot.available_quantity_kg || 0}"
            data-lot-id="${lot.id}"
            onchange="updateConsumptionUI()"
          >
        </td>
      </tr>
    `;
  });

  html += `
        </tbody>
      </table>
    </div>

    <div id="consumptionSummary"></div>

    <div class="mt-3">
      <button 
        onclick="consumeRawMaterialFlow(${productionOrder.id})"
        class="btn btn-warning"
      >
        <i class="fas fa-check-circle"></i> Consume Raw Material
      </button>
      <button 
        onclick="resetAllocationUI()"
        class="btn btn-secondary ms-2"
      >
        Reset Allocation
      </button>
      <small class="d-block mt-2 text-muted">
        ${availableLots.length} lots available. FIFO order applied.
      </small>
    </div>
  `;

  document.getElementById('rawMaterialContainer').innerHTML = html;
  updateConsumptionUI();
}

function resetAllocationUI() {
  document.querySelectorAll('input[data-lot-id]').forEach(input => {
    input.value = '';
  });
  updateConsumptionUI();
}

async function consumeRawMaterialFlow(orderId) {
  const { totalAllocated, remaining } = calculateConsumptionSummary();

  if (remaining > 0.01) {
    alert('Please allocate all required material first!');
    return;
  }

  const lotAllocations = availableLots
    .map(lot => {
      const quantity = parseFloat(document.querySelector(`input[data-lot-id="${lot.id}"]`).value) || 0;
      return quantity > 0 ? {
        inventory_lot_id: lot.id,
        quantity_kg: quantity,
        cost_per_unit: lot.cost_per_unit || 0
      } : null;
    })
    .filter(x => x);

  if (lotAllocations.length === 0) {
    alert('Please select at least one lot to consume!');
    return;
  }

  try {
    const response = await fetch(`/api/production/${orderId}/consume`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ lot_allocations: lotAllocations })
    });

    if (!response.ok) throw new Error('Failed to consume raw material');
    const result = await response.json();
    
    alert(`Raw material consumed! GL entries: ${result.data.gl_entries_created}`);
    window.dispatchEvent(new CustomEvent('rawMaterialConsumed', { detail: result.data }));
  } catch (error) {
    console.error('Error:', error);
    alert('Error: ' + error.message);
  }
}

// Listen for order selection
window.addEventListener('orderSelected', function(event) {
  if (event.detail && event.detail.id) {
    displayRawMaterialConsumption(event.detail);
  }
});
</script>
