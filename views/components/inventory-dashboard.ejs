<div class="card mb-4">
  <div class="card-header bg-secondary text-white">
    <h5 class="mb-0"><i class="fas fa-boxes"></i> Inventory Dashboard</h5>
  </div>
  <div class="card-body">
    <div class="row mb-4">
      <div class="col-md-3">
        <div class="card bg-light">
          <div class="card-body">
            <small class="text-muted">RAW Inventory</small>
            <p class="card-title fw-bold h4" id="rawInventoryCount">0</p>
            <small class="text-muted">items</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-warning text-white">
          <div class="card-body">
            <small>WIP Inventory</small>
            <p class="card-title fw-bold h4" id="wipInventoryCount">0</p>
            <small class="text-white-50">items</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-success text-white">
          <div class="card-body">
            <small>FG Inventory</small>
            <p class="card-title fw-bold h4" id="fgInventoryCount">0</p>
            <small class="text-white-50">items</small>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-info text-white">
          <div class="card-body">
            <small>Total Inventory</small>
            <p class="card-title fw-bold h4" id="totalInventoryCount">0</p>
            <small class="text-white-50">items</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Filters -->
    <div class="row mb-3">
      <div class="col-md-3">
        <label class="form-label">Warehouse</label>
        <select
          id="warehouseFilter"
          class="form-control"
          onchange="loadInventoryData()"
        >
          <option value="">All Warehouses</option>
          <option value="WH-01">WH-01</option>
          <option value="WH-02">WH-02</option>
          <option value="WH-03">WH-03</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <select
          id="statusFilter"
          class="form-control"
          onchange="loadInventoryData()"
        >
          <option value="">All Status</option>
          <option value="RAW_INVENTORY">RAW Inventory</option>
          <option value="WIP_RAW_CONSUMPTION">WIP Consumption</option>
          <option value="FG_INVENTORY">FG Inventory</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Order</label>
        <select
          id="orderFilter"
          class="form-control"
          onchange="loadInventoryData()"
        >
          <option value="">All Orders</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Product</label>
        <select
          id="productFilter"
          class="form-control"
          onchange="loadInventoryData()"
        >
          <option value="">All Products</option>
        </select>
      </div>
    </div>
    <div class="row mb-3">
      <div class="col-md-12">
        <button class="btn btn-primary" onclick="loadInventoryData()">
          <i class="fas fa-sync"></i> Refresh
        </button>
        <button class="btn btn-secondary ms-2" onclick="clearFilters()">
          <i class="fas fa-times"></i> Clear Filters
        </button>
      </div>
    </div>

    <!-- Inventory Table -->
    <div class="table-responsive">
      <table class="table table-sm table-hover">
        <thead class="table-light">
          <tr>
            <th>Lot ID</th>
            <th>Product</th>
            <th>Status</th>
            <th>Warehouse</th>
            <th class="text-end">Quantity (kg)</th>
            <th class="text-end">Cost/Unit</th>
            <th class="text-end">Total Cost</th>
            <th>Received</th>
          </tr>
        </thead>
        <tbody id="inventoryTableBody">
          <tr>
            <td colspan="8" class="text-center text-muted">
              <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
              Loading inventory...
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <nav id="paginationContainer"></nav>
  </div>
</div>

<script>
  // Inventory Dashboard Handler
  let currentPage = 1;
  let totalPages = 1;
  let inventoryData = [];

  async function loadInventorySummary() {
    try {
      const response = await fetch("/api/inventory/stock/summary");
      if (!response.ok) throw new Error("Failed to fetch summary");
      const result = await response.json();

      document.getElementById("rawInventoryCount").textContent =
        result.data.raw_inventory || 0;
      document.getElementById("wipInventoryCount").textContent =
        result.data.wip_inventory || 0;
      document.getElementById("fgInventoryCount").textContent =
        result.data.fg_inventory || 0;
      document.getElementById("totalInventoryCount").textContent =
        result.data.total || 0;
    } catch (error) {
      console.error("Error loading summary:", error);
    }
  }

  async function loadInventoryData(page = 1) {
    currentPage = page;

    const warehouse = document.getElementById("warehouseFilter")?.value || "";
    const status = document.getElementById("statusFilter")?.value || "";
    const orderId = document.getElementById("orderFilter")?.value || "";
    const productId = document.getElementById("productFilter")?.value || "";

    const params = new URLSearchParams({
      page: currentPage,
      limit: 20,
      ...(warehouse && { warehouse }),
      ...(status && { status }),
      ...(orderId && { order_id: orderId }),
      ...(productId && { product_id: productId }),
    });

    try {
      const response = await fetch(`/api/inventory/stock?${params}`);
      if (!response.ok) throw new Error("Failed to fetch inventory");
      const result = await response.json();

      inventoryData = result.data || [];
      totalPages = result.pages || 1;

      displayInventoryTable();
      displayPagination();
      loadInventorySummary();
    } catch (error) {
      console.error("Error:", error);
      document.getElementById("inventoryTableBody").innerHTML = `
      <tr>
        <td colspan="8" class="text-center text-danger">
          <i class="fas fa-exclamation-circle"></i> Error loading inventory: ${error.message}
        </td>
      </tr>
    `;
    }
  }

  async function loadFilterOptions() {
    try {
      // Load orders
      const ordersResponse = await fetch("/api/orders?limit=100");
      if (ordersResponse.ok) {
        const ordersResult = await ordersResponse.json();
        const orderSelect = document.getElementById("orderFilter");
        orderSelect.innerHTML = '<option value="">All Orders</option>';

        if (ordersResult.data && ordersResult.data.length > 0) {
          ordersResult.data.forEach(order => {
            const option = document.createElement("option");
            option.value = order.id;
            option.textContent = `${order.order_no} - ${order.customer_name || 'N/A'}`;
            orderSelect.appendChild(option);
          });
        }
      }

      // Load products
      const productsResponse = await fetch("/api/products?limit=200");
      if (productsResponse.ok) {
        const productsResult = await productsResponse.json();
        const productSelect = document.getElementById("productFilter");
        productSelect.innerHTML = '<option value="">All Products</option>';

        if (productsResult.data && productsResult.data.length > 0) {
          productsResult.data.forEach(product => {
            const option = document.createElement("option");
            option.value = product.id;
            option.textContent = product.product_name;
            productSelect.appendChild(option);
          });
        }
      }
    } catch (error) {
      console.error("Error loading filter options:", error);
    }
  }

  function clearFilters() {
    document.getElementById("warehouseFilter").value = "";
    document.getElementById("statusFilter").value = "";
    document.getElementById("orderFilter").value = "";
    document.getElementById("productFilter").value = "";
    loadInventoryData();
  }
    let html = "";

    if (inventoryData.length === 0) {
      html = `
      <tr>
        <td colspan="8" class="text-center text-muted">
          No inventory records found
        </td>
      </tr>
    `;
    } else {
      inventoryData.forEach((item) => {
        const statusBadgeClass =
          item.status === "RAW_INVENTORY"
            ? "bg-light text-dark"
            : item.status === "WIP_RAW_CONSUMPTION"
            ? "bg-warning"
            : "bg-success";

        const totalCost = (item.quantity_kg || 0) * (item.cost_per_unit || 0);
        const receivedDate = item.received_date
          ? new Date(item.received_date).toLocaleDateString()
          : "N/A";

        html += `
        <tr>
          <td>
            <strong>${item.lot_number || "LOT-" + item.id}</strong>
            <br>
            <small class="text-muted">${item.id}</small>
          </td>
          <td>${item.product_name || "Unknown"}</td>
          <td>
            <span class="badge ${statusBadgeClass}">
              ${item.status}
            </span>
          </td>
          <td>${item.warehouse || "N/A"}</td>
          <td class="text-end"><strong>${(item.quantity_kg || 0).toFixed(
            2
          )}</strong></td>
          <td class="text-end">₹${(item.cost_per_unit || 0).toFixed(2)}</td>
          <td class="text-end">₹${totalCost.toFixed(2)}</td>
          <td>${receivedDate}</td>
        </tr>
      `;
      });
    }

    document.getElementById("inventoryTableBody").innerHTML = html;
  }

  function displayPagination() {
    let html = '<ul class="pagination justify-content-center">';

    // Previous button
    html += `
    <li class="page-item ${currentPage === 1 ? "disabled" : ""}">
      <a class="page-link" href="#" onclick="loadInventoryData(${Math.max(
        1,
        currentPage - 1
      )})">
        Previous
      </a>
    </li>
  `;

    // Page numbers
    for (let i = 1; i <= Math.min(totalPages, 5); i++) {
      const adjustedPage = i + (currentPage - 3);
      if (adjustedPage > 0 && adjustedPage <= totalPages) {
        html += `
        <li class="page-item ${adjustedPage === currentPage ? "active" : ""}">
          <a class="page-link" href="#" onclick="loadInventoryData(${adjustedPage})">
            ${adjustedPage}
          </a>
        </li>
      `;
      }
    }

    // Next button
    html += `
    <li class="page-item ${currentPage >= totalPages ? "disabled" : ""}">
      <a class="page-link" href="#" onclick="loadInventoryData(${Math.min(
        totalPages,
        currentPage + 1
      )})">
        Next
      </a>
    </li>
  `;

    html += "</ul>";
    document.getElementById("paginationContainer").innerHTML = html;
  }

  // Initialize on page load
  document.addEventListener("DOMContentLoaded", function () {
    loadFilterOptions();
    loadInventorySummary();
    loadInventoryData(1);

    // Refresh every 30 seconds
    setInterval(() => {
      loadInventorySummary();
    }, 30000);
  });
</script>
