  </div>

    <!-- Product Appearance -->
    <div style="margin-bottom: 1.5rem;">
      <div style="font-size: 13px; font-weight: 600; color: #e3e3e3; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
        <i class="fas fa-image" style="color: #fd3939; font-size: 12px;"></i>
        Appearance
      </div>
      <div class="postpack-checklist-wrapper">
        <div class="postpack-checklist-item">
          <input type="checkbox" class="form-check-input" id="productAppearance" />
          <label for="productAppearance">Good color, no freezer burn</label>
        </div>
      </div>
    </div>

    <!-- Foreign Matter Check -->
    <div style="margin-bottom: 1.5rem;">
      <div style="font-size: 13px; font-weight: 600; color: #e3e3e3; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
        <i class="fas fa-ban" style="color: #fd3939; font-size: 12px;"></i>
        Foreign Matter
      </div>
      <div class="postpack-checklist-wrapper">
        <div class="postpack-checklist-item">
          <input type="checkbox" class="form-check-input" id="foreignMatter" />
          <label for="foreignMatter">None found</label>
        </div>
      </div>
    </div>

    <!-- Traceability Verification -->
    <div style="margin-bottom: 1.5rem;">
      <div style="font-size: 13px; font-weight: 600; color: #e3e3e3; margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
        <i class="fas fa-barcode" style="color: #fd3939; font-size: 12px;"></i>
        Traceability
      </div>
      <div class="postpack-checklist-wrapper">
        <div class="postpack-checklist-item">
          <input type="checkbox" class="form-check-input" id="traceabilityVerified" />
          <label for="traceabilityVerified">Verified</label>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden input for QA Status -->
  <input type="hidden" id="qaStatus" value="" />

  <!-- ===== ACTION BUTTONS ===== -->
  <div class="postpack-button-group" style="margin-bottom: 0;">
    <button
      type="button"
      class="btn btn-danger"
      onclick="submitPostPackQA()"
      style="flex: 1;"
    >
      <i class="fas fa-save"></i> Save
    </button>
    <button
      type="button"
      class="btn btn-outline-secondary"
      onclick="cancelPostPackQA()"
      style="flex: 1;"
    >
      <i class="fas fa-times"></i> Cancel
    </button>
  </div>
</div>

<script>
  let currentPackingData = null;
  let postPackQAData = {
    packing_id: null,
    order_id: null,
    qa_status: "",
    seal_integrity: false,
    vacuum_proper: false,
    tray_damage: true, // Default true means no damage
    carton_condition: false,
    ice_buildup_acceptable: false,
    label_correct: false,
    sample_size: null,
    net_weight_avg: null,
    net_weight_compliant: false,
    glazing_pct: null,
    glazing_compliant: false,
    product_appearance_pass: false,
    foreign_matter_found: false, // Default false means no foreign matter
    temperature_core: null,
    temperature_compliant: false,
    carton_weight_expected: null,
    carton_weight_actual: null,
    carton_weight_compliant: false,
    traceability_verified: false,
    inspected_by: null,
    inspected_at: null,
  };

  window.loadPackingRecords = function () {
    console.log("Loading packing records...");
    fetch("/api/packing?limit=100&offset=0&sort=created_at,DESC")
      .then((res) => {
        console.log("Packing API response status:", res.status);
        return res.json();
      })
      .then((data) => {
        console.log("Packing API data:", data);
        const records =
          data && data.data && data.data.rows ? data.data.rows : [];
        if (Array.isArray(records) && records.length > 0) {
          console.log("Records found:", records.length);
          const orderNoSelect = document.getElementById("orderNo");
          orderNoSelect.innerHTML =
            '<option value="">-- Select Order --</option>';

          records.forEach((record, index) => {
            // Get order_no from packing record directly
            const orderNo = record.order_no || "N/A";

            // Get order_id (UUID) from packing record
            const orderId = record.order_id || "N/A";

            // Get lot_no from packing record directly
            const lotNo = record.lot_no || "N/A";

            // Get product name from nested relationship - pp is an object, not array
            let productName = "N/A";
            if (
              record.pd &&
              record.pd.pp &&
              record.pd.pp.ProductMaster &&
              record.pd.pp.ProductMaster.product_name
            ) {
              productName = record.pd.pp.ProductMaster.product_name;
            }

            console.log(
              `Record ${index} - OrderNo: "${orderNo}", OrderId: "${orderId}", Lot: "${lotNo}", Product: "${productName}"`,
            );

            const option = document.createElement("option");
            option.value = record.id;
            option.textContent = orderNo;
            option.dataset.orderNo = orderNo;
            option.dataset.orderId = orderId;
            option.dataset.lotNo = lotNo;
            option.dataset.productName = productName;
            option.dataset.recordId = record.id;
            orderNoSelect.appendChild(option);
          });
          console.log(
            "✅ Dropdown populated with",
            orderNoSelect.options.length - 1,
            "records",
          );
        } else {
          console.warn("No records found in response:", data);
        }
      })
      .catch((err) => console.error("Error loading packing records:", err));
  };

  window.onOrderNoChange = function () {
    const orderNoSelect = document.getElementById("orderNo");
    const selectedOption = orderNoSelect.options[orderNoSelect.selectedIndex];

    if (selectedOption.value) {
      const orderNo =
        selectedOption.dataset.orderNo || selectedOption.textContent || "N/A";
      const orderId = selectedOption.dataset.orderId || "N/A";
      const lotNo = selectedOption.dataset.lotNo || "N/A";
      const productName = selectedOption.dataset.productName || "N/A";
      const recordId = selectedOption.dataset.recordId || selectedOption.value;

      console.log(
        "Selected Order:",
        orderNo,
        "OrderId:",
        orderId,
        "Lot No:",
        lotNo,
        "Product:",
        productName,
      );

      // Update Lot No dropdown with lot number
      const lotNoSelect = document.getElementById("lotNo");
      lotNoSelect.innerHTML = `<option value="${lotNo}">${lotNo}</option>`;

      // Update Product Name dropdown
      const productSelect = document.getElementById("productName");
      productSelect.innerHTML = `<option value="${productName}">${productName}</option>`;

      // Update postPackQAData with correct UUID for order_id
      postPackQAData.packing_id = recordId;
      postPackQAData.order_id = orderId;
      currentPackingData = {
        id: recordId,
        order_id: orderId,
        order_no: orderNo,
        lot_no: lotNo,
        product_name: productName,
      };

      console.log("Updated currentPackingData:", currentPackingData);
      console.log("🎯 Order No from Procurement:", orderNo);
      console.log("🎯 Order ID (UUID):", orderId);
      console.log("🎯 Lot No from Procurement:", lotNo);

      // Load existing QA if available
      window.fetchPostPackQA(recordId);
    } else {
      document.getElementById("lotNo").innerHTML =
        '<option value="">-- Select Lot --</option>';
      document.getElementById("productName").innerHTML =
        '<option value="">-- Select Product --</option>';
    }
  };

  window.onLotNoChange = function () {
    // Lot No is auto-populated, no change needed
  };

  window.loadPostPackQATab = function (packingData) {
    currentPackingData = packingData;
    postPackQAData.packing_id = packingData.id;
    postPackQAData.order_id = packingData.order_id;

    // Load packing records into dropdown
    window.loadPackingRecords();

    // Select the current packing record in the dropdown
    setTimeout(function () {
      const orderNoSelect = document.getElementById("orderNo");
      for (let i = 0; i < orderNoSelect.options.length; i++) {
        if (orderNoSelect.options[i].value === packingData.id.toString()) {
          orderNoSelect.selectedIndex = i;
          window.onOrderNoChange();
          break;
        }
      }
    }, 100);

    // Load existing QA if available
    window.fetchPostPackQA(packingData.id);

    document.getElementById("postPackQAContainer").style.display = "block";

    // Initialize Bootstrap tooltips
    setTimeout(function () {
      var tooltipElements = document.querySelectorAll(
        '[data-bs-toggle="tooltip"]',
      );
      tooltipElements.forEach(function (el) {
        new bootstrap.Tooltip(el);
      });
    }, 100);
  };

  window.fetchPostPackQA = function (packingId) {
    fetch(`/api/postpack-qa/by-packing/${packingId}`)
      .then((res) => res.json())
      .then((data) => {
        if (data.status && data.data) {
          window.populatePostPackQAForm(data.data);
        }
      })
      .catch((err) => console.error("Error fetching Final QA:", err));
  };

  window.populatePostPackQAForm = function (qa) {
    // Populate checkboxes
    if (qa.seal_integrity !== null)
      document.getElementById("sealIntegrity").checked = qa.seal_integrity;
    if (qa.vacuum_proper !== null)
      document.getElementById("vacuumProper").checked = qa.vacuum_proper;
    if (qa.tray_damage !== null)
      document.getElementById("trayDamage").checked = !qa.tray_damage;
    if (qa.carton_condition !== null)
      document.getElementById("cartonCondition").checked = qa.carton_condition;
    if (qa.ice_buildup_acceptable !== null)
      document.getElementById("iceBuildup").checked = qa.ice_buildup_acceptable;
    if (qa.label_correct !== null)
      document.getElementById("labelCorrect").checked = qa.label_correct;
    if (qa.net_weight_compliant !== null)
      document.getElementById("netWeightCompliant").checked =
        qa.net_weight_compliant;
    if (qa.glazing_compliant !== null)
      document.getElementById("glazingCompliant").checked =
        qa.glazing_compliant;
    if (qa.product_appearance_pass !== null)
      document.getElementById("productAppearance").checked =
        qa.product_appearance_pass;
    if (qa.foreign_matter_found !== null)
      document.getElementById("foreignMatter").checked =
        !qa.foreign_matter_found;
    if (qa.temperature_compliant !== null)
      document.getElementById("temperatureCompliant").checked =
        qa.temperature_compliant;
    if (qa.carton_weight_compliant !== null)
      document.getElementById("cartonWeightCompliant").checked =
        qa.carton_weight_compliant;
    if (qa.traceability_verified !== null)
      document.getElementById("traceabilityVerified").checked =
        qa.traceability_verified;

    // Populate measurements
    if (qa.sample_size)
      document.getElementById("sampleSize").value = qa.sample_size;
    if (qa.net_weight_avg)
      document.getElementById("netWeightAvg").value = qa.net_weight_avg;
    if (qa.glazing_pct)
      document.getElementById("glazingPct").value = qa.glazing_pct;
    if (qa.temperature_core)
      document.getElementById("temperatureCore").value = qa.temperature_core;
    if (qa.carton_weight_expected)
      document.getElementById("cartonWeightExpected").value =
        qa.carton_weight_expected;
    if (qa.carton_weight_actual)
      document.getElementById("cartonWeightActual").value =
        qa.carton_weight_actual;

    // Set QA status
    if (qa.qa_status) {
      window.setQAStatus(qa.qa_status);
    }

    // Set remarks
    if (qa.qa_decision_remarks)
      document.getElementById("qaRemarks").value = qa.qa_decision_remarks;

    window.updateComplianceScore();
  };

  window.setQAStatus = function (status) {
    postPackQAData.qa_status = status;
    document.getElementById("qaStatus").value = status;

    const statusBadge = document.getElementById("postPackQAStatus");
    const inventoryBadge = document.getElementById("inventoryStatusBadge");

    // Update UI - with null checks
    if (statusBadge)
      statusBadge.className = "inspection-status-badge " + status.toLowerCase();

    let inventoryStatus = "PENDING";
    if (status === "PASS") inventoryStatus = "SALEABLE";
    else if (status === "HOLD") inventoryStatus = "BLOCKED";
    else if (status === "FAIL") inventoryStatus = "REWORK";

    postPackQAData.inventory_status = inventoryStatus;
    if (inventoryBadge) {
      inventoryBadge.textContent = inventoryStatus;
      inventoryBadge.className =
        "inspection-status-badge " + status.toLowerCase();
    }

    window.updateComplianceScore();
  };

  window.updateComplianceScore = function () {
    const checks = {
      seal_integrity: document.getElementById("sealIntegrity").checked,
      vacuum_proper: document.getElementById("vacuumProper").checked,
      tray_damage: !document.getElementById("trayDamage").checked,
      carton_condition: document.getElementById("cartonCondition").checked,
      ice_buildup: document.getElementById("iceBuildup").checked,
      label_correct: document.getElementById("labelCorrect").checked,
      net_weight_compliant:
        document.getElementById("netWeightCompliant").checked,
      glazing_compliant: document.getElementById("glazingCompliant").checked,
      product_appearance: document.getElementById("productAppearance").checked,
      foreign_matter: !document.getElementById("foreignMatter").checked,
      temperature_compliant: document.getElementById("temperatureCompliant")
        .checked,
      carton_weight_compliant: document.getElementById("cartonWeightCompliant")
        .checked,
      traceability_verified: document.getElementById("traceabilityVerified")
        .checked,
    };

    const totalChecks = Object.keys(checks).length;
    const passedChecks = Object.values(checks).filter((v) => v === true).length;
    const compliancePercentage = Math.round((passedChecks / totalChecks) * 100);

    document.getElementById("compliancePercentage").textContent =
      compliancePercentage + "%";
    document.getElementById("checksPassedCount").textContent = passedChecks;
    document.getElementById("checksTotalCount").textContent = totalChecks;

    const complianceScore = document.getElementById("complianceScore");
    if (compliancePercentage >= 80) {
      complianceScore.className = "compliance-score high";
      document.getElementById("complianceStatus").textContent =
        "High Compliance";
    } else if (compliancePercentage >= 60) {
      complianceScore.className = "compliance-score medium";
      document.getElementById("complianceStatus").textContent =
        "Medium Compliance";
    } else {
      complianceScore.className = "compliance-score low";
      document.getElementById("complianceStatus").textContent =
        "Low Compliance";
    }
  };

  window.submitPostPackQA = function () {
    // Update data from form
    postPackQAData.seal_integrity =
      document.getElementById("sealIntegrity").checked;
    postPackQAData.vacuum_proper =
      document.getElementById("vacuumProper").checked;
    postPackQAData.tray_damage = !document.getElementById("trayDamage").checked;
    postPackQAData.carton_condition =
      document.getElementById("cartonCondition").checked;
    postPackQAData.ice_buildup_acceptable =
      document.getElementById("iceBuildup").checked;
    postPackQAData.label_correct =
      document.getElementById("labelCorrect").checked;
    postPackQAData.sample_size =
      parseInt(document.getElementById("sampleSize").value) || null;
    postPackQAData.net_weight_avg =
      parseFloat(document.getElementById("netWeightAvg").value) || null;
    postPackQAData.net_weight_compliant =
      document.getElementById("netWeightCompliant").checked;
    postPackQAData.glazing_pct =
      parseFloat(document.getElementById("glazingPct").value) || null;
    postPackQAData.glazing_compliant =
      document.getElementById("glazingCompliant").checked;
    postPackQAData.product_appearance_pass =
      document.getElementById("productAppearance").checked;
    postPackQAData.foreign_matter_found =
      !document.getElementById("foreignMatter").checked;
    postPackQAData.temperature_core =
      parseFloat(document.getElementById("temperatureCore").value) || null;
    postPackQAData.temperature_compliant = document.getElementById(
      "temperatureCompliant",
    ).checked;
    postPackQAData.carton_weight_expected =
      parseFloat(document.getElementById("cartonWeightExpected").value) || null;
    postPackQAData.carton_weight_actual =
      parseFloat(document.getElementById("cartonWeightActual").value) || null;
    postPackQAData.carton_weight_compliant = document.getElementById(
      "cartonWeightCompliant",
    ).checked;
    postPackQAData.traceability_verified = document.getElementById(
      "traceabilityVerified",
    ).checked;
    postPackQAData.qa_decision_remarks =
      document.getElementById("qaRemarks").value;

    if (!postPackQAData.qa_status) {
      alert("Please select a QA decision (PASS, HOLD, or FAIL)");
      return;
    }

    console.log("Submitting Final QA:", postPackQAData);

    fetch("/api/postpack-qa/create", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(postPackQAData),
    })
      .then((res) => res.json())
      .then((data) => {
        if (data.status) {
          toastr.success("Final QA inspection submitted successfully");
          window.fetchPostPackQA(postPackQAData.packing_id);
        } else {
          toastr.error("Error submitting QA: " + data.message);
        }
      })
      .catch((err) => {
        console.error("Error:", err);
        toastr.error("Error submitting Final QA");
      });
  };

  window.cancelPostPackQA = function () {
    if (confirm("Cancel Final QA inspection?")) {
      document.getElementById("postPackQAContainer").style.display = "none";
    }
  };

  // Add event listeners to update compliance on checkbox changes
  document.addEventListener("change", function (e) {
    if (e.target.classList.contains("form-check-input")) {
      window.updateComplianceScore();
    }
  });

  // Sub-tabs switching functionality
  document.addEventListener("click", function (e) {
    if (e.target.classList.contains("qa-sub-tab-btn")) {
      const tabName = e.target.getAttribute("data-tab");

      // Hide all tab contents
      document.querySelectorAll(".qa-sub-tab-content").forEach((tab) => {
        tab.classList.remove("active");
      });

      // Remove active class from all buttons
      document.querySelectorAll(".qa-sub-tab-btn").forEach((btn) => {
        btn.classList.remove("active");
      });

      // Show selected tab and mark button as active
      document.getElementById(tabName).classList.add("active");
      e.target.classList.add("active");
    }
  });
</script>
