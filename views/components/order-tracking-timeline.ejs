<!-- Order Tracking Timeline Component -->
<!-- Displays order status as a vertical timeline with stages and substages -->

<div
  id="orderTrackingTimeline"
  style="display: block; padding: 0; overflow: visible"
>
  <!-- Timeline Container -->
  <div
    class="order-tracking-timeline"
    style="
      position: relative;
      padding: 10px 0 0 40px;
      padding-right: 0 !important;
      margin-bottom: 0;
    "
  >
    <!-- Order Received/Draft Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="draft-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
        "
      >
        <span style="font-size: 8px; font-weight: bold; color: white">●</span>
      </div>
      <div
        class="draft-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 50px;
          background-color: #dee2e6;
        "
      ></div>
      <h6 class="mb-0"><strong>○ Order Received</strong></h6>
      <div style="margin-top: 8px">
        <small class="text-muted">Order created and in draft status</small>
      </div>
    </div>

    <!-- Order Confirmed Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="confirmed-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
        "
      >
        <span style="font-size: 8px; font-weight: bold; color: white">●</span>
      </div>
      <div
        class="confirmed-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 50px;
          background-color: #dee2e6;
        "
      ></div>
      <h6 class="mb-0"><strong>○ Order Confirmed</strong></h6>
      <div style="margin-top: 8px">
        <small class="text-muted"
          >Order confirmed and ready for allocation</small
        >
      </div>
    </div>

    <!-- Allocation Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="allocation-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
        "
      >
        <span style="font-size: 8px; font-weight: bold; color: white">●</span>
      </div>
      <div
        class="allocated-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 50px;
          background-color: #dee2e6;
        "
      ></div>
      <h6 class="mb-0"><strong>○ Allocation</strong></h6>
      <div style="margin-top: 8px">
        <small class="text-muted">Stock allocated for order fulfillment</small>
      </div>
    </div>

    <!-- Production Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="production-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
          animation: none;
        "
      >
        <span style="font-size: 8px; font-weight: bold; color: white">●</span>
      </div>
      <div
        class="production-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 80px;
          background-color: #dee2e6;
        "
      ></div>

      <h6 class="mb-2"><strong>○ Production</strong></h6>

      <div style="margin-bottom: 8px">
        <div class="progress" style="height: 16px; background-color: #f0f0f0">
          <div
            class="progress-bar"
            id="prodBar"
            style="
              width: 0%;
              background-color: #cccccc;
              display: flex;
              align-items: center;
              justify-content: center;
            "
          >
            <small style="font-size: 12px; color: #4f4f4f; font-weight: 500"
              >Waiting for production</small
            >
          </div>
        </div>
      </div>
    </div>

    <!-- QA Approved Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="qa-approved-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
          border: 2px solid white;
          box-shadow: 0 0 0 1px #dee2e6;
        "
      >
        <span style="font-size: 8px; color: white">●</span>
      </div>
      <div
        class="qa-approved-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 50px;
          background-color: #dee2e6;
        "
      ></div>

      <h6 class="mb-0"><strong>○ QA Approved</strong></h6>
      <div style="margin-top: 8px">
        <small class="text-muted"
          >Quality check passed, ready for packing</small
        >
      </div>
    </div>

    <!-- Packed Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="packed-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
          border: 2px solid white;
          box-shadow: 0 0 0 1px #dee2e6;
        "
      >
        <span style="font-size: 8px; color: white">●</span>
      </div>
      <div
        class="packed-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 50px;
          background-color: #dee2e6;
        "
      ></div>

      <h6 class="mb-0"><strong>○ Packed</strong></h6>
      <div style="margin-top: 8px">
        <small class="text-muted">Products packed and ready for dispatch</small>
      </div>
    </div>

    <!-- Dispatched Stage -->
    <div class="timeline-item" style="margin-bottom: 20px; position: relative">
      <div
        class="dispatch-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: #cccccc;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
          border: 2px solid white;
          box-shadow: 0 0 0 1px #dee2e6;
        "
      >
        <span style="font-size: 8px; color: white">●</span>
      </div>
      <div
        class="dispatch-connector"
        style="
          position: absolute;
          left: -20px;
          top: 22px;
          width: 2px;
          height: 50px;
          background-color: #dee2e6;
        "
      ></div>

      <h6 class="mb-2"><strong>○ Dispatched</strong></h6>

      <div style="margin-bottom: 8px">
        <div class="progress" style="height: 16px; background-color: #f0f0f0">
          <div
            class="progress-bar"
            id="dispatchBar"
            style="
              width: 0%;
              background-color: #cccccc;
              display: flex;
              align-items: center;
              justify-content: center;
            "
          >
            <small style="font-size: 12px; color: #4f4f4f; font-weight: 500"
              >Waiting for dispatch</small
            >
          </div>
        </div>
      </div>
    </div>

    <!-- Invoiced Stage -->
    <div
      class="timeline-item"
      style="position: relative; margin-bottom: 0; padding-bottom: 0"
    >
      <div
        class="invoice-dot"
        style="
          position: absolute;
          left: -30px;
          top: 0;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          background-color: white;
          border: 2px solid #dee2e6;
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 10;
        "
      >
        <span style="font-size: 8px; color: #dee2e6">●</span>
      </div>

      <h6 class="mb-0" style="margin-bottom: 0 !important">
        <strong>○ Invoiced</strong>
      </h6>
      <div style="margin-top: 8px">
        <small class="text-muted">Order invoiced and completed</small>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes pulse-animation {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 159, 67, 0.7);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(255, 159, 67, 0);
    }
  }

  .timeline-item {
    padding: 0 0 0 0;
  }

  .timeline-item:last-child {
    margin-bottom: 0 !important;
  }

  .timeline-item:last-child h6 {
    margin-bottom: 0 !important;
  }

  .order-tracking-timeline h6 {
    font-family: "Lato-Regular", sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #4f4f4f;
    margin-bottom: 0.5rem;
  }

  .progress {
    height: 16px;
  }

  .progress-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 500;
  }
</style>

<script>
  let trackingRefreshInterval = null;
  let currentOrderId = null;

  /**
   * Update timeline with actual production data
   */
  window.updateOrderTrackingTimeline = function (trackingData) {
    console.log("🔄 updateOrderTrackingTimeline called with:", trackingData);
    if (!trackingData) {
      console.log("❌ No tracking data provided");
      return;
    }

    const {
      order,
      production_tracking,
      sales_tracking,
      status_timeline,
      current_progress,
    } = trackingData;
    console.log("📊 Order:", order);
    console.log("🏭 Production tracking:", production_tracking);
    console.log("📊 Current progress:", current_progress);
    console.log("📅 Status timeline:", status_timeline);

    // Calculate total ordered quantity from order products
    const totalOrderedQuantity =
      order?.OrderProducts?.reduce(
        (sum, product) => sum + (product.quantity || 0),
        0,
      ) || 0;

    // Get order status and status timeline
    const orderStatus = order?.order_status || "ORDER_RECEIVED";
    console.log("📋 Order status:", orderStatus);

    // Process status timeline to determine completed stages
    const completedStatuses = new Set();
    if (status_timeline && Array.isArray(status_timeline)) {
      status_timeline.forEach((log) => {
        if (log.to_status) {
          completedStatuses.add(log.to_status);
        }
      });
    }
    console.log(
      "✅ Completed statuses from timeline:",
      Array.from(completedStatuses),
    );

    // Map order statuses to timeline stage indices
    const statusToStageIndex = {
      DRAFT: 0,
      ORDER_RECEIVED: 0,
      CONFIRMED: 1,
      ALLOCATED: 2,
      IN_PRODUCTION: 3,
      PRODUCTION_COMPLETE: 3,
      PEELING_IN_PROGRESS: 3,
      READY_FOR_QA: 4,
      QA_APPROVED: 4,
      PACKED: 5,
      READY_FOR_DISPATCH: 6,
      DISPATCHED: 6,
      READY_FOR_SHIPMENT: 6,
      SHIPPED: 6,
      INVOICED: 7,
      DELIVERED: 8,
      CLOSED: 8,
    };

    // Determine current stage index based on completed statuses
    let currentStageIndex = 0;
    let maxCompletedIndex = -1;

    // Find the highest completed stage
    completedStatuses.forEach((status) => {
      const stageIndex = statusToStageIndex[status];
      if (stageIndex !== undefined && stageIndex > maxCompletedIndex) {
        maxCompletedIndex = stageIndex;
      }
    });

    // Current stage is the next one after the last completed, or the last completed if it's the current status
    if (maxCompletedIndex >= 0) {
      const currentStatusIndex = statusToStageIndex[orderStatus];
      if (
        currentStatusIndex !== undefined &&
        currentStatusIndex > maxCompletedIndex
      ) {
        currentStageIndex = currentStatusIndex;
      } else {
        currentStageIndex = maxCompletedIndex;
      }
    } else {
      // Fallback to current order status if no timeline data
      currentStageIndex = statusToStageIndex[orderStatus] || 0;
    }

    console.log("🎯 Current stage index:", currentStageIndex);

    // Update each stage based on order status
    updateTimelineStage(
      "draft-dot",
      "draft-connector",
      currentStageIndex >= 0,
      currentStageIndex === 0,
    );
    updateTimelineStage(
      "confirmed-dot",
      "confirmed-connector",
      currentStageIndex >= 1,
      currentStageIndex === 1,
    );
    updateTimelineStage(
      "allocation-dot",
      "allocated-connector",
      currentStageIndex >= 2,
      currentStageIndex === 2,
    );
    updateTimelineStage(
      "production-dot",
      "production-connector",
      currentStageIndex >= 3,
      currentStageIndex === 3,
    );
    updateTimelineStage(
      "qa-approved-dot",
      "qa-approved-connector",
      currentStageIndex >= 4,
      currentStageIndex === 4,
    );
    updateTimelineStage(
      "packed-dot",
      "packed-connector",
      currentStageIndex >= 5,
      currentStageIndex === 5,
    );
    updateTimelineStage(
      "dispatch-dot",
      "dispatch-connector",
      currentStageIndex >= 6,
      currentStageIndex === 6,
    );
    updateTimelineStage(
      "invoice-dot",
      null,
      currentStageIndex >= 7,
      currentStageIndex === 7,
    );

    // Update progress bars for stages that have them
    updateProgressBars(
      order,
      production_tracking,
      currentStageIndex,
      current_progress,
    );

    // Update status message
    updateStatusMessage(orderStatus, currentStageIndex);

    // Update the modal display with the current calculated order status
    // Update the delivery status display in the modal
    const deliveryStatusElement = document.querySelector(
      "#view_delivery_status",
    );
    if (deliveryStatusElement && order?.order_status) {
      console.log(
        "📝 Updating modal status display from:",
        deliveryStatusElement.textContent,
        "to:",
        order.order_status,
      );
      deliveryStatusElement.textContent = order.order_status;
    }

    // Sync order status if needed
    if (currentStageIndex >= 9) {
      syncOrderStatus(order.id, "INVOICED", "completed");
    }
  };

  /**
   * Update a single timeline stage
   */
  function updateTimelineStage(
    dotClass,
    connectorClass,
    isCompleted,
    isCurrent,
  ) {
    const dot = document.querySelector(`.${dotClass}`);
    const connector = connectorClass
      ? document.querySelector(`.${connectorClass}`)
      : null;

    if (!dot) return;

    if (isCompleted) {
      // Completed - black with white checkmark
      dot.style.backgroundColor = "#000000";
      const icon = dot.querySelector("span");
      if (icon) {
        icon.innerHTML = "✓";
        icon.style.color = "white";
        icon.style.fontSize = "10px";
      }
      if (connector) connector.style.backgroundColor = "#000000";
    } else if (isCurrent) {
      // Current - yellow with pulse animation
      dot.style.backgroundColor = "#FF9F43";
      const icon = dot.querySelector("span");
      if (icon) {
        icon.innerHTML = "●";
        icon.style.color = "white";
        icon.style.fontSize = "8px";
      }
      if (connector) connector.style.backgroundColor = "#fd7e14";
      // Add pulse animation
      dot.style.animation = "pulse-animation 2s infinite";
    } else {
      // Pending - gray
      dot.style.backgroundColor = "#cccccc";
      const icon = dot.querySelector("span");
      if (icon) {
        icon.innerHTML = "●";
        icon.style.color = "white";
        icon.style.fontSize = "8px";
      }
      if (connector) connector.style.backgroundColor = "#dee2e6";
      dot.style.animation = "none";
    }
  }

  /**
   * Update progress bars for stages that have them
   */
  function updateProgressBars(
    order,
    production_tracking,
    currentStageIndex,
    current_progress,
  ) {
    // Use current_progress.progress_percentage if available, otherwise calculate
    const progressPercent = current_progress?.progress_percentage || 0;

    console.log("📈 Updating progress bars with:", {
      progressPercent,
      currentStageIndex,
      current_progress,
    });

    // Update production progress bar (includes peeling as part of production)
    if (currentStageIndex >= 3) {
      const prodBar = document.getElementById("prodBar");
      if (prodBar) {
        let productionPercent = 0;
        let statusMessage = "Waiting for production";

        // Check if production is complete (including peeling)
        const stage = current_progress?.current_stage;
        if (
          stage === "PRODUCTION_COMPLETE" ||
          stage === "PACKED" ||
          stage === "READY_FOR_DISPATCH" ||
          stage === "QA_APPROVED" ||
          stage === "DISPATCHED" ||
          stage === "SHIPPED" ||
          stage === "INVOICED" ||
          stage === "DELIVERED"
        ) {
          // Production is complete
          productionPercent = 100;
          statusMessage = "100% - Production complete";
        } else if (stage === "PEELING_IN_PROGRESS") {
          // Peeling is in progress
          productionPercent = 50;
          statusMessage = "50% - Peeling in progress";
        } else if (stage === "IN_PRODUCTION") {
          // Manufacturing is in progress
          productionPercent = production_tracking
            ? calculateProductionProgress(production_tracking, order)
            : progressPercent;
          statusMessage = productionPercent + "% - Manufacturing in progress";
        } else {
          // Use calculated progress from quantities
          productionPercent = production_tracking
            ? calculateProductionProgress(production_tracking, order)
            : progressPercent;
          if (productionPercent > 0) {
            statusMessage = productionPercent + "% complete";
          }
        }

        console.log(
          "🏭 Setting production progress bar to:",
          productionPercent + "%",
        );
        prodBar.style.width = productionPercent + "%";
        prodBar.style.backgroundColor =
          productionPercent > 0 ? "#EA5455" : "#cccccc";
        prodBar.textContent = statusMessage;
      } else {
        console.warn("⚠️ Production progress bar element not found");
      }
    }

    // Update dispatch progress bar
    if (currentStageIndex >= 8) {
      const dispatchBar = document.getElementById("dispatchBar");
      if (dispatchBar) {
        const dispatchPercent = production_tracking
          ? calculateDispatchProgress(production_tracking)
          : progressPercent >= 75
            ? 100
            : 0; // If 75%+ progress, consider dispatch complete

        console.log(
          "📦 Setting dispatch progress bar to:",
          dispatchPercent + "%",
        );
        dispatchBar.style.width = dispatchPercent + "%";
        dispatchBar.style.backgroundColor =
          dispatchPercent > 0 ? "#EA5455" : "#cccccc";
        dispatchBar.textContent =
          dispatchPercent > 0
            ? dispatchPercent + "% dispatched"
            : "Waiting for dispatch";
      } else {
        console.warn("⚠️ Dispatch progress bar element not found");
      }
    }
  }

  /**
   * Calculate production progress percentage
   */
  function calculateProductionProgress(production_tracking, order) {
    if (!production_tracking?.production_orders?.length) return 0;

    const totalOrderedQuantity =
      order?.OrderProducts?.reduce(
        (sum, product) => sum + (product.quantity || 0),
        0,
      ) || 0;

    const totalProducedQuantity = production_tracking.production_orders.reduce(
      (sum, order) => sum + (parseFloat(order.produced_quantity_kg) || 0),
      0,
    );

    return totalOrderedQuantity > 0
      ? Math.min(
          100,
          Math.round((totalProducedQuantity / totalOrderedQuantity) * 100),
        )
      : 0;
  }

  /**
   * Calculate dispatch progress percentage
   */
  function calculateDispatchProgress(production_tracking) {
    if (!production_tracking?.dispatches?.length) return 0;

    const dispatches = production_tracking.dispatches;
    const totalDispatched = dispatches.reduce(
      (sum, dispatch) =>
        sum + (parseFloat(dispatch.dispatched_quantity_kg) || 0),
      0,
    );

    // For simplicity, assume dispatch is complete when any dispatch records exist
    // In a real implementation, this would compare against total ordered quantity
    return totalDispatched > 0 ? 100 : 0;
  }

  /**
   * Update status message based on current stage
   */
  function updateStatusMessage(orderStatus, currentStageIndex) {
    const statusMessage = document.getElementById("trackingStatusMessage");
    if (!statusMessage) return;

    const messages = {
      0: "Order received. Awaiting confirmation.",
      1: "Order confirmed. Preparing for allocation.",
      2: "Allocation in progress. Assigning resources.",
      3: "Production in progress. Tracking updates in real-time.",
      4: "Production completed. Ready for quality check.",
      5: "Quality check passed. Preparing for packing.",
      6: "Packing completed. Ready for dispatch preparation.",
      7: "Order prepared and ready for shipping.",
      8: "Order dispatched. Tracking delivery progress.",
      9: "Order completed and invoiced.",
    };

    statusMessage.textContent =
      messages[currentStageIndex] || "Order status unknown.";
    statusMessage.style.color =
      currentStageIndex >= 9
        ? "#28a745"
        : currentStageIndex >= 3
          ? "#EA5455"
          : "#6c757d";
  }

  /**
   * Start real-time tracking updates
   */
  window.startTrackingRealTimeUpdates = function (orderId) {
    if (!orderId) return;

    currentOrderId = orderId;

    // Clear any existing interval
    if (trackingRefreshInterval) {
      clearInterval(trackingRefreshInterval);
    }

    // Fetch tracking data every 3 seconds for real-time updates
    trackingRefreshInterval = setInterval(function () {
      if (!currentOrderId) return;

      $.ajax({
        url: `/api/orders/${currentOrderId}/tracking`,
        method: "GET",
        dataType: "json",
        success: function (response) {
          if (response.success && response.data) {
            window.updateOrderTrackingTimeline(response.data);
          }
        },
        error: function (err) {
          console.error("Error refreshing tracking:", err);
        },
      });
    }, 3000); // Refresh every 3 seconds
  };

  /**
   * Stop real-time tracking updates
   */
  window.stopTrackingRealTimeUpdates = function () {
    if (trackingRefreshInterval) {
      clearInterval(trackingRefreshInterval);
      trackingRefreshInterval = null;
    }
    currentOrderId = null;
  };

  /**
   * Sync order status with tracking progress
   */
  function syncOrderStatusWithTracking(orderId, trackingState) {
    if (!orderId) return;

    const {
      productionPercent,
      packingPercent,
      qaPercent,
      dispatchPercent,
      hasProductionData,
      isOrderConfirmed,
    } = trackingState;

    let newOrderStatus = "DRAFT";
    let newDeliveryStatus = "Initiated";

    if (!isOrderConfirmed) {
      newOrderStatus = "DRAFT";
      newDeliveryStatus = "Initiated";
    } else if (!hasProductionData) {
      newOrderStatus = "CONFIRMED";
      newDeliveryStatus = "Initiated";
    } else if (productionPercent > 0 && productionPercent < 100) {
      newOrderStatus = "IN_PRODUCTION";
      newDeliveryStatus = "In Transit";
    } else if (productionPercent >= 100 && packingPercent < 100) {
      newOrderStatus = "PACKED";
      newDeliveryStatus = "In Transit";
    } else if (packingPercent >= 100 && qaPercent < 100) {
      newOrderStatus = "READY_FOR_QA";
      newDeliveryStatus = "In Transit";
    } else if (qaPercent >= 100 && dispatchPercent < 100) {
      newOrderStatus = "READY_FOR_DISPATCH";
      newDeliveryStatus = "In Transit";
    } else if (dispatchPercent >= 100) {
      newOrderStatus = "DISPATCHED";
      newDeliveryStatus = "dispatched";
    } else if (
      productionPercent >= 100 &&
      packingPercent >= 100 &&
      qaPercent >= 100 &&
      dispatchPercent >= 100
    ) {
      newOrderStatus = "INVOICED";
      newDeliveryStatus = "Delivered";
    }

    // Update order status via API call
    updateOrderStatus(orderId, newOrderStatus, newDeliveryStatus);
  }

  /**
   * Update order status via API
   */
  function updateOrderStatus(orderId, orderStatus, deliveryStatus) {
    if (!orderId) return;

    $.ajax({
      url: `/api/orders/${orderId}/status`,
      method: "PUT",
      contentType: "application/json",
      data: JSON.stringify({
        order_status: orderStatus,
        delivery_status: deliveryStatus,
      }),
      success: function (response) {
        if (response.success) {
          console.log("✅ Order status updated:", {
            orderStatus,
            deliveryStatus,
          });
        } else {
          console.warn("⚠️ Failed to update order status:", response.message);
        }
      },
      error: function (err) {
        console.error("❌ Error updating order status:", err);
      },
    });
  }

  /**
   * Sync order status (legacy function for backward compatibility)
   */
  function syncOrderStatus(orderId, orderStatus, deliveryStatus) {
    updateOrderStatus(orderId, orderStatus, deliveryStatus);
  }
</script>
