    <!-- ------------------------------------------------------------------------------------------------------------- -->
    <!-- ------------------------------------- Company Container ---------------------------------------------------- -->
    <!-- ------------------------------------------------------------------------------------------------------------- -->
    <div class="menu-container companyContainer d-none">
      <!-- Slide-in Panel -->
      <div id="companySlideInPanel" class="slideInPanel px-4 overflow-auto">
        <div class="row d-flex justify-content-center">
          <div class="col-sm-12 col-md-12 col-md-12">
            <div class="text-center mt-4 d-flex justify-content-between">
              <span id="companyPanelHeading" class="fw-bold fs-5"
                >Add Company Data</span
              >
              <div class="col my-auto d-flex justify-content-end">
                <i
                  class="fa-solid fa-circle-xmark my-auto panelClose"
                  id="closeCompanyPanelBtn"
                ></i>
              </div>
            </div>

            <hr />

            <div class="form-group my-3">
              <label for="company-name">Company Name</label>
              <input
                id="company_name"
                class="form-control"
                placeholder="eg. Aaron John's"
                type="text"
                name="company-name"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-short-name">Short Name</label>
              <input
                id="company_short_name"
                class="form-control"
                placeholder="eg. AJs"
                type="text"
                name="company-short-name"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-gstin">GSTIN</label>
              <input
                id="company_gstin"
                class="form-control"
                placeholder="eg. AJs"
                type="text"
                name="company-gstin"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-pan">PAN</label>
              <input
                id="company_pan"
                class="form-control"
                placeholder="eg. AJs"
                type="text"
                name="company-pan"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-address">Address</label>
              <input
                id="company_address"
                class="form-control"
                placeholder="eg. xyz Street"
                type="text area"
                name="company-address"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-country">Country</label>
              <input
                id="company_country"
                class="form-control"
                placeholder="eg. India"
                type="text"
                name="company-country"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-bank-ac">Bank Account</label>
              <input
                id="company_bank_ac"
                class="form-control"
                placeholder="eg. 00000000"
                type="text"
                name="company-bank-ac"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-ifsc">IFSC</label>
              <input
                id="company_ifsc"
                class="form-control"
                placeholder="eg. HDFC000222"
                type="text"
                name="company-ifsc"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-currency">Currency</label>
              <input
                id="company_currency"
                class="form-control"
                placeholder="eg. IMR"
                type="text"
                name="company-currency"
              />
            </div>

            <div class="form-group my-3">
              <label for="company-fin-year-start">Financial Year Start</label>
              <input
                id="company_fin_year_start"
                class="form-control"
                placeholder="eg. April"
                type="text"
                name="company-fin-year-start"
              />
            </div>

            <div class="d-flex justify-content-between mt-4 py-3 pb-4">
              <div id="submitCompany" class="col-lg-5 btn btn-danger">Save</div>
              <div
                id="resetCompanyDataBtn"
                class="col-lg-5 btn btn-outline-danger"
              >
                Clear
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Table Content -->
      <div class="rounded-2 d-flex justify-content-center mt-4 py-4">
        <div class="border p-4 w-100">
          <!-- Add Button -->
          <div class="d-flex rounded-2 justify-content-end pb-4">
            <div
              id="openCompanyPanelBtn"
              class="btn btn-outline-danger d-flex justify-content-around"
              style="width: 100px"
            >
              <i class="fa-solid fa-circle-plus my-auto"></i>
              <span style="margin-top: 4px" class="fw-bold my-auto">Add</span>
            </div>
          </div>

          <table id="companyTable" class="table table-hover nowrap w-100">
            <thead>
              <tr>
                <th></th>
                <th></th>
                <th class="fw-bold"><span>Company Name</span></th>
                <th class="fw-bold"><span>Short Name</span></th>
                <th class="fw-bold"><span>GSTIN</span></th>
                <th class="fw-bold"><span>PAN</span></th>
                <th class="fw-bold"><span>Address</span></th>
                <th class="fw-bold"><span>Country</span></th>
                <th class="fw-bold"><span>Bank Account</span></th>
                <th class="fw-bold"><span>IFSC</span></th>
                <th class="fw-bold"><span>Currency</span></th>
                <th class="fw-bold"><span>Financial Year Start</span></th>
                <th class="fw-bold"><span>Created At</span></th>
              </tr>
            </thead>
          </table>
        </div>
      </div>
    </div>
    <!-- Company Container Ends -->

    <!-- ------------------------------------------------------------------------------------------------------------- -->
    <!-- ------------------------------------- Division Container ---------------------------------------------------- -->
    <!-- ------------------------------------------------------------------------------------------------------------- -->
    <div class="menu-container divisionContainer d-none">
      <!-- Slide-in Panel -->
      <div id="divisionSlideInPanel" class="slideInPanel px-4 overflow-auto">
