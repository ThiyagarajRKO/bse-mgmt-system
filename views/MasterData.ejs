      function loadProductSpecies(callback) {
        // Load Species - request all species with high limit
        $.ajax({
          url: "/api/master/species",
          method: "GET",
          data: { length: 200 }, // Request up to 200 species (we have 109+)
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          success: (response) => {
            const speciesData = response?.data || [];

            // Build species map and transform for Select2
            window.PRODUCT_SPECIES_MAP = {};
            const select2Data = [];

            $.each(speciesData, function (i, item) {
              const idStr = String(item.id);
              window.PRODUCT_SPECIES_MAP[idStr] = {
                id: idStr,
                name: item.species_name,
                parent_category_type: item.parent_category_type,
                hsn_code: item.hsn_code,
              };
              console.log(
                "Loaded species:",
                item.species_name,
                "HSN:",
                item.hsn_code
              );
              select2Data.push({
                id: idStr,
                text: item.species_name,
              });
            });

            // Destroy existing Select2 if initialized
            if ($("#productSpecies").hasClass("select2-hidden-accessible")) {
              $("#productSpecies").select2("destroy");
            }

            // CRITICAL: Also populate DOM with option elements so Select2 can display selections
            // Select2 needs actual DOM <option> elements to properly display selected values
            $("#productSpecies").empty(); // Clear any existing options
            $.each(select2Data, function (i, item) {
              const $option = $("<option></option>")
                .val(item.id)
                .text(item.text);
              // Store text as data attribute for Select2 to use
              $option.data("text", item.text);
              $("#productSpecies").append($option);
            });

            // Initialize Select2 with DOM options (not data array)
            // This allows Select2 to properly display selected values from the actual DOM
            $("#productSpecies").select2({
              placeholder: "Choose a species",
              allowClear: true,
              width: "100%",
              // Use templateSelection to format the display
              templateSelection: function (data, container) {
                // Get the actual text from the DOM option
                if (!data.id) {
                  return data.text || "Choose a species";
                }
                // Find the option element to get its text
                const $option = $("#productSpecies").find(
                  `option[value="${data.id}"]`
                );
                if ($option.length > 0) {
                  return $option.text();
                }
                // Fallback to data.text
                return data.text || "Choose a species";
              },
              // Template for dropdown results
              templateResult: function (data) {
                if (!data.id) {
                  return data.text;
                }
                return data.text || "";
              },
              matcher: function (params, data) {
                // Allow fuzzy matching
                if ($.trim(params.term) === "") {
                  return data;
                }
                if (typeof data.text === "undefined") {
                  return null;
                }
                if (
                  data.text.toUpperCase().indexOf(params.term.toUpperCase()) >
                  -1
                ) {
                  return data;
                }
                return null;
              },
              language: {
                noResults: function () {
                  return "No species found";
                },
              },
            });

            // When a species is selected, force the display to update
            $("#productSpecies").on("select2:select", function (e) {
              const data = e.params.data;
              if (data && data.id) {
                // Make sure the selected option's text is set correctly in the DOM
                const $selectedOption = $(this).find(
                  `option[value="${data.id}"]`
                );
                if ($selectedOption.length > 0 && !$selectedOption.text()) {
                  // If the option text is empty, set it from the data
                  $selectedOption.text(data.text);
                }
              }
            });

            // Make the dropdown clickable by ensuring proper event binding
            $("#productSpecies").on("select2:opening", function (e) {});

            // CRITICAL: Clear selection to show placeholder "Choose a species" by default
            $("#productSpecies").val(null);
            $("#productSpecies").trigger("change.select2");

            // Bind change event after Select2 is initialized
            // This handler loads cascading dropdowns and handles edit mode
            $("#productSpecies").on("change.select2", function (e) {
              const speciesId = $(this).val();
              const $selectedOption = $(this).find("option:selected");

              // Get the selected text from the DOM option
              let selectedText = $selectedOption.text();

              // If no text found in DOM, try to get from Select2 data
              if (!selectedText) {
                const currentData = $("#productSpecies").select2("data");
                if (Array.isArray(currentData) && currentData.length > 0) {
                  selectedText =
                    currentData[0].text || currentData[0].name || "";
                }
              }

              // Skip cascading if in edit mode (we'll handle category setting separately)
              // But still populate HSN code from species
              const isEditMode = window.PRODUCT_EDIT_MODE;

              // Skip cascading dropdown loading if in edit mode (we'll handle category setting separately)
              // But still populate HSN code from species
              if (isEditMode) {
                // In edit mode, only populate HSN code and skip dropdown cascading
                const speciesData = window.PRODUCT_SPECIES_MAP[speciesId];
                const speciesHsnCode = speciesData?.hsn_code || null;
                console.log("Edit mode - Species HSN Code:", speciesHsnCode);

                // Populate HSN code field with species HSN code
                if (speciesHsnCode) {
                  $("#hsn_code").val(speciesHsnCode);
                  console.log("HSN code set to:", speciesHsnCode);
                } else {
                  $("#hsn_code").val(""); // Clear if no HSN code
                  console.log("HSN code cleared - no HSN code found");
                }
                return;
              }

              // If no species selected
              if (!speciesId) {
                // Clear and reset product category dropdown
                if (
                  $("#product_category").hasClass("select2-hidden-accessible")
                ) {
                  $("#product_category").select2("destroy");
                }
                $("#product_category").select2({
                  data: [],
                  placeholder: "Select a species first",
                  allowClear: true,
                });

                // Load all sizes
                loadProductSizes();
                return;
              }

              // Clear and reset product category dropdown
              $("#product_category").val(null).trigger("change");

              // Look up species data from our map
              const speciesData = window.PRODUCT_SPECIES_MAP[speciesId];
              console.log("Selected species:", speciesId, "Data:", speciesData);

              const speciesName = speciesData?.name || null;
              const parentCategoryType =
                speciesData?.parent_category_type || null;
              const speciesHsnCode = speciesData?.hsn_code || null;

              console.log("Species HSN Code:", speciesHsnCode);

              // Populate HSN code field with species HSN code
              if (speciesHsnCode) {
                $("#hsn_code").val(speciesHsnCode);
                console.log("HSN code set to:", speciesHsnCode);
              } else {
                $("#hsn_code").val(""); // Clear if no HSN code
                console.log("HSN code cleared - no HSN code found");
              }

              if (!speciesName) {
                console.warn(
                  "⚠️ Species name not found in map, fetching from API"
                );
                // fallback: try to fetch species details from API
                $.ajax({
                  url: `/api/master/species/${speciesId}`,
                  method: "GET",
                  dataType: "json",
                  success: function (resp) {
                    const sname =
                      resp?.data?.species_name ||
                      resp?.data?.species_master_name;
                    const ptype = resp?.data?.parent_category_type;
                    const hsnCode = resp?.data?.hsn_code;

                    // Populate HSN code field with species HSN code
                    if (hsnCode) {
                      $("#hsn_code").val(hsnCode);
                    } else {
                      $("#hsn_code").val(""); // Clear if no HSN code
                    }

                    populateProductCategorySuggestionsBySpeciesName(
                      sname,
                      ptype
                    );
                  },
                  error: function (xhr, status, error) {
                    toastr.error("Failed to load categories for this species");
                  },
                });

                // Load sizes for the selected species
                loadProductSizes(null, speciesId);
                return;
              }

              // Load categories for this species
              populateProductCategorySuggestionsBySpeciesName(
                speciesName,
                parentCategoryType
              );

              // Load sizes for the selected species
              loadProductSizes(null, speciesId);
            });

            // Call callback if provided
            if (typeof callback === "function") {
              callback();
            }
          },
          error: function (xhr, status, error) {
            toastr["error"]("Failed to load species data");
            // Call callback even on error to prevent hanging
            if (typeof callback === "function") {
              callback();
            }
          },
        });
      }

      function populateProductCategorySuggestionsBySpeciesName(
        speciesName,
        parentCategoryType
      ) {
        if (!speciesName) {
          return;
        }

        // Build request parameters
        const params = { species_master_name: speciesName };

        // Add parent_category_type to filter if available
        if (parentCategoryType) {
          params.parent_category_type = parentCategoryType;
        }

        $.ajax({
          url: "/api/master/product/category",
          method: "GET",
          data: params,
          dataType: "json",
          success: function (response) {
            // Response shape: { success, message, data: { rows: [...], count: N } }
            // OR: { data: { rows: [...], count: N } }
            let rows = response?.data?.rows || [];

            // Fallback: check if response itself is an array
            if (Array.isArray(response)) {
              rows = response;
            }

            // Another fallback: check if response.rows exists at top level
            if (!rows || rows.length === 0) {
              if (Array.isArray(response?.rows)) {
                rows = response.rows;
              }
            }

            if (!rows || !rows.length) {
              // no categories found in DB; try static mapping file
              fetch("/public/data/species_product_forms_clean.json")
                .then((r) => r.json())
                .then((map) => {
                  const match = (map || []).find(
                    (s) =>
                      s.species_name.toLowerCase() === speciesName.toLowerCase()
                  );
                  if (match && match.allowed_forms) {
                    setProductCategoryDatalist(match.allowed_forms);
                  }
                })
                .catch((err) => {});
              return;
            }

            // Use full objects with ID from database
            console.log("🔍 API returned rows:", rows);
            setProductCategoryDatalist(rows);
          },
          error: function (xhr, status, error) {
            // fallback to static JSON
            fetch("/public/data/species_product_forms_clean.json")
              .then((r) => r.json())
              .then((map) => {
                const match = (map || []).find(
                  (s) =>
                    s.species_name.toLowerCase() === speciesName.toLowerCase()
                );
                if (match && match.allowed_forms) {
                  setProductCategoryDatalist(match.allowed_forms);
                }
              })
