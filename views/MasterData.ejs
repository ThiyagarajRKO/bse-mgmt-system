      function setProductCategoryDatalist(arr) {
        console.log("🔍 setProductCategoryDatalist called with:", arr);
        if (!arr || arr.length === 0) {
          $("#categoryListContent").html(
            "No categories available for this species"
          );
          $("#categoryListContainer").show();

          // Clear dropdown
          $("#product_category").val(null).trigger("change");
          return;
        }

        // Handle both DB objects and static array of strings
        const data = (arr || []).map((item, index) => {
          if (typeof item === "string") {
            // Static JSON format - just category name
            return { id: item, text: item };
          } else {
            // DB object format - use id and product_category ONLY
            // Extract only the category name, no species name
            const categoryText = item.product_category
              ? item.product_category.trim()
              : "";
            return {
              id: item.id,
              text: categoryText,
            };
          }
        });

        console.log("🔍 Final data array for Select2:", data);
        // Update the category list display
        if (data.length > 0) {
          const categoryNames = data.map((cat) => cat.text).join(", ");
          const categoryCount = data.length;
          $("#categoryListContent").html(
            `<strong>${categoryCount} categories available:</strong><br/>` +
              `<code style="display: block; margin-top: 5px; word-break: break-word;">${categoryNames}</code>`
          );
          $("#categoryListContainer").show();
        }

        // CRITICAL: Ensure Select2 element exists
        if ($("#product_category").length === 0) {
          return;
        }

        // Check if Select2 is already initialized
        const isInitialized = $("#product_category").hasClass(
          "select2-hidden-accessible"
        );

        if (isInitialized) {
          // Update existing Select2 instance with new data
          $("#product_category").empty();

          // Destroy and re-create to ensure clean state
          $("#product_category").select2("destroy");
        }

        // Populate DOM with option elements
        $("#product_category").empty();
        $.each(data, function (i, item) {
          const $option = $("<option></option>").val(item.id).text(item.text);
          $("#product_category").append($option);
        });

        // Initialize Select2 with DOM options
        $("#product_category").select2({
          placeholder: "Choose product category",
          allowClear: true,
          width: "100%",
        });

        // ⚠️ Don't auto-select first item - let user choose explicitly
        // The placeholder "Choose product category" will be displayed by default
      }

      function loadProductSizes(callback, speciesId, isRetry = false) {
        console.log(
          `🔄 Loading product sizes: speciesId=${speciesId}, isRetry=${isRetry}`
        );

        // If species ID provided, load sizes for that specific species
        if (speciesId && !isRetry) {
          $.ajax({
            url: `/api/master/product/sizes-by-species/${speciesId}`,
            method: "GET",
            dataType: "json",
            contentType: "application/json",
            crossDomain: true,
            processData: false,
            success: (response) => {
              const sizeData = response?.data?.rows || [];
              console.log(
                `✅ Loaded ${sizeData.length} species-specific sizes for species ${speciesId}`
              );

              // Destroy existing Select2 if initialized
              if ($("#productSizes").hasClass("select2-hidden-accessible")) {
                $("#productSizes").select2("destroy");
              }

              // Populate DOM with option elements
              $("#productSizes").empty();
              $.each(sizeData, function (i, item) {
                const $option = $("<option></option>")
                  .val(item.id)
                  .text(`${item.size} (${item.unit_of_measure})`);
                $("#productSizes").append($option);
              });

              // Initialize Select2 with DOM options
              $("#productSizes").select2({
                placeholder: "Choose a size",
                allowClear: true,
                templateSelection: function (data, container) {
                  if (!data.id) {
                    return data.text || "Choose a size";
                  }
                  // Get text from the actual DOM option
                  const $option = $("#productSizes").find(
                    `option[value="${data.id}"]`
                  );
                  if ($option.length > 0) {
                    return $option.text();
                  }
                  return data.text || "Choose a size";
                },
                templateResult: function (data) {
                  if (!data.id) {
                    return data.text;
                  }
                  return data.text || "";
                },
              });

              // Only clear selected value if no callback is provided AND not in edit mode
              if (!callback && !window.PRODUCT_EDIT_MODE) {
                $("#productSizes").val(null).trigger("change");
              }

              if (typeof callback === "function") {
                callback();
              }
            },
            error: (jqXhr, textStatus, errorThrown) => {
              console.warn(
                `⚠️ Failed to load species-specific sizes for species ${speciesId}, falling back to all sizes`,
                jqXhr?.status,
                jqXhr?.responseJSON?.message
              );
              // Fallback to loading all sizes (with retry flag to prevent infinite recursion)
              loadProductSizes(callback, null, true);
            },
          });
          return;
        }

        // Load all sizes (default behavior if species not selected)
        $.ajax({
          url: "/api/master/size",
          method: "GET",
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          processData: false,
          success: (response) => {
            // API returns: { draw, data: [...], recordsTotal, recordsFiltered }
            const sizeData = response?.data || [];
            console.log(
              `✅ Loaded ${sizeData.length} fallback sizes (all sizes)`
            );

            // Destroy existing Select2 if initialized
            if ($("#productSizes").hasClass("select2-hidden-accessible")) {
              $("#productSizes").select2("destroy");
            } // Populate DOM with option elements
            $("#productSizes").empty();
            $.each(sizeData, function (i, item) {
              const $option = $("<option></option>")
                .val(item.id)
                .text(item.size);
              $("#productSizes").append($option);
            });

            // Initialize Select2 with DOM options
            $("#productSizes").select2({
              placeholder: "Choose a size",
              allowClear: true,
              templateSelection: function (data, container) {
                if (!data.id) {
                  return data.text || "Choose a size";
                }
                // Get text from the actual DOM option
                const $option = $("#productSizes").find(
                  `option[value="${data.id}"]`
                );
                if ($option.length > 0) {
                  return $option.text();
                }
                return data.text || "Choose a size";
              },
              templateResult: function (data) {
                if (!data.id) {
                  return data.text;
                }
                return data.text || "";
              },
            });

            // Only clear selected value if no callback is provided AND not in edit mode
            if (!callback && !window.PRODUCT_EDIT_MODE) {
              // Clearing selected value
              $("#productSizes").val(null).trigger("change");
            }

            if (typeof callback === "function") {
              callback();
            }
          },
          error: (jqXhr, textStatus, errorThrown) => {
            console.error(
              "❌ Error loading all sizes fallback:",
              jqXhr?.status,
              jqXhr?.responseJSON?.message || textStatus
            );

            // Only show error toast if not in edit mode or if it's a critical error
            if (jqXhr?.status == 420) {
              toastr["warning"](jqXhr["responseJSON"]["message"]);
            } else if (jqXhr?.status >= 500) {
              toastr["error"]("Server error: Unable to load sizes");
            }
            // For 404 or other errors, just log to console but don't alert the user excessively

            if (typeof callback === "function") {
              callback();
            }
          },
        });
      }

      // Listen for grade selection change to filter sizes
      $(document).on("change", "#productGrade", function () {
        const gradeId = $(this).val();

        // Skip cascading if in edit mode (we handle it separately)
        if (window.PRODUCT_EDIT_MODE) {
          return;
        }

        if (!gradeId) {
          // If no grade selected, load all sizes
          loadProductSizes();
          return;
        }

        // Load sizes for selected grade
        $.ajax({
          url: `/api/master/product/sizes-by-grade/${gradeId}`,
          method: "GET",
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          processData: false,
          success: (response) => {
            const data = response?.data;
            if (data && data.rows) {
              // Update sizes dropdown with filtered sizes
              $("#productSizes").select2({
                placeholder: "Choose a size",
                allowClear: true,
                data: $.map(data.rows, function (item) {
                  return {
                    id: item.id,
                    text: item.size,
                  };
                }),
              });

              // Clear any selected values
              $("#productSizes").val(null).trigger("change");
            }
          },
          error: (jqXhr, textStatus, errorThrown) => {
            console.warn(
              `⚠️ Failed to load grade-specific sizes for grade ${gradeId}, falling back to all sizes`,
              jqXhr?.status,
              jqXhr?.responseJSON?.message
            );
            // Fallback to loading all sizes when grade-specific sizes fail
            loadProductSizes();
          },
        });
      });

      function saveProduct() {
        const product_master_id = $("#submitProduct").attr("product_master_id");
        const speciesId = $("#productSpecies").val();
        const categoryId = $("#product_category").val();
        const gradeId = $("#productGrade").val();
        const sizeId = $("#productSizes").val();
        const hsnCode = $("#hsn_code").val();

        // Validation
        // For editing, prioritize checking size since it might not load in time
        if (product_master_id) {
          // Editing mode - check for the most critical field that might fail to load
          if (!sizeId) {
            toastr.error("Please select a size");
            return;
          }
        } else {
          // Creating new product - validate all fields
          if (!speciesId) {
            toastr.error("Please select a species");
            return;
          }
          if (!categoryId) {
            toastr.error("Please select a product category");
            return;
          }
          if (!gradeId) {
            toastr.error("Please select a grade");
            return;
          }
          if (!sizeId) {
            toastr.error("Please select a size");
            return;
          }
        }

        let url = "/api/master/product";
        let method = "POST";
        let input_params = {
          product_category_master_id: categoryId,
          species_master_id: speciesId,
          grade_master_id: gradeId,
          size_master_id: sizeId,
          hsn_code: hsnCode,
        };

        if (product_master_id) {
          url = "/api/master/product";
          method = "PUT";
          input_params = {
            product_master_id,
            product_master_data: {
              ...input_params,
            },
          };
        }

        $.ajax({
          url,
          method,
          dataType: "json",
          contentType: "application/json",
          data: JSON.stringify(input_params),
          crossDomain: true,
          processData: false,
          success: (data) => {
            toastr["success"](data?.message);

            $("#closeProductPanelBtn").click();

            loadProductTableData();

            resetAllInputs();
          },
          error: (jqXhr, textStatus, errorThrown) => {
            const errorMsg =
              jqXhr?.responseJSON?.message ||
              jqXhr?.responseText ||
              "Failed to save product";
            if (jqXhr["status"] == 420) {
              toastr["warning"](errorMsg);
            } else {
              toastr["error"](errorMsg);
            }
          },
        });
      }

