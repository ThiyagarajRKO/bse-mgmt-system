                                                <td product_master_id='${
                                                  row?.ProductMaster?.id
                                                }'>${
            row?.ProductMaster?.product_name
          }</td>
                                                <td>${row?.price_value}</td>
                                                <td>${formatDate(
                                                  new Date(row?.created_at),
                                                  true
                                                )}</td>
