                             data-company_id="${row.company_id}"
                             style="font-size:15px;color:#f07b3f;cursor:pointer;"
                             title="Delete Division"></i>
                        `,
            },

            {
              targets: 5,
              render: function (data) {
                if (!data) return "";
                const d = new Date(data);

                const months = [
                  "Jan",
                  "Feb",
                  "Mar",
                  "Apr",
                  "May",
                  "Jun",
                  "Jul",
                  "Aug",
                  "Sep",
                  "Oct",
                  "Nov",
                  "Dec",
                ];
                const month = months[d.getMonth()];
                const day = d.getDate().toString().padStart(2, "0");

                let h = d.getHours();
                const ampm = h >= 12 ? "PM" : "AM";
                h = h % 12 || 12;
                const minutes = d.getMinutes().toString().padStart(2, "0");

                return `${day}-${month}-${d.getFullYear()} ${h}:${minutes} ${ampm}`;
              },
            },
          ],
        });
