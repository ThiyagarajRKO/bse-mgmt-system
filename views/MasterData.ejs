      $(document).on("click", ".editProduct", (e) => {
        const product_master_id = $(e.target).attr("product_master_id");

        // Fetch product details from API
        $.ajax({
          url: `/api/master/product/${product_master_id}`,
          method: "GET",
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          success: (response) => {
            const product = response?.data;

            if (!product) {
              toastr.error("Failed to load product details");
              return;
            }

            // Set edit mode flag FIRST
            window.PRODUCT_EDIT_MODE = true;

            // Store edit values in window
            window.PRODUCT_EDIT_VALUES = {
              speciesMasterId: product.ProductCategoryMaster?.SpeciesMaster?.id,
              productCategoryMasterId: product.ProductCategoryMaster?.id,
              gradeMasterId: product.GradeMaster?.id,
              sizeMasterId: product.SizeMaster?.id,
              hsnCode: product.hsn_code,
            };

            // Define callback to set form values after dropdowns are loaded
            window.PRODUCT_EDIT_CALLBACK = () => {
              const {
                speciesMasterId,
                productCategoryMasterId,
                gradeMasterId,
                sizeMasterId,
                hsnCode,
              } = window.PRODUCT_EDIT_VALUES;

              // Set species value
              if (speciesMasterId) {
                const speciesIdStr = String(speciesMasterId).trim();
                let speciesData = window.PRODUCT_SPECIES_MAP[speciesIdStr];

                // If species data not in map, try to get it from Select2 data
                if (!speciesData) {
                  const select2Data = $("#productSpecies").select2("data");
                  if (Array.isArray(select2Data)) {
                    const foundData = select2Data.find(
                      (item) => String(item.id).trim() === speciesIdStr
                    );
                    if (foundData) {
                      speciesData = {
                        name: foundData.text,
                        parent_category_type: "unknown",
                      };
                    }
                  }
                }

                if (speciesData) {
                  // Update the option text FIRST to ensure it displays
                  const $option = $("#productSpecies").find(
                    `option[value="${speciesIdStr}"]`
                  );
                  if ($option.length > 0) {
                    $option.text(speciesData.name);
                  }

                  // Set the value and trigger change event
                  $("#productSpecies")
                    .val(speciesIdStr)
                    .trigger("change.select2");

                  // Load categories for this species
                  populateProductCategorySuggestionsBySpeciesName(
                    speciesData.name,
                    speciesData.parent_category_type
                  );

                  // IMPORTANT: Also load sizes for this species in edit mode
                  // since the species change handler returns early in edit mode
                  loadProductSizes(null, speciesIdStr);
                }
              }

              // Wait for categories to load, then set other values
              setTimeout(() => {
                if (productCategoryMasterId) {
                  $("#product_category").val(productCategoryMasterId);
                  $("#product_category").trigger("change.select2");
                }
              }, 500);

              // Wait for grades to load, then set grade
              setTimeout(() => {
                if (gradeMasterId) {
                  console.log("🎯 Trying to set grade to:", gradeMasterId);
                  // Make sure the grade option exists before trying to set it
                  const $gradeOption = $("#productGrade").find(
                    `option[value="${gradeMasterId}"]`
                  );
                  console.log(
                    "📌 Grade option found:",
                    $gradeOption.length > 0
                  );
                  if ($gradeOption.length > 0) {
                    console.log(
                      "✅ Setting grade to:",
                      gradeMasterId,
                      "text:",
                      $gradeOption.text()
                    );
                    $("#productGrade").val(gradeMasterId);
                    $("#productGrade").trigger("change.select2");
                  } else {
                    // If grade not found yet, try again after a longer delay
                    console.log("⏳ Grade option not found, retrying...");
                    setTimeout(() => {
                      const $gradeOptionRetry = $("#productGrade").find(
                        `option[value="${gradeMasterId}"]`
                      );
                      if ($gradeOptionRetry.length > 0) {
                        console.log(
                          "✅ (Retry) Setting grade to:",
                          gradeMasterId
                        );
                        $("#productGrade").val(gradeMasterId);
                        $("#productGrade").trigger("change.select2");
                      } else {
                        console.log(
                          "❌ Grade option still not found after retry"
                        );
                      }
                    }, 500);
                  }
                }
              }, 600);

              // Wait longer for sizes to load (they take time to fetch from API)
              // Sizes are now explicitly loaded by loadProductSizes(null, speciesIdStr)
              setTimeout(() => {
                if (sizeMasterId) {
                  // Make sure the size option exists before trying to set it
                  const $sizeOption = $("#productSizes").find(
                    `option[value="${sizeMasterId}"]`
                  );
                  if ($sizeOption.length > 0) {
                    $("#productSizes").val(sizeMasterId);
                    $("#productSizes").trigger("change.select2");
                  } else {
                    // If size not found yet, try again after a longer delay
                    setTimeout(() => {
                      const $sizeOptionRetry = $("#productSizes").find(
                        `option[value="${sizeMasterId}"]`
                      );
                      if ($sizeOptionRetry.length > 0) {
                        $("#productSizes").val(sizeMasterId);
                        $("#productSizes").trigger("change.select2");
                      }
                    }, 1500);
                  }
                }
              }, 800);

              // Set HSN code
              if (hsnCode) {
                $("#hsn_code").val(hsnCode);
              }

              // Clear edit mode flag after values are set
              setTimeout(() => {
                window.PRODUCT_EDIT_MODE = false;
              }, 3000);
            };

            // Open the slide panel
            openSlidePanel(
              "productSlideInPanel",
              "productPanelHeading",
              "Product",
              "submitProduct",
              "product_master_id"
            );

            // Update heading and button AFTER openSlidePanel
            $("#productPanelHeading").text("Edit Product Data");
            $("#submitProduct").text("Update");
            $("#submitProduct").attr("product_master_id", product_master_id);

            // Load dropdowns with the edit callback
            loadProductDropdowns(window.PRODUCT_EDIT_CALLBACK);

            // Initialize size select2 - but with data that will be populated by loadProductDropdowns
            // Do NOT re-initialize after loadProductDropdowns as it will clear the data
            if (!$("#productSizes").hasClass("select2-hidden-accessible")) {
              $("#productSizes").select2({
                allowClear: true,
                placeholder: "Choose a size",
              });
            }
          },
          error: (jqXhr, textStatus, errorThrown) => {
            toastr.error("Failed to load product details");
          },
        });
      });

