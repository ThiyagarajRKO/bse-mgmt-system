      function loadCompanyDropdown(selectedId = "") {
        // Ensure user session is valid before fetching companies.
        App.ensureAuth()
          .then(() => {
            return $.ajax({ url: "/api/master/company/list", type: "GET" });
          })
          .then((res) => {
            if (!res.success) return toastr.error("Failed to load companies");
            const list = res.data?.rows || res.data || [];

            const selectors = [
              "#company_id",
              "#UnitCompany_id",
              "#supplierCompany_id",
              "#customerCompany_id",
              "#carrierCompany_id",
            ];

            selectors.forEach((sel) => {
              App.initCompanySelect(sel, list, selectedId);
            });
          })
          .catch((err) => {
            // show sign-in banner if unauthorized
            const bannerId = "company-auth-banner";
            if ($(`#${bannerId}`).length === 0) {
              const banner = $(
                `<div id="${bannerId}" style="position:fixed;top:70px;left:0;right:0;z-index:20000;padding:10px;background:#fff3cd;color:#856404;border:1px solid #ffeeba;text-align:center;">
                    Please sign in to load companies.
                    <a href="/" class="btn btn-sm btn-primary ms-2">Sign in</a>
                    <button id="${bannerId}-retry" class="btn btn-sm btn-outline-secondary ms-2">Retry</button>
                  </div>`
              );
              $("body").prepend(banner);
              $(`#${bannerId}-retry`).on("click", function () {
                $("#" + bannerId).remove();
                loadCompanyDropdown(selectedId);
              });
            }
          });
      }

