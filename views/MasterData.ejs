        const totalToLoad = 3; // species, grades, sizes

        function checkAllLoaded() {
          loadedCount++;
          if (loadedCount >= totalToLoad && typeof callback === "function") {
            callback();
          }
        }

        loadProductSpecies(checkAllLoaded);
        loadProductGrades(checkAllLoaded);
        loadProductSizes(checkAllLoaded);

        // Initialize product category dropdown
        $("#product_category").select2({
          placeholder: "Select a species first",
          allowClear: true,
          data: [],
        });
      }

      function loadProductGrades(callback) {
        // Load grades
        $.ajax({
          url: "/api/master/grade",
          method: "GET",
          dataType: "json",
          contentType: "application/json",
          crossDomain: true,
          processData: false,
          success: (response) => {
            // API returns: { draw, data: [...], recordsTotal, recordsFiltered }
            const gradeData = response?.data || [];

            console.log("📝 Grades loaded:", gradeData);

            // Destroy existing Select2 if initialized
            if ($("#productGrade").hasClass("select2-hidden-accessible")) {
              $("#productGrade").select2("destroy");
            }

            // Populate DOM with option elements
            $("#productGrade").empty();
            $.each(gradeData, function (i, item) {
              const $option = $("<option></option>")
                .val(item.id)
                .text(item.grade_name);
              $("#productGrade").append($option);
            });

            // Initialize Select2 with DOM options
            $("#productGrade").select2({
              placeholder: "Choose a grade",
              allowClear: true,
              templateSelection: function (data, container) {
                if (!data.id) {
                  return data.text || "Choose a grade";
                }
                // Get text from the actual DOM option
                const $option = $("#productGrade").find(
                  `option[value="${data.id}"]`
                );
                if ($option.length > 0) {
                  return $option.text();
                }
                return data.text || "Choose a grade";
              },
              templateResult: function (data) {
                if (!data.id) {
                  return data.text;
                }
                return data.text || "";
              },
            });

            // Only clear selected value if no callback is provided AND not in edit mode
            if (!callback && !window.PRODUCT_EDIT_MODE) {
              // Clearing selected value
              $("#productGrade").val(null).trigger("change");
            }

            if (typeof callback === "function") {
              callback();
            }
          },
          error: (jqXhr, textStatus, errorThrown) => {
            console.error("Error loading grades:", jqXhr);
            if (jqXhr?.status == 420) {
              toastr["warning"](jqXhr["responseJSON"]["message"]);
            } else {
              toastr["error"]("Failed to load grades");
            }
            if (typeof callback === "function") {
              callback();
            }
          },
        });
      }

