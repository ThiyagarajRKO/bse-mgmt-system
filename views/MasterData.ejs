            { data: null }, // edit
            { data: null }, // delete
            { data: "division_name" },
            { data: "description" },
            { data: "company.company_name", defaultContent: "" },
            { data: "created_at" },
          ],

          columnDefs: [
            {
              targets: 0,
              render: (data, type, row) => `
                          <i class="fa fa-pen-to-square edit editDivision"
                             division_master_id="${row.id}"
                             data-company_id="${row.company_id}"
                             style="font-size:15px;color:#f07b3f;cursor:pointer;"
