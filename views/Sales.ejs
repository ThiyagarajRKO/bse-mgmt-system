        $.ajax({
          url: `/api/procurement/product/calculate/requirements?productId=${productId}&quantityRequired=${quantityRequired}`,
          method: "GET",
          dataType: "json",
          success: function (response) {
            console.log("API Response received:", response);

            const calculation = response?.data;
            if (calculation) {
              console.log("AI Calculation Result:", calculation);

              // Store calculation results for later use
              window.aiCalculationResults = calculation;

