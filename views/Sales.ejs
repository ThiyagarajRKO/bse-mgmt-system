      // Calculate recommended order quantity after deducting available raw materials
      function calculateAdjustedRecommendedQuantity(quantityRequired) {
        // Get total available raw material inventory
        let totalAvailableRawMaterial = 0;

        $(".raw-material-card").each(function () {
          // Extract available stock from each raw material card
          const stockText = $(this)
            .find("strong:contains('Available Stock')")
            .next()
            .text();
          if (stockText) {
            const match = stockText.match(/(\d+)/);
            if (match) {
              totalAvailableRawMaterial += parseInt(match[1]) || 0;
            }
          }
        });

        console.log(
          `Total available raw material: ${totalAvailableRawMaterial} units`,
        );
        console.log(`Quantity required: ${quantityRequired} units`);

        // Calculate buffer quantity
        const quantityWithBuffer = Math.ceil(quantityRequired * 1.2);

        // Deduct available inventory from buffer quantity
        const adjustedRecommendation = Math.max(
          0,
          quantityWithBuffer - totalAvailableRawMaterial,
        );

        console.log(
          `Adjusted recommendation: ${adjustedRecommendation} units (${quantityWithBuffer} - ${totalAvailableRawMaterial})`,
        );

        // Update the quantity hint with adjusted value
        $("#purchaseRequestQuantityHint").html(
          `<strong>Total Required:</strong> ${Math.ceil(quantityRequired)} units | 
           <strong>With Buffer (20%):</strong> ${quantityWithBuffer} units | 
           <strong>Available Raw Material:</strong> ${totalAvailableRawMaterial} units | 
           <strong style="color: #0066cc;">Recommended to Order:</strong> <strong style="color: #0066cc; font-size: 1.1em;">${adjustedRecommendation} units</strong>`,
        );

        // Update the input field
        $("#purchaseRequestQuantity").val(adjustedRecommendation);

        return adjustedRecommendation;
      }

