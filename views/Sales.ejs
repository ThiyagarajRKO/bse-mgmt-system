      // Get default UOM for species when SizeMaster is not available
      function getDefaultUOMForSpecies(speciesName) {
        if (!speciesName) return "units";

        const species = speciesName.toLowerCase();

        // Cephalopods (Squid, Cuttlefish, Octopus) - typically kg for whole, pcs for processed
        if (
          species.includes("cuttlefish") ||
          species.includes("squid") ||
          species.includes("octopus")
        ) {
          return "kg";
        }

        // Shrimp/Prawn - typically count/kg
        if (species.includes("shrimp") || species.includes("prawn")) {
          return "count/kg";
        }

        // Fish - typically kg
        if (
          species.includes("fish") ||
          species.includes("tuna") ||
          species.includes("salmon") ||
          species.includes("cod")
        ) {
          return "kg";
        }

        // Bivalves (Mussels, Oysters, Clams) - typically kg
        if (
          species.includes("mussel") ||
          species.includes("oyster") ||
          species.includes("clam") ||
          species.includes("scallop")
        ) {
          return "kg";
        }

        // Default fallback
        return "kg";
      }

      // Extract species name from product name (fallback when SpeciesMaster is not loaded)
      function extractSpeciesFromProductName(productName) {
        if (!productName) return null;

        // Product names are typically in format: "Species | Derivative | Size"
        const parts = productName.split(" | ");
        if (parts.length > 0) {
          return parts[0].trim();
        }

        return null;
      }

      // Load product-specific raw materials from database
      function loadProductSpecificMaterials(
        speciesName,
        productName,
        container,
        productId,
        quantityRequired,
      ) {
        // Strategy: Query procurement products for the specific product_master_id
        // Display the FIRST material with auto-calculated quantity (20% buffer)
        // Check inventory availability

        console.log("DEBUG: Loading materials for product ID:", productId);

        // First, try to fetch procurement products for this specific product
        $.ajax({
          url: `/api/procurement/product?product_master_id=${productId}`,
          method: "GET",
          dataType: "json",
          success: function (response) {
            const productSpecificMaterials = response?.data?.rows || [];

            console.log(
              "DEBUG: Product-specific materials found:",
              productSpecificMaterials,
            );

            if (
              productSpecificMaterials &&
              productSpecificMaterials.length > 0
            ) {
              // Filter to only UNPROCESSED materials
              const unprocessedMaterials = productSpecificMaterials.filter(
                (mat) => mat.procurement_product_type === "UNPROCESSED",
              );

              if (unprocessedMaterials.length > 0) {
                console.log(
                  "Found product-specific UNPROCESSED materials:",
                  unprocessedMaterials,
                );

                // Use ONLY the first material
                const material = unprocessedMaterials[0];
                let displayName =
                  material?.ProductMaster?.product_name ||
                  material.procurement_purchaser ||
                  "Raw Material";

                console.log("Material mapping:", {
                  id: material.id,
                  product_name: material?.ProductMaster?.product_name,
                  procurement_purchaser: material.procurement_purchaser,
                  final_name: displayName,
                });

                // Fetch inventory for this procurement product
                $.ajax({
                  url: `/api/inventory/purchase/all`,
                  method: "GET",
                  dataType: "json",
                  success: function (inventoryResponse) {
                    const inventories = inventoryResponse?.data || [];
                    // Sum all quantities for this procurement product
                    const materialInventories = inventories.filter(
                      (inv) =>
                        inv.procurement_product_id === material.id &&
                        inv.is_active === true,
                    );
                    const availableStock = materialInventories.reduce(
                      (total, inv) => total + (inv.quantity || 0),
                      0,
                    );
                    const unitOfMeasure =
                      material?.ProductMaster?.SizeMaster?.unit_of_measure ||
                      getDefaultUOMForSpecies(
                        material?.ProductMaster?.ProductCategoryMaster
                          ?.SpeciesMaster?.species_name ||
                          extractSpeciesFromProductName(
                            material?.ProductMaster?.product_name,
                          ),
                      );

                    console.log("Inventory for material:", {
                      material_id: material.id,
                      available_stock: availableStock,
                      unit_of_measure: unitOfMeasure,
                    });

                    renderSingleRawMaterial(
                      material.id,
                      displayName,
                      quantityRequired,
                      container,
                      availableStock,
                      unitOfMeasure,
                    );
                  },
                  error: function (xhr) {
                    console.error("Error fetching inventory:", xhr);
                    // Render without inventory data
                    const unitOfMeasure =
                      material?.ProductMaster?.SizeMaster?.unit_of_measure ||
                      getDefaultUOMForSpecies(
                        material?.ProductMaster?.ProductCategoryMaster
                          ?.SpeciesMaster?.species_name ||
                          extractSpeciesFromProductName(
                            material?.ProductMaster?.product_name,
                          ),
                      );
                    renderSingleRawMaterial(
                      material.id,
                      displayName,
                      quantityRequired,
                      container,
                      0,
                      unitOfMeasure,
                    );
                  },
                });
                return;
              }
            }

            // If no product-specific materials, fall back to all UNPROCESSED
            console.log(
              "No product-specific materials found, trying all UNPROCESSED materials",
            );
            loadUnprocessedMaterials(container, quantityRequired);
          },
          error: function (xhr) {
            console.error("Error fetching product-specific materials:", xhr);
            loadUnprocessedMaterials(container, quantityRequired);
          },
        });
      }

      // Load unprocessed materials
      function loadUnprocessedMaterials(container, quantityRequired) {
        $.ajax({
