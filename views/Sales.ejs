      // Fallback function for species-based filtering
      function fallbackToSpeciesFiltering(
        productId,
        quantityRequired,
        speciesId,
      ) {
        // First, calculate AI-powered requirements
        loadAICalculatedRequirementsForPanel(productId, quantityRequired);

        const container = $("#purchaseRequestRawMaterials");

        // If we already have speciesId from the order data, use it directly
        if (speciesId) {
          console.log(`✓ Using provided species ID: ${speciesId}`);
          loadRawMaterialsBySpecies(
            speciesId,
            quantityRequired,
            container,
            productId,
          );
          return;
        }

        // Otherwise, fetch the product details to get species information for filtering
        console.log("No species ID provided, fetching from product API...");
        $.ajax({
          url: `/api/master/product/${productId}`,
          method: "GET",
          dataType: "json",
          timeout: 5000,
          success: function (response) {
            console.log("Product API Response:", response);
            const product = response?.data;

            // Clear any existing content first
            container.html(
              '<p style="color: #999; text-align: center;">Loading raw materials...</p>',
            );

            if (!product) {
              console.warn("Product not found in response");
              container.html(
                '<p style="color: #d32f2f; text-align: center;">Product not found</p>',
              );
              return;
            }

            console.log("Product found:", product.product_name);
            console.log("=== DEBUG INFO ===");
            console.log("Full product object:", product);
            console.log(
              "product.ProductCategoryMaster:",
              product.ProductCategoryMaster,
            );
            console.log(
              "product.product_category_master_id:",
              product.product_category_master_id,
            );

            // Get the species_master_id from the product's category
            // The relationship is: Product -> ProductCategory -> SpeciesMaster
            let speciesMasterId = null;
            console.log("[SPECIES EXTRACTION] Checking for species...");
            console.log(
              "[SPECIES EXTRACTION] ProductCategoryMaster exists?",
              !!product.ProductCategoryMaster,
            );
            console.log(
              "[SPECIES EXTRACTION] ProductCategoryMaster.species_master_id:",
              product.ProductCategoryMaster?.species_master_id,
            );

            if (
              product.ProductCategoryMaster &&
              product.ProductCategoryMaster.species_master_id
            ) {
              speciesMasterId = product.ProductCategoryMaster.species_master_id;
              console.log("✓ Product species ID found:", speciesMasterId);
            } else {
              console.warn(
                "✗ BUG: ProductCategoryMaster or species_master_id is missing!",
              );
              if (product.ProductCategoryMaster) {
                console.warn(
                  "ProductCategoryMaster exists but species_master_id is:",
                  product.ProductCategoryMaster.species_master_id,
                );
                console.warn(
                  "ProductCategoryMaster contents:",
                  product.ProductCategoryMaster,
                );
              } else {
                console.error(
                  "✗ CRITICAL: ProductCategoryMaster is NULL/UNDEFINED - This is why filtering doesn't work!",
                );
              }
            }

            // Load materials using the extracted or provided species ID
            loadRawMaterialsBySpecies(
              speciesMasterId,
              quantityRequired,
              container,
              productId,
            );
          },
          error: function (xhr, status, error) {
            console.error("Error fetching product:", status, error);
