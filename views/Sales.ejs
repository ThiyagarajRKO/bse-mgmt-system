                    loadAllocationTableData();

                    // If Purchase Request table exists in Procurement, reload it
                    if ($.fn.DataTable.isDataTable("#purchaseRequestTable")) {
                      $("#purchaseRequestTable").DataTable().ajax.reload();
                    }
                  },
                  error: function (xhr) {
                    const errorMessage =
                      xhr?.responseJSON?.message ||
                      "Failed to raise purchase request";
                    toastr.error(errorMessage, "Error");
                  },
                });
              },
            },
            cancel: function () {
              toastr.info("Purchase request cancelled", "Info");
            },
          },
          onContentReady: function () {
            // Load suppliers when modal opens
            $.ajax({
              url: "/api/master/suppliers",
              method: "GET",
              success: function (response) {
                const suppliers = response?.data || [];
                let options = '<option value="">Select Supplier</option>';
