        );
        loadRawMaterialsForPurchaseRequest(productId, quantityRequired);

        console.log("About to show side panel");
        // Show the side panel using CSS animation
        $("#purchaseRequestSlideInPanel").css("right", "0");
        $("#purchaseRequestSlideInPanel").css("display", "block");
        console.log("Side panel should now be visible");
      }

      function loadRawMaterialsForPurchaseRequest(productId, quantityRequired) {
        console.log(
          "Loading raw materials for product:",
          productId,
          "quantity:",
          quantityRequired
        );

        // First, calculate AI-powered requirements
        loadAICalculatedRequirementsForPanel(productId, quantityRequired);

        // Fetch the product details to get species information for filtering
        $.ajax({
          url: `/api/master/product/${productId}`,
          method: "GET",
          dataType: "json",
          timeout: 5000,
          success: function (response) {
            console.log("Product API Response:", response);
            const product = response?.data;
            const container = $("#purchaseRequestRawMaterials");

            // Clear any existing content first
            container.html(
              '<p style="color: #999; text-align: center;">Loading raw materials...</p>'
            );

            if (!product) {
              console.warn("Product not found in response");
              container.html(
                '<p style="color: #d32f2f; text-align: center;">Product not found</p>'
              );
              return;
            }

            console.log("Product found:", product.product_name);

            // Get the species_master_id from the product's category
            // The relationship is: Product -> ProductCategory -> SpeciesMaster
            let speciesMasterId = null;
            if (
              product.ProductCategoryMaster &&
              product.ProductCategoryMaster.species_master_id
            ) {
              speciesMasterId = product.ProductCategoryMaster.species_master_id;
              console.log("Product species ID:", speciesMasterId);
            }

            // Fetch unprocessed procurement products (raw materials) filtered by species and type
            // The API now supports backend filtering by species_master_id for better performance
            let apiUrl = `/api/procurement/product?start=0&length=1000&procurement_product_type=UNPROCESSED`;

            // If product has a species, filter by that species on the backend
            if (speciesMasterId) {
              apiUrl += `&species_master_id=${speciesMasterId}`;
            }

            $.ajax({
              url: apiUrl,
              method: "GET",
              dataType: "json",
              timeout: 5000,
              success: function (response) {
                console.log("Procurement products API response:", response);
                // Handle different response formats
                let rawMaterials = [];

                if (response?.data) {
                  // If data is an object with rows (findAndCountAll format)
                  if (response.data.rows && Array.isArray(response.data.rows)) {
                    rawMaterials = response.data.rows;
                  }
                  // If data is directly an array
                  else if (Array.isArray(response.data)) {
                    rawMaterials = response.data;
                  }
                  // If data is a single object, wrap it in array
                  else if (typeof response.data === "object") {
                    rawMaterials = [response.data];
                  }
                }

                console.log(
                  "Filtered raw materials found:",
                  rawMaterials.length
                );

                // No client-side filtering needed - backend already filtered by species and type
                if (rawMaterials.length === 0) {
                  container.html(
                    '<p style="color: #d32f2f; text-align: center;">No unprocessed raw materials found for this product species</p>'
                  );
                  return;
                }

                let materialsHtml =
                  '<div style="display: flex; flex-direction: column; gap: 10px;">';
                rawMaterials.forEach((material) => {
                  // Handle both procurement_product_name and nested ProductMaster.product_name
                  const materialName =
                    material.procurement_product_name ||
                    (material.ProductMaster &&
                      material.ProductMaster.product_name) ||
                    "Unknown";
                  const supplierName =
                    material.SupplierMaster &&
                    material.SupplierMaster.supplier_name
                      ? ` - ${material.SupplierMaster.supplier_name}`
                      : "";

                  // Fetch the actual available quantity from purchase inventory for this procurement product
                  let purchaseInventory = 0;
                  let salesInventory = 0;
                  let netInventory = 0;

                  // Get product_master_id for sales inventory lookup
                  const productMasterId = material.product_master_id;

                  // Fetch purchase inventory
                  $.ajax({
                    url: `/api/inventory/purchase/all?procurement_product_id=${material.id}`,
                    method: "GET",
                    dataType: "json",
                    timeout: 5000,
                    async: false,
                    success: function (inventoryResponse) {
                      if (inventoryResponse?.data) {
                        if (Array.isArray(inventoryResponse.data)) {
                          purchaseInventory = inventoryResponse.data.reduce(
                            (sum, inv) => {
                              return (
                                sum +
                                (inv.available_quantity ||
                                  inv.quantity_in_stock ||
                                  0)
                              );
                            },
                            0
                          );
                        } else if (
                          inventoryResponse.data.available_quantity !==
                          undefined
                        ) {
                          purchaseInventory =
                            inventoryResponse.data.available_quantity || 0;
                        } else if (
                          inventoryResponse.data.quantity_in_stock !== undefined
                        ) {
                          purchaseInventory =
                            inventoryResponse.data.quantity_in_stock || 0;
                        }
                      }
                    },
                    error: function (xhr, status, error) {
                      console.error(
                        `Error fetching purchase inventory for material ${material.id}:`,
                        status,
                        error
                      );
                      purchaseInventory = 0;
                    },
                  });

                  // Fetch sales inventory by product_master_id
                  if (productMasterId) {
                    $.ajax({
                      url: `/api/inventory/sales/all?search=${productMasterId}`,
                      method: "GET",
                      dataType: "json",
                      timeout: 5000,
                      async: false,
                      success: function (salesResponse) {
                        if (salesResponse?.data) {
                          if (Array.isArray(salesResponse.data)) {
                            // Sum all sales inventory quantities for this product
                            salesInventory = salesResponse.data.reduce(
                              (sum, inv) => {
                                return sum + (inv.quantity || 0);
                              },
                              0
                            );
                          } else if (
                            salesResponse.data.quantity !== undefined
                          ) {
                            salesInventory = salesResponse.data.quantity || 0;
                          }
                        }
                      },
                      error: function (xhr, status, error) {
                        console.error(
                          `Error fetching sales inventory for product ${productMasterId}:`,
                          status,
                          error
                        );
                        salesInventory = 0;
                      },
                    });
                  }

                  // Calculate net inventory
                  netInventory = Math.max(
                    0,
                    purchaseInventory - salesInventory
                  );

                  console.log(
                    `Material: ${materialName}, Procurement ID: ${material.id}, Purchase: ${purchaseInventory}, Sales: ${salesInventory}, Net: ${netInventory}`
                  );

                  const statusColor = netInventory > 0 ? "#4caf50" : "#d32f2f";
                  const statusText =
                    netInventory > 0 ? "Available" : "Out of Stock";

                  materialsHtml += `
                    <div style="padding: 12px; background: #f5f5f5; border-radius: 4px; border-left: 4px solid ${statusColor};">
                      <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="flex: 1;">
                          <strong>${materialName}${supplierName}</strong>
                          <br>
                          <small style="color: #666; display: block; margin-top: 4px;">
                            <div style="margin: 4px 0;">Purchase Inventory: <strong>${purchaseInventory}</strong> units</div>
                            <div style="margin: 4px 0;">Sales Inventory: <strong>${salesInventory}</strong> units</div>
                            <div style="margin: 4px 0; padding: 4px; background: ${statusColor}22; border-radius: 3px; border-left: 3px solid ${statusColor};">
                              Current Available: <strong style="color: ${statusColor};">${netInventory}</strong> units
                            </div>
                            <div style="margin: 4px 0;">Price: ₹${
                              material.procurement_price || 0
                            }</div>
                          </small>
                        </div>
                        <span style="color: ${statusColor}; font-size: 0.9em; white-space: nowrap; margin-left: 10px;">
                          <strong>${statusText}</strong>
                        </span>
                      </div>
                      <input
                        type="radio"
                        name="rawMaterial"
                        value="${material.id}"
                        style="margin-top: 8px;"
                        data-material-name="${materialName}"
                      >
                      <label style="margin-left: 5px; font-size: 0.9em; cursor: pointer;">Select this material</label>
                    </div>
                  `;
                });
                materialsHtml += "</div>";

                container.html(materialsHtml);
                console.log(
                  "Raw materials HTML rendered with net inventory (purchase - sales)"
                );
              },
              error: function (xhr, status, error) {
                console.error(
                  "Error fetching procurement products:",
                  status,
                  error
                );
                container.html(
                  '<p style="color: #d32f2f; text-align: center;">Error loading raw materials: ' +
                    error +
                    "</p>"
                );
              },
            });
          },
          error: function (xhr, status, error) {
            console.error("Error fetching product:", status, error);
            const container = $("#purchaseRequestRawMaterials");
            container.html(
              '<p style="color: #d32f2f; text-align: center;">Error loading product details: ' +
                error +
                "</p>"
            );
          },
        });
      }

