        if (!order_id) {
          toastr.error("Order ID not found", "Error");
          return;
        }

        // First, try to confirm the order
        $.ajax({
          url: "/api/orders/confirm",
          method: "POST",
          data: JSON.stringify({
            order_id: order_id,
          }),
          contentType: "application/json",
        })
          .done(function (response) {
            // Successfully confirmed or already confirmed
            if (
              response.message &&
              response.message.includes("already confirmed")
            ) {
              toastr.info("Order is already confirmed", "Info");
            } else {
              toastr.success("Order confirmed successfully", "Success");
