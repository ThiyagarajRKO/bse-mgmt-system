      function saveOrders() {
        const order_id = $("#submitOrders").attr("order_id");

        let OrderProducts = [];

        $(".orderProduct").each((i, obj) => {
          // Extract the actual index from the fieldset class (e.g., "orderProduct_1" -> "1")
          const $fieldset = $(obj);
          const fieldsetClasses = $fieldset.attr("class") || "";
          const indexMatch = fieldsetClasses.match(/orderProduct_(\d+)/);
          const index = indexMatch ? indexMatch[1] : i + 1;

          let id = $fieldset
            .find(`.orderProductNames_${index}`)
            .parent()
            .find("select")
            .attr("peeled_product_id");

          let product_master_id = $fieldset
            .find(`.orderProductNames_${index}`)
            .val();

          let product_quantity = $fieldset
            .find(`.product_quantity_${index}`)
            .val();

          product_quantity = isNaN(parseFloat(product_quantity))
            ? 0
            : parseFloat(product_quantity);

          let product_price = $fieldset.find(`.product_price_${index}`).val();

          product_price = isNaN(parseFloat(product_price))
            ? 0
            : parseFloat(product_price);

          let product_desc = $fieldset.find(`.product_desc_${index}`).val();

          console.log(
            `[Order Products Collection] Index: ${index}, Product ID: ${product_master_id}, Quantity: ${product_quantity}, Price: ${product_price}`,
          );

          if (product_master_id) {
            let outputObj = {
              order_id,
              product_master_id,
              packing_id: null, // Allow null packing_id when using direct product selection
              quantity: product_quantity,
              price: product_price,
              description: product_desc,
            };

            if (id && id != "undefined") {
              outputObj.id = id;
            }

            OrderProducts.push(outputObj);
          }
        });

        console.log(
          `[Order Save] Total products to send: ${OrderProducts.length}`,
          OrderProducts,
        );

        let url = "/api/orders";
        let method = "POST";
        let input_params = {
          order_date: $("#order_date").val(),
          customer_master_id: $("#customerNames").val(),
          payment_terms: $("#payment_terms").val(),
          payment_type: $("#paymentTypes").val(),
          shipping_date: $("#shipping_date").val(),
          shipping_master_id: $("#shippingDestinations").val(),
          shipping_method: $("#shippingMethods").val(),
          shipping_address: $("#shipping_address").val(),
          expected_delivery_date: $("#expected_delivery_date").val(),
          OrderProducts,
        };

        if (order_id && order_id != "null") {
          url = "/api/orders";
          method = "PUT";

          input_params = {
            order_id,
            order_data: {
              ...input_params,
            },
          };
        }

        // if (product_unit > 0 && order_quantity < product_unit) {
        //   toastr["warning"](
        //     "Yield quantity must not be greater than orders quantity!"
        //   );
        //   return;
        // }

        $.ajax({
          url,
          method,
          dataType: "json",
          contentType: "application/json",
          data: JSON.stringify(input_params),
          crossDomain: true,
          processData: false,
          success: (data) => {
            toastr["success"](data?.message);

            $("#closeOrdersPanelBtn").click();

            loadOrdersTableData();

            resetAllInputs();
