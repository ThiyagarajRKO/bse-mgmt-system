      // Render single raw material with auto-calculated quantity
      function renderSingleRawMaterial(
        materialId,
        materialName,
        quantityRequired,
        container,
        availableStock = 0,
        unitOfMeasure = "units",
      ) {
        // Calculate quantity with 20% buffer
        const bufferedQuantity = parseFloat(quantityRequired) * 1.2;
        const roundedQuantity = Math.ceil(bufferedQuantity);
        const roundedAvailableStock = Math.ceil(availableStock);
        const hasStock = roundedAvailableStock >= roundedQuantity;
        const stockColor = hasStock ? "#EA5455" : "#EA5455";
        const stockStatus = hasStock
          ? '<span class="badge" style="background-color: #EA5455; color: white;">✓ Available</span>'
          : '<span class="badge" style="background-color: #EA5455; color: white;">✗ Out of Stock</span>';

        // Calculate quantity to purchase after deducting available stock
        const quantityToPurchase = Math.max(
          0,
          roundedQuantity - roundedAvailableStock,
        );

        const html = `
          <div style="padding: 10px; background: #f9f9f9; border-radius: 3px;">
            <div style="margin-bottom: 10px;">
              <strong>Material:</strong> ${materialName}
            </div>
            <div style="margin-bottom: 10px; padding: 8px; background: #fff; border-radius: 3px; border-left: 3px solid ${stockColor};">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Available Stock:</strong> <span class="badge" style="background-color: ${stockColor}; color: white;">${roundedAvailableStock} ${unitOfMeasure}</span></span>
                <span style="color: ${stockColor}; font-weight: bold;">${stockStatus}</span>
              </div>
            </div>
            <div style="margin-bottom: 10px; padding: 8px; background: #f0f8ff; border-radius: 3px; border-left: 3px solid #0066cc;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Quantity Required (with 20% buffer):</strong> ${roundedQuantity} ${unitOfMeasure}</span>
              </div>
            </div>
            <div style="margin-bottom: 10px; padding: 8px; background: #fff3cd; border-radius: 3px; border-left: 3px solid #ffc107;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Quantity to Purchase (after stock deduction):</strong> ${Math.ceil(quantityToPurchase)} ${unitOfMeasure}</span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <label style="margin: 0;">Adjust Quantity to Purchase:</label>
              <input 
                type="number" 
                id="single-raw-material-qty" 
                class="form-control form-control-sm" 
                value="${Math.ceil(quantityToPurchase)}" 
                min="0" 
                step="1"
                style="width: 100px;"
              >
              <span style="color: #666; font-size: 0.9em;">${unitOfMeasure}</span>
            </div>
            ${
              !hasStock
                ? '<div style="margin-top: 10px; color: #EA5455; font-weight: bold;">⚠️ Current stock insufficient to fulfill complete requirement!</div>'
