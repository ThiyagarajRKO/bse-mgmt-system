      // Begin Production Button Handler
      $(document).on("click", "#beginProductionBtn", function (e) {
        e.preventDefault();
        e.stopPropagation();

        console.log("Begin Production button clicked");

        const orderId = $(this).data("order-id");
        const productId = $(this).data("product-id");
        const orderNo = $(this).data("order-no");
        const quantityRequired = $(this).data("quantity");

        console.log("Begin Production data:", {
          orderId,
          productId,
          orderNo,
          quantityRequired,
        });

        // Show loading state
        const $btn = $(this);
        const originalText = $btn.html();
        $btn
          .prop("disabled", true)
          .html('<i class="fa-solid fa-spinner fa-spin"></i> Allocating...');

        // First, allocate stock automatically
        $.ajax({
          url: "/api/orders/allocate-stock",
          method: "POST",
          data: JSON.stringify({
            order_id: orderId,
            product_id: productId,
            quantity: quantityRequired,
          }),
          contentType: "application/json",
          success: function (response) {
            // Check if this is a redirect response (order already allocated)
            if (response.redirect) {
              toastr.info(
                response.message ||
                  "Order already allocated. Redirecting to production...",
                "Info",
              );

              // Close the modal
              $("#allocationViewModal").modal("hide");

              // Small delay to ensure modal is closed and toast is shown before redirecting
              setTimeout(() => {
                // Redirect to the specified URL or production page with order ID
                window.location.href =
                  response.redirect +
                  (response.order_id ? `?order_id=${response.order_id}` : "");
              }, 1500);
            } else {
              // Normal allocation success
              toastr.success(
                "Stock allocated successfully. Redirecting to production...",
                "Success",
              );

              // Close the modal
              $("#allocationViewModal").modal("hide");

              // Small delay to ensure modal is closed and toast is shown before redirecting
              setTimeout(() => {
                // Redirect to production page with order ID
                window.location.href = `/Production?order_id=${orderId}`;
              }, 1500);
            }
          },
          error: function (xhr) {
            // Reset button state
            $btn.prop("disabled", false).html(originalText);

            const errorMessage =
              xhr?.responseJSON?.message || "Failed to allocate stock";
            toastr.error(errorMessage, "Allocation Failed");

            // Close the modal
            $("#allocationViewModal").modal("hide");
          },
        });
      });

      // Raise Purchase Request Button Handler
      $(document).on("click", "#raisePurchaseRequestBtn", function (e) {
        e.preventDefault();
        e.stopPropagation();

        console.log("Raise Purchase Request button clicked");

        // Close the modal first
        $("#allocationViewModal").modal("hide");

        const orderId = $(this).data("order-id");
        const productId = $(this).data("product-id");
        const speciesId = $(this).data("species-id");
        const productName = $(this).data("product-name");
        const quantityRequired = $(this).data("quantity");
        const orderNo = $(this).data("order-no");

        console.log("Button data:", {
          orderId,
          productId,
          speciesId,
          productName,
          quantityRequired,
          orderNo,
        });

        // Validate data
        if (!productId || productId === "null" || productId === null) {
          toastr.error(
            "Product ID not found. Cannot raise purchase request.",
            "Error",
          );
          console.error("Invalid productId:", productId);
          return;
        }

        if (!quantityRequired || quantityRequired <= 0) {
          toastr.error(
            "Invalid quantity. Please check the order details.",
            "Error",
          );
          return;
        }

        // Small delay to ensure modal is closed before showing side panel
        setTimeout(() => {
          // First, check if a purchase request has already been auto-generated
          checkExistingPurchaseRequest(
            orderId,
            productId,
            speciesId,
            productName,
            quantityRequired,
            orderNo,
          );
        }, 300);
