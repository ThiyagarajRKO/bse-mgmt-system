      // Load Purchase Request History for an order
      function loadPurchaseRequestHistory(orderId) {
        const $container = $(`#purchaseRequestHistoryTable_${orderId}`);

        // Fetch purchase requests for this order from the API
        $.ajax({
          url: `/api/procurement/product/procurement-requests?order_id=${orderId}`,
          type: "GET",
          dataType: "json",
          success: function (response) {
            console.log("Purchase request history:", response);

            if (
              response.success &&
              response.data &&
              response.data.rows.length > 0
            ) {
              const requests = response.data.rows;

              // Build table HTML
              let tableHtml = `
                <table class="table table-sm table-hover mb-0">
                  <thead style="background-color: #f8f9fa;">
                    <tr>
                      <th style="text-align: center;">Date</th>
                      <th style="text-align: center;">Product</th>
                      <th style="text-align: center;">Quantity</th>
                      <th style="text-align: center;">Supplier</th>
                      <th style="text-align: center;">Status</th>
                      <th style="text-align: center;">Approver</th>
                      <th style="text-align: center;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
              `;

              requests.forEach(function (pr) {
                const date = new Date(pr.created_at).toLocaleDateString();
                const statusBadge =
                  pr.status === "Approved"
                    ? `<span class="badge badge-success">${pr.status}</span>`
                    : pr.status === "Rejected"
                      ? `<span class="badge badge-danger">${pr.status}</span>`
                      : `<span class="badge badge-warning">${pr.status}</span>`;

                tableHtml += `
                  <tr>
                    <td style="text-align: center; font-size: 0.9rem;">${date}</td>
                    <td style="text-align: center; font-size: 0.9rem;">${pr.product_name || "N/A"}</td>
                    <td style="text-align: center; font-size: 0.9rem;">${pr.procurement_quantity || 0}</td>
                    <td style="text-align: center; font-size: 0.9rem;">${pr.supplier_name || "N/A"}</td>
                    <td style="text-align: center;">${statusBadge}</td>
                    <td style="text-align: center; font-size: 0.9rem;">${pr.approver_name || "-"}</td>
                    <td style="text-align: center;">
                      <button class="btn btn-sm btn-outline-primary" title="View details" onclick="alert('View PR #${pr.id}')">
                        <i class="fa-solid fa-eye"></i>
                      </button>
                    </td>
                  </tr>
                `;
              });

              tableHtml += `
                  </tbody>
                </table>
              `;

              $container.html(tableHtml);
            } else {
              $container.html(`
                <p style="color: #999; text-align: center; margin: 20px 0;">
                  <i class="fa-solid fa-info-circle"></i> No purchase requests raised yet for this order.
                </p>
              `);
            }
          },
          error: function (error) {
            console.error("Error loading purchase request history:", error);
            $container.html(`
              <p style="color: #d32f2f; text-align: center; margin: 20px 0;">
                <i class="fa-solid fa-exclamation-triangle"></i> Error loading purchase request history
              </p>
            `);
          },
        });
      }

      // Check if purchase request already exists
      function checkExistingPurchaseRequest(
        orderId,
        productId,
        speciesId,
        productName,
        quantityRequired,
        orderNo,
      ) {
        console.log(
          "Checking existing purchase request for productId:",
          productId,
        );

        $.ajax({
          url: `/api/procurement/product?product_master_id=${productId}`,
          method: "GET",
          dataType: "json",
          success: function (response) {
            console.log("API Response:", response);
            const products = response?.data?.rows || [];

            // Check if there's any procurement product for this product with auto-generated note
            const autoGenerated = products.some(
              (prod) =>
                prod.procurement_purchaser &&
                prod.procurement_purchaser.includes("System Auto-Generated"),
            );

            if (autoGenerated) {
              $.alert({
                title: "Purchase Request Already Exists",
                content: `A purchase request for this product has already been automatically generated.<br><br>
                  <strong>Product:</strong> ${productName}<br>
                  <strong>Status:</strong> <span class="badge badge-info">Auto-Generated</span><br><br>
                  You can view and manage it in the Procurement module.`,
                type: "info",
                buttons: {
                  ok: {
                    text: "OK",
                    btnClass: "btn-primary",
                  },
                },
              });
            } else {
              // No auto-generated request found, show confirmation dialog
              console.log("No auto-generated request found, showing dialog");
              showRaisePurchaseRequestDialog(
                orderId,
                productId,
                speciesId,
                productName,
                quantityRequired,
                orderNo,
              );
            }
          },
          error: function (xhr, status, error) {
            // If check fails, still allow manual request
            console.error("API Error:", status, error);
            console.log("Allowing manual request despite API error");
            showRaisePurchaseRequestDialog(
              orderId,
              productId,
              speciesId,
              productName,
              quantityRequired,
              orderNo,
            );
          },
        });
      }

      // Show dialog to raise purchase request
      function showRaisePurchaseRequestDialog(
        orderId,
        productId,
        speciesId,
        productName,
        quantityRequired,
        orderNo,
      ) {
        console.log("showRaisePurchaseRequestDialog called with:", {
          orderId,
          productId,
          productName,
          quantityRequired,
          orderNo,
        });

        // Store current purchase request data
        window.currentPurchaseRequest = {
          orderId,
          productId,
          speciesId,
          productName,
          quantityRequired,
          orderNo,
        };

        // Populate order details
        const orderDetailsHtml = `
          <p><strong>Order #:</strong> ${orderNo}</p>
          <p><strong>Product:</strong> ${productName}</p>
          <p><strong>Quantity Required:</strong> ${quantityRequired} units</p>
          <p style="font-size: 0.9em; color: #666; margin-top: 10px;">
            <i class="fa-solid fa-info-circle me-2"></i>
            Recommended quantity will be calculated after checking raw material inventory.
          </p>
        `;
        $("#purchaseRequestOrderDetails").html(orderDetailsHtml);

        // Initialize quantity field with calculated value (20% buffer + initial estimate)
        const quantityWithBuffer = Math.ceil(quantityRequired * 1.2);
        $("#purchaseRequestQuantity").val(quantityWithBuffer);
        $("#purchaseRequestQuantityHint").text(
          `Calculating recommended quantity based on existing raw material inventory...`,
        );

        // Clear any cached API responses to force fresh data
        $.ajaxSetup({ cache: false });

        // Load raw materials
        $("#purchaseRequestRawMaterials").html(
          '<p style="color: #999; text-align: center;">Loading raw materials...</p>',
        );
        loadRawMaterialsForPurchaseRequest(
          productId,
          quantityRequired,
          speciesId,
        );

        console.log("About to show side panel");
        // Show the side panel using CSS animation
        $("#purchaseRequestSlideInPanel").css("right", "0");
        $("#purchaseRequestSlideInPanel").css("display", "block");
        console.log("Side panel should now be visible");
      }

      function loadRawMaterialsForPurchaseRequest(
        productId,
        quantityRequired,
        speciesId = null,
      ) {
        console.log(
          "Loading raw materials for product:",
          productId,
          "quantity:",
          quantityRequired,
          "speciesId:",
          speciesId,
        );

        // Call the panel-specific endpoint that returns ALL materials (including sufficient stock)
        $.ajax({
          url: `/api/procurement/product/raw-materials-for-panel?productId=${productId}&quantityRequired=${quantityRequired}&speciesId=${speciesId || ""}&t=${Date.now()}`,
          method: "GET",
          dataType: "json",
          cache: false,
          success: function (response) {
            console.log("Panel raw materials API response:", response);

            if (response?.data && response.data.length > 0) {
              console.log(
                "✓ Found raw materials from panel API:",
                response.data,
              );
              // Process the raw materials including those with sufficient stock
              processBOMRawMaterials(
                response.data,
                quantityRequired,
                $("#purchaseRequestRawMaterials"),
              );

              // Auto-populate the quantity field with the first raw material that needs ordering
              // Only use materials that actually need ordering (gap > 0)
              const itemsNeedingOrder = response.data.filter(
                (m) => Math.ceil(m.inventory_gap || 0) > 0,
              );

              if (itemsNeedingOrder.length > 0) {
                const firstRawMaterial = itemsNeedingOrder[0];
                const recommendedQty = Math.ceil(
                  firstRawMaterial.recommended_order_quantity || 0,
                );

                if (recommendedQty > 0) {
                  $("#purchaseRequestQuantity").val(recommendedQty);
                  $("#purchaseRequestQuantityHint").html(
                    `<small class="text-success">Auto-filled with BOM recommended quantity: ${recommendedQty} kg</small>`,
                  );

                  // Show tooltip briefly to highlight AI recommendations
                  setTimeout(() => {
                    showQuantityTooltip($("#purchaseRequestQuantity")[0]);
                    setTimeout(() => hideQuantityTooltip(), 4000); // Hide after 4 seconds
                  }, 1000);
                }
              } else {
                console.log(
                  "[RAW MATERIALS] No items need ordering - all materials have sufficient stock",
                );
                $("#purchaseRequestQuantityHint").html(
                  `<small class="text-success">✓ All raw materials are in sufficient stock</small>`,
                );
              }
            } else {
              console.warn("⚠ No raw materials found in panel response");
              // Fall back to the original logic if panel doesn't have data
              fallbackToSpeciesFiltering(
                productId,
                quantityRequired,
                speciesId,
              );
            }
          },
          error: function (xhr, status, error) {
            console.error(
              "Panel API error, falling back to species filtering:",
              status,
              error,
            );
            // Fall back to the original logic if API fails
            fallbackToSpeciesFiltering(productId, quantityRequired, speciesId);
          },
        });
      }

      // New function to process BOM-based raw materials
      function processBOMRawMaterials(
        rawMaterials,
        quantityRequired,
        container,
      ) {
        let materialsHtml =
          '<div style="display: flex; flex-direction: column; gap: 10px;">';

        // CRITICAL: Filter out items with zero inventory gap (sufficient stock)
        const itemsNeedingOrder = rawMaterials.filter((material) => {
          const inventoryGap = Math.ceil(material.inventory_gap || 0);
          return inventoryGap > 0; // Only include items with gap > 0
        });

        if (itemsNeedingOrder.length === 0) {
          materialsHtml = `
            <div style="
              padding: 20px;
              background: rgba(76, 175, 80, 0.1);
              border-radius: 6px;
              border-left: 4px solid #4CAF50;
              text-align: center;
            ">
              <i class="fa-solid fa-check-circle" style="color: #4CAF50; font-size: 24px; margin-bottom: 10px;"></i>
              <p style="color: #4CAF50; margin: 10px 0; font-weight: bold;">✓ All Raw Materials Sufficient</p>
              <small style="color: #999;">Current warehouse inventory covers all required raw materials.</small>
            </div>
          `;
          container.html(materialsHtml);
          console.log(
            "[RAW MATERIALS UI] All items have sufficient stock - showing success message",
          );

          // Grey out and disable the quantity input since nothing needs to be ordered
          $("#purchaseRequestQuantity").val(0);
          $("#purchaseRequestQuantity").prop("disabled", true);
          $("#purchaseRequestQuantity").css({
            "background-color": "#f5f5f5",
            color: "#999",
            cursor: "not-allowed",
            opacity: "0.6",
          });
          $("#purchaseRequestQuantityHint").html(
            `<small class="text-success">✓ No purchase order needed - all materials are in sufficient stock</small>`,
          );

          // Also disable the Save button
          $("#purchaseRequestCreateBtn").prop("disabled", true);
          $("#purchaseRequestCreateBtn").css({
            "background-color": "#f5f5f5",
            color: "#999",
            cursor: "not-allowed",
            opacity: "0.6",
          });

          return;
        }

        itemsNeedingOrder.forEach((material) => {
          const materialName = material.product_name || "Unknown";
          const procurementProductId = material.procurement_product_id;

          // Use the calculated values from BOM - round all to whole numbers
          const bomQuantityRequired = Math.ceil(
            material.total_quantity_required || 0,
          );
          const currentStock = Math.ceil(material.current_stock || 0);
          const inventoryGap = Math.ceil(material.inventory_gap || 0);
          const recommendedOrderQuantity = Math.ceil(
            material.recommended_order_quantity || 0,
          );
          const unitOfMeasure = material.unit_of_measure || "KG";

          // Determine status based on inventory gap
          let statusText = "Unknown";
          let statusColor = "#gray";

          if (inventoryGap <= 0) {
            statusText = "✓ Sufficient";
            statusColor = "#4CAF50"; // Green
          } else if (inventoryGap > 0) {
            statusText = "⚠ Order Needed";
            statusColor = "#FF9800"; // Orange
          }

          // Build the material card HTML
          materialsHtml += `
            <div style="
              padding: 14px;
              background: linear-gradient(135deg, rgba(98, 114, 147, 0.15) 0%, rgba(98, 114, 147, 0.08) 100%);
              border-radius: 6px;
              border-left: 4px solid #627293;
              margin-bottom: 10px;
              transition: all 0.3s ease;
              cursor: pointer;
              position: relative;
            " class="raw-material-card" onclick="selectRawMaterial(this)" data-recommended-quantity="${recommendedOrderQuantity}" onmouseover="this.style.boxShadow='0 4px 12px rgba(98, 114, 147, 0.25)'" onmouseout="this.style.boxShadow='none'">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;">
                <div style="flex: 1;">
                  <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                    <input
                      type="radio"
                      name="rawMaterial"
                      value="${procurementProductId}"
