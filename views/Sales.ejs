      function loadAllocationTableData() {
        $("#allocationTable").DataTable({
          destroy: true,
          responsive: false,
          processing: true,
          serverSide: true,
          scrollX: true,
          scrollCollapse: true,
          scrollY: "40vh",
          ordering: false,
          ajax: {
            type: "GET",
            url: "/api/order/allocation",
            error: function (xhr, error, code) {
              $("#allocationTable").DataTable().destroy();
              $("#allocationTable").DataTable({
                scrollX: true,
                ordering: false,
              });

              if (xhr["status"] == 420) {
                toastr["warning"](xhr["responseJSON"]["message"]);
              } else {
                toastr["error"](xhr["responseJSON"]["message"]);
              }
            },
            dataSrc: function (json) {
              // Flatten the orders to show each product as a separate row
              const flatData = [];

              json.data?.rows?.forEach((order) => {
                if (order.OrderProducts && order.OrderProducts.length > 0) {
                  // For each product in the order, create a new row
                  order.OrderProducts.forEach((product) => {
                    flatData.push({
                      order_id: order.id,
                      order_no: order.order_no,
                      product_name:
                        product?.Packing?.pd?.pp?.ProductMaster?.product_name ||
                        "Unknown",
                      quantity_required: product.unit,
                      allocation_status: order.allocation_status,
                      product_id: product?.Packing?.pd?.pp?.ProductMaster?.id,
                    });
                  });
                } else {
                  // Show order even if it has no products
                  flatData.push({
                    order_id: order.id,
                    order_no: order.order_no,
                    product_name: "-",
                    quantity_required: 0,
                    allocation_status: order.allocation_status,
                    product_id: null,
                  });
                }
              });

              json.iTotalRecords = flatData.length;
              json.iTotalDisplayRecords = json.data?.count || 0;

              // Return the flattened data to be displayed in the DataTable
              return flatData;
            },
          },
          columns: [
            { data: null },
            { data: "order_no" },
            { data: "product_name" },
            { data: "quantity_required" },
            { data: "product_id" },
            { data: "allocation_status" },
          ],
          columnDefs: [
            {
              targets: [0],
              className: "text-left",
              render: function (data, type, row) {
                return `<i class="fa-solid fa-eye view" style="font-size:15px;color:#f07b3f" data-toggle="tooltip" data-placement="top" title="View order details"></i>`;
              },
            },
            {
              targets: [1],
              className: "text-left",
              render: function (data, type, row) {
                return data || "-";
              },
            },
            {
              targets: [2],
              className: "text-left",
              render: function (data, type, row) {
                return data || "-";
              },
            },
            {
              targets: [3],
              className: "text-left",
              render: function (data, type, row) {
                return data || 0;
              },
            },
            {
              targets: [4],
              className: "text-left",
              render: function (data, type, row) {
                // Store product_id in data attribute for inventory lookup
                return `<span class="available-stock" data-product-id="${
                  data || ""
                }" style="cursor:pointer">
                  <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                </span>`;
              },
            },
            {
              targets: [5],
              className: "text-left",
              render: (data, type, row) => {
                const statusColor =
                  data === "Allocated" ? "text-success" : "text-danger";
                const statusIcon =
                  data === "Allocated"
                    ? "fa-circle-check"
                    : "fa-hourglass-half";
                return `<span class="${statusColor}">${data} <i class="fa-solid ${statusIcon}"></i></span>`;
              },
            },
          ],
          drawCallback: () => {
            $('[data-toggle="tooltip"]').tooltip();

            // Fetch inventory for each product
            $(".available-stock").each(function () {
              const productId = $(this).data("product-id");
              const $element = $(this);

              if (productId) {
                $.ajax({
                  url: `/api/order/check-inventory/${productId}`,
                  method: "GET",
                  dataType: "json",
                  success: function (response) {
                    const quantity = response?.data?.available_quantity || 0;
                    const badgeClass =
                      quantity > 0 ? "bg-success" : "bg-danger";
                    const quantityText =
                      quantity > 0 ? quantity : "Out of Stock";
                    $element.html(
                      `<span class="badge ${badgeClass}">${quantityText}</span>`
                    );
                  },
                  error: function (xhr) {
                    console.error("Inventory fetch error:", xhr);
                    $element.html(
                      `<span class="badge bg-secondary">Error</span>`
                    );
                  },
                });
              } else {
                $element.html(`<span class="badge bg-secondary">-</span>`);
              }
            });
          },
        });
      }

      // ========== ALLOCATION TABLE EVENT HANDLERS ==========

      // View Order Button Handler
      $(document).on(
        "click",
        ".allocation-table-container .fa-eye.view, #allocationTable .fa-eye.view",
        function (e) {
          e.preventDefault();
          e.stopPropagation();

          const row = $(this).closest("tr");
          const orderNo = row.find("td").eq(1).text(); // order_no is now in column 1
          const quantityRequired = row.find("td").eq(3).text(); // quantity_required is now in column 3

          // Fetch real order and product data from API
          $.ajax({
            url: `/api/order/allocation`,
            method: "GET",
            dataType: "json",
            success: function (response) {
              const orders = response?.data?.rows || [];
              const order = orders.find((o) => o.order_no === orderNo);

              if (!order) {
                toastr.error("Order not found!", "Error");
                return;
              }

              // Get product from the order
              let productName = "Unknown";
              let productMasterId = null;
              let purchaseInventory = 0;
              let salesInventory = 0;
              let netInventory = 0;

              if (order.OrderProducts && order.OrderProducts.length > 0) {
                const product = order.OrderProducts[0];
                productName =
                  product?.Packing?.pd?.pp?.ProductMaster?.product_name ||
                  "Unknown";
                productMasterId = product?.Packing?.pd?.pp?.ProductMaster?.id;

                // Fetch inventory for this product
                if (productMasterId) {
                  $.ajax({
                    url: `/api/order/check-inventory/${productMasterId}`,
                    method: "GET",
                    dataType: "json",
                    success: function (invResponse) {
                      purchaseInventory =
                        invResponse?.data?.available_quantity || 0;

                      // Now fetch sales inventory for the same product
                      $.ajax({
                        url: `/api/inventory/sales/all?search=${productMasterId}`,
                        method: "GET",
                        dataType: "json",
                        async: false,
                        success: function (salesResponse) {
                          if (salesResponse?.data) {
                            if (Array.isArray(salesResponse.data)) {
                              salesInventory = salesResponse.data.reduce(
                                (sum, inv) => {
                                  return sum + (inv.quantity || 0);
                                },
                                0
                              );
                            } else if (
                              salesResponse.data.quantity !== undefined
                            ) {
                              salesInventory = salesResponse.data.quantity || 0;
                            }
                          }
                        },
                        error: function () {
                          salesInventory = 0;
                        },
                      });

                      // Calculate net inventory
                      netInventory = Math.max(
                        0,
                        purchaseInventory - salesInventory
                      );

                      showOrderViewModal(
                        order,
                        productName,
                        productMasterId,
                        quantityRequired,
                        purchaseInventory,
                        salesInventory,
                        netInventory
                      );
                    },
                    error: function () {
                      showOrderViewModal(
                        order,
                        productName,
                        productMasterId,
                        quantityRequired,
                        purchaseInventory,
                        salesInventory,
                        netInventory
                      );
                    },
                  });
                } else {
                  showOrderViewModal(
                    order,
                    productName,
                    productMasterId,
                    quantityRequired,
                    purchaseInventory,
                    salesInventory,
                    netInventory
                  );
                }
              } else {
                toastr.warning("No products found in this order!", "Warning");
              }
            },
            error: function () {
              toastr.error("Failed to load order details!", "Error");
            },
          });
        }
      );

      // Display order view modal with real data
      function showOrderViewModal(
        order,
        productName,
        productMasterId,
        quantityRequired,
        purchaseInventory,
        salesInventory,
        netInventory
      ) {
        const allocationStatus = order.allocation_status;

        // Create a simple modal for viewing order details
        const modalHtml = `
          <div class="modal fade" id="allocationViewModal" tabindex="-1" role="dialog" aria-labelledby="allocationViewModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg" role="document">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="allocationViewModalLabel">Order Details - ${
                    order.order_no
                  }</h5>
