      function loadAllocationTableData() {
        console.log("📋 Loading allocation table data...");
        $("#allocationTable").DataTable({
          destroy: true,
          responsive: false,
          processing: true,
          serverSide: true,
          scrollX: true,
          scrollCollapse: true,
          scrollY: "40vh",
          ordering: false,
          ajax: {
            type: "GET",
            url: `/api/orders/allocation?t=${Date.now()}`,
            cache: false,
            error: function (xhr, error, code) {
              console.error("❌ Allocation API error:", xhr);
              $("#allocationTable").DataTable().destroy();
              $("#allocationTable").DataTable({
                scrollX: true,
                ordering: false,
              });

              if (xhr["status"] == 420) {
                toastr["warning"](xhr["responseJSON"]["message"]);
              } else {
                toastr["error"](xhr["responseJSON"]["message"]);
              }
            },
            dataSrc: function (json) {
              console.log("📊 API Response:", json);
              // Flatten the orders to show each product as a separate row
              const flatData = [];

              json.data?.rows?.forEach((order) => {
                if (order.OrderProducts && order.OrderProducts.length > 0) {
                  // For each product in the order, create a new row
                  order.OrderProducts.forEach((product) => {
                    // Handle both direct product_master_id and packing path
                    const productName =
                      product?.ProductMaster?.product_name ||
                      product?.Packing?.pd?.pp?.ProductMaster?.product_name ||
                      "Unknown";
                    const productId =
                      product?.product_master_id ||
                      product?.Packing?.pd?.pp?.ProductMaster?.id;

                    flatData.push({
                      order_id: order.id,
                      order_no: order.order_no,
                      product_name: productName,
                      quantity_required: product.quantity,
                      allocation_status: order.allocation_status,
                      product_id: productId,
                    });
                  });
                } else {
                  // Show order even if it has no products
                  flatData.push({
                    order_id: order.id,
                    order_no: order.order_no,
                    product_name: "-",
                    quantity_required: 0,
                    allocation_status: order.allocation_status,
                    product_id: null,
                  });
                }
              });

              json.iTotalRecords = flatData.length;
              json.iTotalDisplayRecords = json.data?.count || 0;

              console.log("✅ Flattened allocation data:", flatData);
              console.log(`   Total records: ${flatData.length}`);

              // Return the flattened data to be displayed in the DataTable
              return flatData;
            },
          },
          columns: [
            { data: null },
            { data: "order_no" },
            { data: "product_name" },
            { data: "quantity_required" },
            { data: "product_id" },
            { data: "allocation_status" },
          ],
          columnDefs: [
            {
              targets: [0],
              className: "text-left",
              render: function (data, type, row) {
                return `<i class="fa-solid fa-eye view" style="font-size:15px;color:#f07b3f" data-toggle="tooltip" data-placement="top" title="View order details"></i>`;
              },
            },
            {
              targets: [1],
              className: "text-left",
              render: function (data, type, row) {
                return data || "-";
              },
            },
            {
              targets: [2],
              className: "text-left",
              render: function (data, type, row) {
                return data || "-";
              },
            },
            {
              targets: [3],
              className: "text-left",
              render: function (data, type, row) {
                return `<span class="quantity-value">${data || 0}</span>`;
              },
            },
            {
              targets: [4],
              className: "text-left",
              render: function (data, type, row) {
                // Store product_id and order_id in data attributes for inventory lookup
                return `<span class="available-stock" data-product-id="${
                  data || ""
                }" data-order-id="${row?.order_id || ""}" style="cursor:pointer">
                  <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                </span>`;
              },
            },
            {
              targets: [5],
              className: "text-left",
              render: (data, type, row) => {
                // Show allocation status with appropriate styling
                let statusText = "Pending";
                let statusClass = "pending-status";
                let statusIcon = "fa-hourglass-half";

                if (data === "Allocated" || data === "ALLOCATED") {
                  statusText = "Allocated";
                  statusClass = "allocated-status";
                  statusIcon = "fa-circle-check";
                } else if (data === "Pending Purchase") {
                  statusText = "Pending Purchase";
                  statusClass = "pending-purchase-status";
                  statusIcon = "fa-shopping-cart";
                } else if (data === "Partial") {
                  statusText = "Partial";
                  statusClass = "partial-status";
                  statusIcon = "fa-clock";
                }

                return `<span class="${statusClass}">${statusText} <i class="fa-solid ${statusIcon}"></i></span>`;
              },
            },
          ],
          drawCallback: () => {
            $('[data-toggle="tooltip"]').tooltip();

            // Fetch inventory for each product and update stock display
            $(".available-stock").each(function () {
              const productId = $(this).data("product-id");
              const orderId = $(this).data("order-id");
              const $element = $(this);

              // Only fetch inventory if we have a valid product ID (UUID format)
              // UUID pattern: 8-4-4-4-12 hex digits separated by hyphens
              const uuidPattern =
                /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
              const isValidUUID =
                productId && uuidPattern.test(String(productId));

              if (isValidUUID) {
                const url = `/api/orders/check-inventory/${productId}`;

                $.ajax({
                  url: url,
                  method: "GET",
                  dataType: "json",
                  xhrFields: { withCredentials: true },
                  success: function (response) {
                    console.log("Inventory API Response:", {
                      productId,
                      response: response?.data,
                      quantity: response?.data?.available_quantity,
                      inventoryType: response?.data?.inventory_type,
                      breakdown: response?.data?.breakdown,
                    });
                    const quantity = response?.data?.available_quantity || 0;
                    const inventoryType =
                      response?.data?.inventory_type || "none";
                    const breakdown = response?.data?.breakdown || {};
                    const rawMaterialsBreakdown =
                      response?.data?.raw_materials_breakdown || [];
                    const unitOfMeasure =
                      response?.data?.unit_of_measure || "kg";

                    if ($element.hasClass("available-stock")) {
                      // Update stock display with detailed information
                      let stockText = "";
                      let shortStockText = "";
                      let badgeClass = "bg-secondary";

                      if (quantity > 0) {
                        badgeClass =
                          'style="background-color: #EA5455; color: white;"';

                        if (inventoryType === "finished_goods") {
                          stockText = `${quantity} ${unitOfMeasure} (Finished Goods)`;
                          shortStockText = `${quantity}${unitOfMeasure}`;
                          if (breakdown.sales_inventory > 0) {
                            stockText += ` - Sales: ${breakdown.sales_inventory}${unitOfMeasure}`;
                          }
                          if (breakdown.fg_inventory > 0) {
                            stockText += ` - FG: ${breakdown.fg_inventory}${unitOfMeasure}`;
                          }
                        } else if (inventoryType === "raw_materials") {
                          // For raw materials: available_quantity is yield-adjusted effective finished goods
                          const rawMaterialQty =
                            response?.data?.raw_material_details
                              ?.raw_material_quantity || 0;
                          const yieldPercent =
                            response?.data?.raw_material_details
                              ?.yield_percent || "0.00";
                          stockText = `${quantity} ${unitOfMeasure} (Effective FG from ${rawMaterialQty}kg raw @ ${yieldPercent}%)`;
                          shortStockText = `${quantity}${unitOfMeasure}`;
                        } else {
                          stockText = `${quantity} ${unitOfMeasure}`;
                          shortStockText = `${quantity}${unitOfMeasure}`;
                        }
                      } else {
                        stockText = "Out of Stock";
                        shortStockText = "0";
                        badgeClass = "bg-danger";
                      }

                      let badgeHtml = "";
                      if (badgeClass.startsWith("style=")) {
                        // Inline style
                        badgeHtml = `<span class="badge" ${badgeClass} title="${stockText}">${shortStockText}</span>`;
                      } else {
                        // CSS class
                        badgeHtml = `<span class="badge ${badgeClass}" title="${stockText}">${shortStockText}</span>`;
                      }

                      $element.html(badgeHtml);
                    }
                  },
                  error: function (xhr) {
                    console.error("Inventory fetch error:", xhr);
                    if ($element.hasClass("available-stock")) {
                      $element.html(
                        `<span class="badge bg-secondary">Error</span>`,
                      );
                    }
                  },
                });
              } else {
                // Product ID is missing or invalid - show placeholder
                if ($element.hasClass("available-stock")) {
                  $element.html(
                    `<span class="badge bg-secondary" title="Product ID not available">-</span>`,
                  );
                }
              }
            });
          },
        });
      }

      // ========== ALLOCATION TABLE EVENT HANDLERS ==========

      // View Order Button Handler
      $(document).on(
        "click",
        ".allocation-table-container .fa-eye.view, #allocationTable .fa-eye.view",
        function (e) {
          e.preventDefault();
          e.stopPropagation();

          const row = $(this).closest("tr");
          const orderNo = row.find("td").eq(1).text(); // order_no is now in column 1
          const quantityRequired = row.find("td").eq(3).text(); // quantity_required is now in column 3
          const productId = row
            .find("td")
            .eq(4)
            .find(".available-stock")
            .data("product-id"); // product_id from data attribute

          console.log(
            `[Order View] Clicked row - orderNo: ${orderNo}, quantityRequired: ${quantityRequired}, productId: ${productId}`,
          );

          // Fetch real order and product data from API
          $.ajax({
            url: `/api/orders/allocation`,
            method: "GET",
            dataType: "json",
            success: function (response) {
              const orders = response?.data?.rows || [];
              const order = orders.find((o) => o.order_no === orderNo);

              if (!order) {
                toastr.error("Order not found!", "Error");
                return;
              }

              // Get the specific product from the order that matches the clicked row
              let productName = "Unknown";
              let productMasterId = productId; // Use the product_id from the clicked row
              let speciesMasterId = null;
              let purchaseInventory = 0;
              let salesInventory = 0;
              let netInventory = 0;

              if (order.OrderProducts && order.OrderProducts.length > 0) {
                console.log(
                  `[Order View] Order has ${order.OrderProducts.length} products:`,
                  order.OrderProducts.map((p) => ({
                    product_master_id: p?.product_master_id,
                    packing_product_id: p?.Packing?.pd?.pp?.ProductMaster?.id,
                    product_name:
                      p?.ProductMaster?.product_name ||
                      p?.Packing?.pd?.pp?.ProductMaster?.product_name,
                  })),
                );

                // Find the specific product in the order that matches the product_id
                const product = order.OrderProducts?.find(
                  (p) =>
                    (p?.product_master_id ||
                      p?.Packing?.pd?.pp?.ProductMaster?.id) === productId,
                );

                console.log(
                  `[Order View] Looking for productId: ${productId}, found product:`,
                  product,
                );

                if (product) {
                  productName =
                    product?.ProductMaster?.product_name ||
                    product?.Packing?.pd?.pp?.ProductMaster?.product_name ||
                    "Unknown";

                  console.log(
                    `[Order View] Fetching product master ${productMasterId} to get species info`,
                  );

                  // Fetch the full product master with category and species
                  $.ajax({
                    url: `/api/master/product/${productMasterId}`,
                    method: "GET",
                    dataType: "json",
                    async: false,
                    success: function (prodResponse) {
                      if (prodResponse?.data) {
                        const fullProduct = prodResponse.data;
                        speciesMasterId =
                          fullProduct?.ProductCategoryMaster
                            ?.species_master_id || null;
                        console.log(
                          `[Order View] Retrieved species ID: ${speciesMasterId}`,
                        );
                      }
                    },
                    error: function (xhr, status, error) {
                      console.error(
                        `Error fetching product master ${productMasterId}:`,
                        error,
                      );
                    },
                  });

                  console.log(
                    `[Order View] Product: ${productName}, Species ID: ${speciesMasterId}`,
                  );
                  // Fetch inventory for this product
                  if (productMasterId) {
                    $.ajax({
                      url: `/api/orders/check-inventory/${productMasterId}`,
                      method: "GET",
                      dataType: "json",
                      async: false,
                      success: function (invResponse) {
                        console.log(
                          `[Order View] Purchase inventory response:`,
                          invResponse,
                        );
                        purchaseInventory =
                          invResponse?.data?.available_quantity || 0;
                        const inventoryType =
                          invResponse?.data?.inventory_type || "none";
                        console.log(
                          `[Order View] Purchase inventory: ${purchaseInventory}, Type: ${inventoryType}`,
                        );

                        // Now fetch sales inventory for the same product (for display purposes)
                        $.ajax({
                          url: `/api/inventory/sales/all?search=${productMasterId}`,
                          method: "GET",
                          dataType: "json",
                          async: false,
                          success: function (salesResponse) {
                            console.log(
                              `[Order View] Sales inventory response:`,
                              salesResponse,
                            );
                            if (salesResponse?.data) {
                              if (Array.isArray(salesResponse.data)) {
                                salesInventory = salesResponse.data.reduce(
                                  (sum, inv) => {
                                    return sum + (inv.quantity || 0);
                                  },
                                  0,
                                );
                              } else if (
                                salesResponse.data.quantity !== undefined
                              ) {
                                salesInventory =
                                  salesResponse.data.quantity || 0;
                              }
                            }
                            console.log(
                              `[Order View] Sales inventory: ${salesInventory}`,
                            );
                          },
                          error: function (xhr, status, error) {
                            console.error(
                              `[Order View] Error fetching sales inventory:`,
                              status,
                              error,
                            );
                            salesInventory = 0;
                          },
                        });

                        // Calculate net inventory based on inventory type
                        if (inventoryType === "finished_goods") {
                          // For processed products: available_quantity is already unallocated FG stock
                          netInventory = purchaseInventory; // No subtraction needed
                          // Display: Raw Materials = 0, Finished Goods = available stock
                          const tempPurchase = purchaseInventory;
                          purchaseInventory = 0; // Raw materials
                          salesInventory = tempPurchase; // Finished goods
                        } else if (inventoryType === "raw_materials") {
                          // For raw materials: Get TOTAL raw material quantity for status check
                          const totalRawMaterialQty =
                            invResponse?.data?.raw_material_details
                              ?.raw_material_quantity || purchaseInventory;
                          // Use total raw material for status (not yield-adjusted)
                          netInventory = totalRawMaterialQty;
                          salesInventory = 0; // No finished goods for raw materials
                          // Update purchaseInventory to show total raw material stock (not reserved)
                          purchaseInventory = totalRawMaterialQty;
                        } else {
                          // Fallback
                          netInventory = Math.max(
                            0,
                            purchaseInventory - salesInventory,
                          );
                        }

                        console.log(
                          `[Order View] Final values - Raw Materials: ${purchaseInventory}, Finished Goods: ${salesInventory}, Net: ${netInventory}`,
                        );

                        showOrderViewModal(
                          order,
                          productName,
                          productMasterId,
                          speciesMasterId,
                          quantityRequired,
                          purchaseInventory,
                          salesInventory,
                          netInventory,
                        );
                      },
                      error: function (xhr, status, error) {
                        console.error(
                          `[Order View] Error fetching purchase inventory:`,
                          status,
                          error,
                        );
                        showOrderViewModal(
                          order,
                          productName,
                          productMasterId,
                          speciesMasterId,
                          quantityRequired,
                          purchaseInventory,
                          salesInventory,
                          netInventory,
                        );
                      },
                    });
                  } else {
                    showOrderViewModal(
                      order,
                      productName,
                      productMasterId,
                      speciesMasterId,
                      quantityRequired,
                      purchaseInventory,
                      salesInventory,
                      netInventory,
                    );
                  }
                } else {
                  toastr.warning("Product not found in this order!", "Warning");
                }
              } else {
                toastr.warning("No products found in this order!", "Warning");
              }
            },
            error: function () {
              toastr.error("Failed to load order details!", "Error");
            },
          });
        },
      );

