      // Load product-specific raw materials from database
      function loadProductSpecificMaterials(
        speciesName,
        productName,
        container,
        productId,
        quantityRequired
      ) {
        // Strategy: Query procurement products for the specific product_master_id
        // Display the FIRST material with auto-calculated quantity (20% buffer)
        // Check inventory availability

        console.log("DEBUG: Loading materials for product ID:", productId);

        // First, try to fetch procurement products for this specific product
        $.ajax({
          url: `/api/procurement/product?product_master_id=${productId}`,
          method: "GET",
          dataType: "json",
          success: function (response) {
            const productSpecificMaterials = response?.data?.rows || [];

            console.log(
              "DEBUG: Product-specific materials found:",
              productSpecificMaterials
            );

            if (
              productSpecificMaterials &&
              productSpecificMaterials.length > 0
            ) {
              // Filter to only UNPROCESSED materials
              const unprocessedMaterials = productSpecificMaterials.filter(
                (mat) => mat.procurement_product_type === "UNPROCESSED"
              );

              if (unprocessedMaterials.length > 0) {
                console.log(
                  "Found product-specific UNPROCESSED materials:",
                  unprocessedMaterials
                );

                // Use ONLY the first material
                const material = unprocessedMaterials[0];
                let displayName =
                  material?.ProductMaster?.product_name ||
                  material.procurement_purchaser ||
                  "Raw Material";

                console.log("Material mapping:", {
                  id: material.id,
                  product_name: material?.ProductMaster?.product_name,
                  procurement_purchaser: material.procurement_purchaser,
                  final_name: displayName,
                });

                // Fetch inventory for this procurement product
                $.ajax({
                  url: `/api/inventory/purchase/all`,
                  method: "GET",
                  dataType: "json",
                  success: function (inventoryResponse) {
                    const inventories = inventoryResponse?.data || [];
                    const materialInventory = inventories.find(
                      (inv) =>
                        inv.procurement_product_id === material.id &&
                        inv.is_active === true
                    );
                    const availableStock = materialInventory?.quantity || 0;

                    console.log("Inventory for material:", {
                      material_id: material.id,
                      available_stock: availableStock,
                    });

                    renderSingleRawMaterial(
                      material.id,
                      displayName,
                      quantityRequired,
                      container,
                      availableStock
                    );
                  },
                  error: function (xhr) {
                    console.error("Error fetching inventory:", xhr);
                    // Render without inventory data
                    renderSingleRawMaterial(
                      material.id,
                      displayName,
                      quantityRequired,
                      container,
                      0
                    );
                  },
                });
                return;
              }
            }

            // If no product-specific materials, fall back to all UNPROCESSED
            console.log(
              "No product-specific materials found, trying all UNPROCESSED materials"
            );
            loadUnprocessedMaterials(container, quantityRequired);
          },
          error: function (xhr) {
            console.error("Error fetching product-specific materials:", xhr);
            loadUnprocessedMaterials(container, quantityRequired);
          },
        });
      }

      // Load unprocessed materials
      function loadUnprocessedMaterials(container, quantityRequired) {
        $.ajax({
          url: "/api/procurement/product?procurement_product_type=UNPROCESSED",
          method: "GET",
          dataType: "json",
          success: function (response) {
            const procurementProducts = response?.data?.rows || [];

            if (procurementProducts && procurementProducts.length > 0) {
              console.log("Found unprocessed materials:", procurementProducts);

              // Use ONLY the first material
              const material = procurementProducts[0];
              let displayName =
                material?.ProductMaster?.product_name ||
                material.procurement_purchaser ||
                "Raw Material";

              console.log("Using unprocessed material:", {
                id: material.id,
                name: displayName,
              });

              // Fetch inventory for this procurement product
              $.ajax({
                url: `/api/inventory/purchase/all`,
                method: "GET",
                dataType: "json",
                success: function (inventoryResponse) {
                  const inventories = inventoryResponse?.data || [];
                  const materialInventory = inventories.find(
                    (inv) =>
                      inv.procurement_product_id === material.id &&
                      inv.is_active === true
                  );
                  const availableStock = materialInventory?.quantity || 0;

                  console.log("Inventory for unprocessed material:", {
                    material_id: material.id,
                    available_stock: availableStock,
                  });

                  renderSingleRawMaterial(
                    material.id,
                    displayName,
                    quantityRequired,
                    container,
                    availableStock
                  );
                },
                error: function (xhr) {
                  console.error("Error fetching inventory:", xhr);
                  // Render without inventory data
                  renderSingleRawMaterial(
                    material.id,
                    displayName,
                    quantityRequired,
                    container,
                    0
                  );
                },
              });
            } else {
              console.log(
                "No unprocessed materials found, showing fallback materials"
              );
              showFallbackMaterial(container, quantityRequired);
            }
          },
          error: function (xhr) {
            console.error("Error fetching unprocessed materials:", xhr);
            showFallbackMaterial(container, quantityRequired);
          },
        });
      }

      // Render single raw material with auto-calculated quantity
      function renderSingleRawMaterial(
        materialId,
        materialName,
        quantityRequired,
        container,
        availableStock = 0
      ) {
        // Calculate quantity with 20% buffer
        const bufferedQuantity = parseFloat(quantityRequired) * 1.2;
        const roundedQuantity = Math.ceil(bufferedQuantity);
        const hasStock = availableStock >= roundedQuantity;
        const stockColor = hasStock ? "#28a745" : "#dc3545";
        const stockStatus = hasStock ? "✓ Available" : "✗ Out of Stock";

        // Calculate quantity to purchase after deducting available stock
        const quantityToPurchase = Math.max(
          0,
          roundedQuantity - availableStock
        );

        const html = `
          <div style="padding: 10px; background: #f9f9f9; border-radius: 3px;">
            <div style="margin-bottom: 10px;">
              <strong>Material:</strong> ${materialName}
            </div>
            <div style="margin-bottom: 10px; padding: 8px; background: #fff; border-radius: 3px; border-left: 3px solid ${stockColor};">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Available Stock:</strong> ${availableStock} units</span>
                <span style="color: ${stockColor}; font-weight: bold;">${stockStatus}</span>
              </div>
            </div>
            <div style="margin-bottom: 10px; padding: 8px; background: #f0f8ff; border-radius: 3px; border-left: 3px solid #0066cc;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Quantity Required (with 20% buffer):</strong> ${roundedQuantity} units</span>
              </div>
            </div>
            <div style="margin-bottom: 10px; padding: 8px; background: #fff3cd; border-radius: 3px; border-left: 3px solid #ffc107;">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span><strong>Quantity to Purchase (after stock deduction):</strong> ${quantityToPurchase} units</span>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <label style="margin: 0;">Adjust Quantity to Purchase:</label>
              <input 
                type="number" 
                id="single-raw-material-qty" 
                class="form-control form-control-sm" 
                value="${quantityToPurchase}" 
                min="0" 
                step="0.5"
                style="width: 100px;"
              >
              <span style="color: #666; font-size: 0.9em;">Units</span>
            </div>
            ${
              !hasStock
                ? '<div style="margin-top: 10px; color: #dc3545; font-weight: bold;">⚠️ Current stock insufficient to fulfill complete requirement!</div>'
                : '<div style="margin-top: 10px; color: #28a745; font-weight: bold;">✓ Sufficient stock available - no additional purchase needed!</div>'
            }
            <input type="hidden" id="single-raw-material-id" value="${materialId}">
            <input type="hidden" id="single-raw-material-name" value="${materialName}">
            <input type="hidden" id="single-raw-material-available-stock" value="${availableStock}">
            <input type="hidden" id="single-raw-material-quantity-required" value="${roundedQuantity}">
          </div>
        `;

        container.html(html);
      }

      // Render raw materials
      function renderRawMaterials(materialsList, container) {
        let html = "";
        materialsList.forEach((material) => {
          html += `
            <div style="margin-bottom: 10px; padding: 8px; background: #f9f9f9; border-radius: 3px;">
              <label style="display: flex; align-items: center; cursor: pointer; margin: 0;">
                <input type="checkbox" class="raw-material-checkbox" value="${material.id}" data-name="${material.name}" style="margin-right: 10px;">
                <span style="flex: 1;">${material.name}</span>
                <input type="number" class="form-control form-control-sm raw-material-qty" placeholder="Qty" value="" style="width: 80px; margin-left: 10px;" min="0" step="0.5">
              </label>
            </div>
          `;
        });

        container.html(html);
      }

