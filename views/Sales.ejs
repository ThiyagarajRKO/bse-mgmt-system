      // Purchase Request Panel Handlers
      $("#closePurchaseRequestPanelBtn").click(function () {
        closeSlidePanel("purchaseRequestSlideInPanel");
        window.currentPurchaseRequest = null;
      });

      $("#purchaseRequestCancelBtn").click(function () {
        $("#closePurchaseRequestPanelBtn").click();
      });

      $("#purchaseRequestCreateBtn").click(function () {
        const selectedMaterial = $('input[name="rawMaterial"]:checked').val();
        const selectedMaterialName = $(
          'input[name="rawMaterial"]:checked',
        ).data("material-name");
        const productMasterId = $('input[name="rawMaterial"]:checked').data(
          "product-master-id",
        );
        let quantityToOrder = parseFloat($("#purchaseRequestQuantity").val());

        // REQUIREMENT: Quantity to order should equal Order Needed (recommended quantity)
        // Get the recommended quantity from the selected raw material card
        const selectedCard =
          document.querySelector('.raw-material-card[style*="28a745"]') ||
          document.querySelector(
            '.raw-material-card:has(input[type="radio"]:checked)',
          );
        const recommendedQuantity = selectedCard
          ? parseFloat(selectedCard.getAttribute("data-recommended-quantity"))
          : null;

        // If recommended quantity is available, use it as the order quantity
        if (recommendedQuantity && recommendedQuantity > 0) {
          quantityToOrder = recommendedQuantity;
          $("#purchaseRequestQuantity").val(quantityToOrder);
        }

        if (!selectedMaterial) {
          toastr.warning("Please select a raw material", "Info");
          return;
        }

        if (!quantityToOrder || quantityToOrder <= 0) {
          toastr.warning("Please enter a valid quantity", "Info");
          return;
        }

        // Create purchase request
        const req = window.currentPurchaseRequest;
        const materialData = {
          id: selectedMaterial,
          procurement_product_name: selectedMaterialName,
          product_master_id: productMasterId,
          quantity: quantityToOrder,
        };

        generatePurchaseRequest(
          req.orderId,
          req.productId,
          req.quantityRequired,
          req.orderNo,
          null,
          null,
          [materialData],
        );

        // Close the panel after successful creation
        $("#closePurchaseRequestPanelBtn").click();
      });

      // Function to handle raw material card selection
      function selectRawMaterial(cardElement) {
        // Find the radio button inside this card and select it
        const radioButton = cardElement.querySelector(
          'input[type="radio"][name="rawMaterial"]',
        );
        if (radioButton) {
          radioButton.checked = true;

          // Get the recommended quantity from the data attribute
          const recommendedQuantity = cardElement.getAttribute(
            "data-recommended-quantity",
          );

          // Auto-populate the quantity input field with the recommended quantity
          if (recommendedQuantity && recommendedQuantity > 0) {
            $("#purchaseRequestQuantity").val(recommendedQuantity);
            // Update the hint text
            $("#purchaseRequestQuantityHint").html(
              `<small class="text-success">Auto-filled with recommended quantity: ${recommendedQuantity} kg</small>`,
            );
          }

          // Remove selection styling from all cards
          document.querySelectorAll(".raw-material-card").forEach((card) => {
            card.style.borderLeftColor = "#627293";
            card.style.background =
              "linear-gradient(135deg, rgba(98, 114, 147, 0.15) 0%, rgba(98, 114, 147, 0.08) 100%)";
          });

          // Add selection styling to clicked card
          cardElement.style.borderLeftColor = "#28a745";
          cardElement.style.background =
            "linear-gradient(135deg, rgba(40, 167, 69, 0.15) 0%, rgba(40, 167, 69, 0.08) 100%)";

          // Update quantity field with recommended value and show tooltip
          if (recommendedQuantity && recommendedQuantity > 0) {
            $("#purchaseRequestQuantity").val(recommendedQuantity);
            $("#purchaseRequestQuantityHint").html(
              `<small class="text-success">Auto-filled with BOM recommended quantity: ${recommendedQuantity} kg</small>`,
            );

            // Show tooltip briefly to highlight the recommendation
            setTimeout(() => {
              showQuantityTooltip($("#purchaseRequestQuantity")[0]);
              setTimeout(() => hideQuantityTooltip(), 3000); // Hide after 3 seconds
            }, 500);
          }
        }
      }

      // Clear quantity hint when user manually changes the quantity
      $("#purchaseRequestQuantity").on("input", function () {
        const currentVal = $(this).val();
        if (currentVal && currentVal.trim() !== "") {
          $("#purchaseRequestQuantityHint").html(
            `<small class="text-info">Custom quantity entered: ${currentVal} kg</small>`,
          );
        } else {
          $("#purchaseRequestQuantityHint").html("");
        }
      });

      // AI Tooltip functions for quantity field - Attach to window for global access
      window.showQuantityTooltip = function (inputElement) {
        const currentValue = parseFloat($(inputElement).val()) || 0;
        const tooltip = $("#quantityTooltip");

        // Get current BOM data if available
        const selectedMaterial = $('input[name="rawMaterial"]:checked');
        let tooltipContent = "";

        if (selectedMaterial.length > 0) {
          const materialCard = selectedMaterial.closest(".raw-material-card");
          const recommendedQty =
            parseFloat(materialCard.attr("data-recommended-quantity")) || 0;
          const requiredQty =
            parseFloat(
              materialCard.find(".badge").first().text().replace(" kg", ""),
            ) || 0;
          const currentStock =
            parseFloat(
              materialCard.find(".badge").eq(1).text().replace(" kg", ""),
            ) || 0;

          // Calculate AI recommendations
          const shortage = Math.max(0, requiredQty - currentStock);
          const buffer20 = Math.ceil(requiredQty * 0.2);
          const buffer10 = Math.ceil(requiredQty * 0.1);
          const optimalOrder = shortage + buffer10;

          tooltipContent = `
            <div style="line-height: 1.4;">
              <strong>🎯 AI Quantity Analysis</strong><br>
              <hr style="border-color: #555; margin: 8px 0;">
              <strong>Current Input:</strong> ${currentValue} kg<br>
              <strong>BOM Required:</strong> ${requiredQty} kg<br>
              <strong>Current Stock:</strong> ${currentStock} kg<br>
              <strong>Shortage Gap:</strong> ${shortage} kg<br>
              <hr style="border-color: #555; margin: 8px 0;">
              <strong>📊 Recommendations:</strong><br>
              • <strong>Minimum:</strong> ${shortage} kg (covers shortage only)<br>
              • <strong>Conservative:</strong> ${optimalOrder} kg (+10% buffer)<br>
              • <strong>Safe:</strong> ${shortage + buffer20} kg (+20% buffer)<br>
              • <strong>BOM Optimal:</strong> ${recommendedQty} kg (calculated)<br>
              <hr style="border-color: #555; margin: 8px 0;">
              <strong>💡 AI Insights:</strong><br>
              ${
                currentValue < shortage
                  ? "⚠️ Below minimum requirement!"
                  : currentValue < optimalOrder
                    ? "✅ Adequate but consider buffer"
                    : currentValue <= recommendedQty
                      ? "🎯 Optimal quantity"
                      : "📈 Above recommended (may increase costs)"
              }
            </div>
          `;
        } else {
          tooltipContent = `
            <div style="line-height: 1.4;">
              <strong>🎯 AI Quantity Guidance</strong><br>
              <hr style="border-color: #555; margin: 8px 0;">
              <strong>Current Input:</strong> ${currentValue} kg<br>
              <br>
              <strong>💡 Tips:</strong><br>
              • Select a raw material first for detailed analysis<br>
              • Consider 10-20% buffer for safety stock<br>
              • Factor in supplier minimums and lead times<br>
              • Balance inventory costs vs. stockout risks<br>
              <hr style="border-color: #555; margin: 8px 0;">
              <strong>📈 Best Practices:</strong><br>
              • Order in economic quantities<br>
              • Maintain 2-4 weeks of safety stock<br>
              • Consider seasonal demand variations
            </div>
          `;
        }

        tooltip.html(tooltipContent);

        // Position tooltip near the input
        const rect = inputElement.getBoundingClientRect();
        tooltip.css({
          top: rect.bottom + 5 + "px",
          left: rect.left + "px",
          display: "block",
        });
      };

      window.hideQuantityTooltip = function () {
        $("#quantityTooltip").hide();
      };

