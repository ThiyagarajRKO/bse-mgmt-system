      // Helper function to load raw materials by species ID
      function loadRawMaterialsBySpecies(
        speciesMasterId,
        quantityRequired,
        container,
        productId = null,
      ) {
        console.log(
          `[loadRawMaterialsBySpecies] Loading materials for species: ${speciesMasterId}, productId: ${productId}`,
        );

        let apiUrl;
        if (productId) {
          // Priority: Use BOM-filtered endpoint when product ID is available
          apiUrl = `/api/inventory/purchase?start=0&length=1000&procurement_product_type=UNPROCESSED&finished_product_id=${productId}`;
          console.log(
            "✓ Using BOM-filtered endpoint for product. Fetching raw materials with URL:",
            apiUrl,
          );
        } else if (speciesMasterId) {
          apiUrl = `/api/inventory/purchase/by-species/${speciesMasterId}?start=0&length=1000`;
          console.log(
            "✓ Using species-filtered endpoint. Fetching raw materials with URL:",
            apiUrl,
          );
        } else {
          // Fallback to general raw materials endpoint when no product or species is available
          apiUrl = `/api/inventory/purchase?start=0&length=1000&procurement_product_type=UNPROCESSED`;
          console.warn(
            "⚠ No product or species ID provided. Falling back to general raw materials endpoint:",
            apiUrl,
          );
        }

        $.ajax({
          url: apiUrl,
          method: "GET",
          dataType: "json",
          timeout: 5000,
          success: function (response) {
            console.log("Procurement products API response:", response);
            let rawMaterials = [];

            if (response?.data) {
              if (response.data.rows && Array.isArray(response.data.rows)) {
                rawMaterials = response.data.rows;
              } else if (Array.isArray(response.data)) {
                rawMaterials = response.data;
              } else if (typeof response.data === "object") {
                rawMaterials = [response.data];
              }
            }

            if (speciesMasterId) {
              console.log(
                `✓ Species-filtered raw materials found: ${rawMaterials.length} (for species ${speciesMasterId})`,
              );
            } else {
              console.warn(
                `⚠ NO FILTER - ALL raw materials returned: ${rawMaterials.length}`,
              );
            }

            if (rawMaterials.length === 0) {
              // If no species-specific raw materials found, try to filter by product ID
              if (productId) {
                console.warn(
                  `⚠ No raw materials found for species ${speciesMasterId}. Trying to filter by product ID ${productId}.`,
                );
                // Try filtering by the specific product ID
                $.ajax({
                  url: `/api/inventory/purchase?start=0&length=1000&procurement_product_type=UNPROCESSED&finished_product_id=${productId}`,
                  method: "GET",
                  dataType: "json",
                  timeout: 5000,
                  success: function (productResponse) {
                    console.log(
                      "Product-filtered API response:",
                      productResponse,
                    );
                    let productMaterials = [];

                    if (productResponse?.data) {
                      if (
                        productResponse.data.rows &&
                        Array.isArray(productResponse.data.rows)
                      ) {
                        productMaterials = productResponse.data.rows;
                      } else if (Array.isArray(productResponse.data)) {
                        productMaterials = productResponse.data;
                      } else if (typeof productResponse.data === "object") {
                        productMaterials = [productResponse.data];
                      }
                    }

                    console.log(
                      `Product-filtered: Found ${productMaterials.length} raw materials for product ${productId}`,
                    );

                    if (productMaterials.length === 0) {
                      container.html(
                        '<p style="color: #d32f2f; text-align: center;">No raw materials found for this product</p>',
                      );
                      return;
                    }

                    // Process the product-filtered materials
                    processRawMaterials(
                      productMaterials,
                      quantityRequired,
                      container,
                    );
                  },
                  error: function (xhr, status, error) {
                    console.error("Product-filtered API error:", status, error);
                    container.html(
                      '<p style="color: #d32f2f; text-align: center;">Error loading raw materials: ' +
                        error +
                        "</p>",
                    );
                  },
                });
              } else {
                container.html(
                  '<p style="color: #d32f2f; text-align: center;">No raw materials found for this product</p>',
                );
              }
              return;
            }

            // Process the found materials
            processRawMaterials(rawMaterials, quantityRequired, container);
          },
          error: function (xhr, status, error) {
            console.error(
              "Error fetching procurement products:",
              status,
              error,
            );
            container.html(
              '<p style="color: #d32f2f; text-align: center;">Error loading raw materials: ' +
                error +
                "</p>",
            );
          },
        });
      }

