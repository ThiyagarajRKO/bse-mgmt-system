                // Submit purchase request to the new Purchase Request endpoint
                $.ajax({
                  url: "/api/procurement/product/procurement-requests",
                  method: "POST",
                  data: JSON.stringify({
                    order_id: orderId,
                    product_master_id: selectedRawMaterial,
                    supplier_master_id: supplierId,
                    procurement_quantity: parseInt(purchaseQuantity),
                    procurement_price: 0, // Will be filled in procurement module
