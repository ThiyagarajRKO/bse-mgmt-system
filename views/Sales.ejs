      function loadPaymentCustomers() {
        try {
          $("#paymentCustomerNames").select2({
            placeholder: "Choose a customer",
            allowClear: true,
            ajax: {
              url: "/api/master/customer",
              data: (params) => {
                params.page = params.page || 1;
                params.length = 25;
                params.start = (params.page - 1) * params.length;

                let query = {
                  search: params.term,
                  start: params.start,
                  length: params.length,
                };

                // Query parameters will be ?search=[term]&page=[page]
                return query;
              },
              processResults: (data, params) => {
                return {
                  results: $.map(data?.data?.rows, function (item) {
                    return {
                      id: item.id,
                      text: item.customer_name,
                    };
                  }),
                  pagination: {
                    more: params.page * params.length < data?.data?.count,
                  },
                };
              },
            },
          });

          // Clearing selected value
          $("#paymentCustomerNames").val(null).trigger("change");
        } catch (err) {
          toastr["error"](err?.message);
        }
      }

      $(document).on("change", "#paymentCustomerNames", (e) => {
