      // Function to generate purchase request
      function generatePurchaseRequest(
        orderId,
        productId,
        quantityRequired,
        orderNo,
        supplierId,
        unitId,
        rawMaterials = [],
      ) {
        // Show loading toast
        toastr.info("Generating purchase request...", "Please Wait");

        // Get default supplier and unit if not provided
        let defaultSupplierId = supplierId;
        let defaultUnitId = unitId;

        // If supplier or unit are not provided, fetch defaults
        if (!defaultSupplierId || !defaultUnitId) {
          // Fetch first supplier and unit as defaults
          $.ajax({
            url: "/api/master/supplier",
            method: "GET",
            dataType: "json",
            success: function (response) {
              if (response?.data?.rows && response.data.rows.length > 0) {
                defaultSupplierId = response.data.rows[0].id;
              }
              // Fetch unit
              $.ajax({
                url: "/api/master/unit/dropdown",
                method: "GET",
                dataType: "json",
                success: function (unitResponse) {
                  if (
                    unitResponse?.data?.rows &&
                    unitResponse.data.rows.length > 0
                  ) {
                    defaultUnitId = unitResponse.data.rows[0].id;
                  }
                  // Now create the purchase requests
                  createPurchaseRequests(
                    rawMaterials,
                    productId,
                    quantityRequired,
                    orderNo,
                    defaultSupplierId,
                    defaultUnitId,
                  );
                },
                error: function () {
                  toastr.error("Failed to load units!", "Error");
                },
              });
            },
            error: function () {
              toastr.error("Failed to load suppliers!", "Error");
            },
          });
        } else {
          // Use provided supplier and unit
          createPurchaseRequests(
            rawMaterials,
            productId,
            quantityRequired,
            orderNo,
            defaultSupplierId,
            defaultUnitId,
          );
        }
      }

      // Helper function to create purchase requests
      function createPurchaseRequests(
        rawMaterials,
        productId,
        quantityRequired,
        orderNo,
        supplierId,
        unitId,
      ) {
        const procurementDate = new Date().toISOString().split("T")[0];
        let successCount = 0;
        let totalCount = rawMaterials.length;

        // If raw materials are provided, create separate purchase requests for each
        if (rawMaterials && rawMaterials.length > 0) {
          rawMaterials.forEach((material) => {
            const materialQuantity = parseFloat(material.quantity) || 0;
            // Use the quantity as-is (no additional buffer since user has already specified the final quantity)
            const materialRounded = Math.ceil(materialQuantity);

            const procurementData = {
              procurement_date: procurementDate,
              product_master_id: String(
                material.product_master_id || productId,
              ),
              supplier_master_id: String(supplierId),
              unit_master_id: String(unitId),
              procurement_product_type: "UNPROCESSED",
              procurement_quantity: materialRounded,
              procurement_price: 0, // Default price, can be updated later
              procurement_purchaser: `System Auto-Generated - ${
                material.procurement_product_name || "Unknown"
              }`,
            };

            console.log(
              "Creating procurement request with data:",
              procurementData,
            );

            $.ajax({
              url: "/api/procurement/product",
              method: "POST",
              contentType: "application/json",
              data: JSON.stringify(procurementData),
              success: function (response) {
                successCount++;

                const action = response?.data?.action || "created";
                const updatedQuantity = response?.data?.updatedQuantity;

                if (action === "updated") {
                  console.log(
                    `Purchase request updated for material ${material.id}: quantity appended to ${updatedQuantity} units`,
                  );
                } else {
                  console.log(
                    `Purchase request created for material ${material.id}: ${materialRounded} units`,
                  );
                }

                // Refresh raw materials to update available stock for subsequent purchases
                console.log(
                  "[REFRESH] Refreshing raw materials after successful purchase creation...",
                  "action:",
                  action,
                  "updatedQuantity:",
                  updatedQuantity,
                );
                if (window.currentPurchaseRequest) {
                  setTimeout(() => {
                    // Clear the container completely first
                    console.log("[REFRESH] Clearing container...");
                    $("#purchaseRequestRawMaterials")
                      .empty()
                      .html(
                        '<p style="color: #999; text-align: center;">✓ Refreshing inventory... (just ordered ' +
                          materialRounded +
                          " units)</p>",
                      );

                    // Then reload with fresh data
                    console.log(
                      "[REFRESH] Calling loadRawMaterialsForPurchaseRequest with productId:",
                      window.currentPurchaseRequest.productId,
                      "quantityRequired:",
                      window.currentPurchaseRequest.quantityRequired,
                      "speciesId:",
                      window.currentPurchaseRequest.speciesId,
                    );
                    loadRawMaterialsForPurchaseRequest(
                      window.currentPurchaseRequest.productId,
                      window.currentPurchaseRequest.quantityRequired,
                      window.currentPurchaseRequest.speciesId,
                    );
                  }, 1200); // Increased delay to allow DB to fully sync
                }

                if (successCount === totalCount) {
                  // All materials created/updated successfully
                  const actionText =
                    rawMaterials.some(
                      (m, idx) =>
                        response?.data?.action === "updated" && idx === 0,
                    ) && response?.data?.action === "updated"
                      ? "updated/appended"
                      : "created";

                  toastr.success(
                    `Purchase requests ${actionText} successfully!<br>
                    <strong>${rawMaterials
                      .map(
                        (m) =>
                          `${m.procurement_product_name}: ${Math.ceil(m.quantity)} units ordered`,
                      )
                      .join("<br>")}</strong>`,
                    "Success",
                  );

                  setTimeout(() => {
                    loadAllocationTableData();
                  }, 1500);
                }
              },
              error: function (xhr) {
                let errorMsg = "Failed to generate purchase request!";
                if (xhr.responseJSON && xhr.responseJSON.message) {
                  errorMsg = xhr.responseJSON.message;
                }
                toastr.error(
                  `${material.procurement_product_name}: ${errorMsg}`,
                  "Error",
                );
              },
            });
          });
        }
      }

