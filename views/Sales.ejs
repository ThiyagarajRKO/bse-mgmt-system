      // Raise Purchase Request Button Handler
      $(document).on("click", "#raisePurchaseRequestBtn", function (e) {
        e.preventDefault();
        e.stopPropagation();

        console.log("Raise Purchase Request button clicked");

        // Close the modal first
        $("#allocationViewModal").modal("hide");

        const orderId = $(this).data("order-id");
        const productId = $(this).data("product-id");
        const quantityRequired = $(this).data("quantity");
        const orderNo = $(this).data("order-no");

        console.log("Button data:", {
          orderId,
          productId,
          quantityRequired,
          orderNo,
        });

        // Validate data
        if (!productId || productId === "null" || productId === null) {
          toastr.error(
            "Product ID not found. Cannot raise purchase request.",
            "Error"
          );
          console.error("Invalid productId:", productId);
          return;
        }

        if (!quantityRequired || quantityRequired <= 0) {
          toastr.error(
            "Invalid quantity. Please check the order details.",
            "Error"
          );
          return;
        }

        // Small delay to ensure modal is closed before showing side panel
        setTimeout(() => {
          // First, check if a purchase request has already been auto-generated
          checkExistingPurchaseRequest(
            orderId,
            productId,
            quantityRequired,
            orderNo
          );
        }, 300);
      });

      // Check if purchase request already exists
      function checkExistingPurchaseRequest(
        orderId,
        productId,
        quantityRequired,
        orderNo
      ) {
        console.log(
          "Checking existing purchase request for productId:",
          productId
        );

        $.ajax({
          url: `/api/procurement/product?product_master_id=${productId}`,
          method: "GET",
          dataType: "json",
          success: function (response) {
            console.log("API Response:", response);
            const products = response?.data?.rows || [];

            // Check if there's any procurement product for this product with auto-generated note
            const autoGenerated = products.some(
              (prod) =>
                prod.procurement_purchaser &&
                prod.procurement_purchaser.includes("System Auto-Generated")
            );

            if (autoGenerated) {
              $.alert({
                title: "Purchase Request Already Exists",
                content: `A purchase request for this product has already been automatically generated.<br><br>
                  <strong>Product ID:</strong> ${productId}<br>
                  <strong>Status:</strong> <span class="badge badge-info">Auto-Generated</span><br><br>
                  You can view and manage it in the Procurement module.`,
                type: "info",
                buttons: {
                  ok: {
                    text: "OK",
                    btnClass: "btn-primary",
                  },
                },
              });
            } else {
              // No auto-generated request found, show confirmation dialog
              console.log("No auto-generated request found, showing dialog");
              showRaisePurchaseRequestDialog(
                orderId,
                productId,
                quantityRequired,
                orderNo
              );
            }
          },
          error: function (xhr, status, error) {
            // If check fails, still allow manual request
            console.error("API Error:", status, error);
            console.log("Allowing manual request despite API error");
            showRaisePurchaseRequestDialog(
              orderId,
              productId,
              quantityRequired,
              orderNo
            );
          },
        });
      }

      // Show dialog to raise purchase request
      function showRaisePurchaseRequestDialog(
        orderId,
        productId,
        quantityRequired,
        orderNo
      ) {
        console.log("showRaisePurchaseRequestDialog called with:", {
          orderId,
          productId,
          quantityRequired,
          orderNo,
        });

        // Store current purchase request data
        window.currentPurchaseRequest = {
          orderId,
          productId,
          quantityRequired,
          orderNo,
        };

        // Populate order details
        const orderDetailsHtml = `
          <p><strong>Order #:</strong> ${orderNo}</p>
          <p><strong>Product ID:</strong> ${productId}</p>
          <p><strong>Quantity Required:</strong> ${quantityRequired} units</p>
          <p style="font-size: 0.9em; color: #666; margin-top: 10px;">
            <i class="fa-solid fa-info-circle me-2"></i>
            A 20% buffer will be added to the order quantity for safety stock.
          </p>
        `;
        $("#purchaseRequestOrderDetails").html(orderDetailsHtml);

        // Initialize quantity field with calculated value (20% buffer)
        const quantityWithBuffer = Math.ceil(quantityRequired * 1.2);
        $("#purchaseRequestQuantity").val(quantityWithBuffer);
        $("#purchaseRequestQuantityHint").text(
          `Recommended: ${quantityWithBuffer} units (includes 20% buffer)`
