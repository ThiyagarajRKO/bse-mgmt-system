        loadOrdersProductTableData(view_order_id);

        // Load order tracking data for timeline
        console.log("Loading tracking data for order:", view_order_id);

        // Fetch tracking data from API
        $.ajax({
          url: `/api/orders/${view_order_id}/tracking`,
          method: "GET",
          dataType: "json",
          success: function (response) {
            if (response.success && response.data) {
              // Show the timeline container
              const timelineContainer = document.getElementById(
                "orderTrackingTimeline",
              );
              if (timelineContainer) {
                timelineContainer.style.display = "block";
              }

              // Update timeline with data
              if (window.updateOrderTrackingTimeline) {
                window.updateOrderTrackingTimeline(response.data);
              }

              // Start real-time updates
              if (window.startTrackingRealTimeUpdates) {
                window.startTrackingRealTimeUpdates(view_order_id);
              }

              console.log("Order tracking timeline updated:", response.data);
            } else {
              console.warn("No tracking data available for this order");
            }
          },
          error: function (xhr, status, error) {
            console.error("Error loading order tracking:", error);
          },
        });

        // Get all ordered products for stock checking
        // We'll set these after the table loads
        setTimeout(() => {
          try {
            const tableApi = $("#orderProductTable").DataTable();
            if (tableApi) {
              const rowsData = tableApi.rows().data();

              // Convert DataTable API object to array
              let allProducts = [];
              if (rowsData && typeof rowsData === "object") {
                // If it's a DataTable API object, iterate through it
                for (let i = 0; i < rowsData.length; i++) {
                  allProducts.push(rowsData[i]);
                }
              }

              if (allProducts.length > 0) {
                const products = [];

                // Collect all products with their quantities
                allProducts.forEach((product) => {
                  const product_master_id =
                    product?.product_master_id || product?.ProductMaster?.id;
                  const quantity_required_kg = product?.quantity || 0;

                  if (product_master_id && quantity_required_kg > 0) {
                    products.push({
                      product_master_id,
                      quantity_required_kg,
                    });
                  }
                });

                // Store all products in view_order_no attributes for use in confirm button
                if (products.length > 0) {
                  $("#view_order_no").attr(
                    "ordered_products",
                    JSON.stringify(products),
                  );
                  $("#view_order_no").attr("product_count", products.length);
                }
              }
            }
          } catch (error) {
            console.error("Error accessing order products table:", error);
          }
        }, 500);
      });

