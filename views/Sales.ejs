          buttons: {
            submit: {
              text: "Raise Purchase Request",
              btnClass: "btn-orange",
              action: function () {
                const supplierId = $("#purchaseSupplier").val();
                const purchaseQuantity = $("#purchaseQuantity").val();
                const remarks = $("#purchaseRemarks").val();

                // Get the selected raw material ID from radio buttons
                const selectedRawMaterial = $(
                  'input[name="rawMaterial"]:checked',
                ).val();

                if (!selectedRawMaterial) {
                  toastr.error(
