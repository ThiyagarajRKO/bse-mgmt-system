            let errorMsg = "Failed to confirm order";
            if (xhr.responseJSON && xhr.responseJSON.message) {
              errorMsg = xhr.responseJSON.message;
            }
            toastr.error(errorMsg, "Error");
          });
      });

      function loadOrdersProductTableData(order_id) {
        console.log(
          "🔍 loadOrdersProductTableData called with order_id:",
          order_id,
        );
        if (!order_id) {
          console.error("❌ No order_id provided");
          toastr["warning"]("Orders data should not be empty!");
          return;
        }

        // Validate UUID format
        const uuidRegex =
          /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
        if (!uuidRegex.test(order_id)) {
          console.error("❌ Invalid order_id format:", order_id);
          toastr["error"]("Invalid order ID format");
          return;
        }

        console.log("📊 Initializing DataTable for order products...");
        console.log(
          "📊 DataTable URL will be:",
          `/api/orders/product?order_id=${order_id}`,
        );
        console.log("📊 order_id value:", order_id, "type:", typeof order_id);

        // Add a small delay to ensure the modal is fully rendered
        setTimeout(() => {
          try {
            // Clear any existing DataTable instance first
            if ($.fn.DataTable.isDataTable("#orderProductTable")) {
              console.log("📊 Destroying existing DataTable");
              $("#orderProductTable").DataTable().clear().destroy();
            }

            // Clear any existing table content
            $("#orderProductTable tbody").empty();

            console.log("📊 Making AJAX request to load data");
            // Load data via AJAX first, then initialize DataTable
            $.ajax({
              type: "GET",
              url: `/api/orders/product?order_id=${order_id}`,
              xhrFields: {
                withCredentials: true,
              },
              timeout: 10000, // 10 second timeout
              success: function (response, textStatus, xhr) {
                console.log("✅ AJAX success:", response);
                console.log("✅ Response status:", xhr.status);
                console.log(
                  "✅ Data type:",
                  typeof response,
                  "Is object:",
                  typeof response === "object",
                );

                // Validate response - backend returns DataTable format
                if (
                  !response ||
                  typeof response !== "object" ||
                  !Array.isArray(response.data)
                ) {
                  console.error(
                    "❌ Expected DataTable response format but got:",
                    response,
                  );
                  toastr.error("Invalid response format from server");
                  return;
                }

                const data = response.data; // Extract the actual data array
                console.log(
                  "📊 Creating DataTable with",
                  data.length,
                  "products",
                );

                // Initialize DataTable with the loaded data
                $("#orderProductTable").DataTable({
                  data: data,
                  responsive: false,
                  processing: false, // Disable processing since data is already loaded
                  serverSide: false,
                  scrollX: true,
                  scrollCollapse: true,
                  scrollY: "40vh",
                  ordering: false,
                  paging: false,
                  columns: [
                    { data: null, defaultContent: "" }, // Edit button column
                    { data: null, defaultContent: "" }, // Delete button column
                    {
                      data: "ProductMaster.product_name",
                      defaultContent: "Unknown Product",
                    },
                    { data: "quantity", defaultContent: "0" },
                    { data: "price", defaultContent: "0.00" },
                    { data: "total_price", defaultContent: "0.00" },
                  ],
                  columnDefs: [
                    {
                      targets: [0],
                      className: "text-left",
                      render: function (data, type, row) {
                        return `<i class="fa fa-pen-to-square edit editOrders" order_id="${order_id}" order_product_id="${
                          row?.id || null
                        }" aria-hidden="true" style="font-size:15px;color:#f07b3f" data-toggle="tooltip" data-placement="top" title="Click this button to edit this product"></i>`;
                      },
                    },
                    {
                      targets: [1],
                      className: "text-left",
                      render: function (data, type, row) {
                        return `<i class="fa fa-trash del delOrderProduct" order_id="${order_id}" order_product_id="${row["id"]}" aria-hidden="true" style="font-size:15px;color:#f07b3f" data-toggle="tooltip" data-placement="top" title="Click this button to delete this order"></i>`;
                      },
                    },
                  ],
                  language: {
                    emptyTable: "No products found for this order",
                  },
                  drawCallback: function () {
                    console.log("📊 DataTable draw callback - table rendered");
                    // Re-initialize tooltips after table draw
                    $('[data-toggle="tooltip"]').tooltip();
                  },
                });

                console.log("✅ DataTable initialized successfully");
              },
              error: function (xhr, error, code) {
                console.error("❌ AJAX error:", xhr, error, code);
                console.error("❌ Response text:", xhr.responseText);
                console.error("❌ Status:", xhr.status);

                // Initialize table with error message
                $("#orderProductTable").DataTable({
                  destroy: true,
                  responsive: false,
                  processing: false,
                  serverSide: false,
                  scrollX: true,
                  ordering: false,
                  paging: false,
                  data: [],
                  columns: [
                    { data: null, defaultContent: "" },
                    { data: null, defaultContent: "" },
                    { data: null, defaultContent: "Error loading data" },
                    { data: null, defaultContent: "" },
                    { data: null, defaultContent: "" },
                    { data: null, defaultContent: "" },
                  ],
                  language: {
                    emptyTable:
                      "Error loading products. Please check your connection and try again.",
                  },
                });

                if (xhr["status"] == 420) {
                  toastr["warning"](xhr["responseJSON"]["message"]);
                } else if (xhr["status"] == 401 || xhr["status"] == 403) {
                  toastr["error"](
                    "Authentication required. Please log in again.",
                  );
                } else {
                  toastr["error"](
                    xhr["responseJSON"]?.message ||
                      "Failed to load order products. Please try again.",
                  );
                }
              },
            });
          } catch (error) {
            console.error("❌ DataTable initialization error:", error);
            toastr.error("Failed to initialize order products table");
          }
        }, 200); // Increased delay to ensure modal is rendered
      }

