<!-- @format -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sales Invoices - BSE</title>

    <!-- title logo -->
    <link rel="icon" href="/public/images/bse.png" type="image/icon type" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap -->
    <link href="/public/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <script src="/public/plugins/bootstrap/js/bootstrap.min.js"></script>

    <!-- MDB5 -->
    <link href="/public/plugins/MDB5-7.2.0/css/mdb.min.css" rel="stylesheet" />
    <script src="/public/plugins/MDB5-7.2.0/js/mdb.umd.min.js"></script>

    <!-- jQuery -->
    <script src="/public/plugins/jquery/jquery.min.js"></script>

    <!-- Select2 -->
    <link rel="stylesheet" href="/public/plugins/select2/css/select2.min.css" />
    <script src="/public/plugins/select2/js/select2.min.js"></script>

    <!-- DataTable -->
    <link rel="stylesheet" href="/public/plugins/dataTables/datatables.min.css" />
    <script src="/public/plugins/dataTables/datatables.min.js"></script>
    <script src="/public/plugins/dataTables/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="/public/plugins/dataTables/datatables.responsive.min.css" />
    <script src="/public/plugins/dataTables/datatables.responsive.min.js"></script>

    <!-- Toast -->
    <link rel="stylesheet" href="/public/plugins/Toastr/toastr.min.css" />
    <script src="/public/plugins/Toastr/toastr.min.js"></script>

    <!-- jQuery Confirm -->
    <link rel="stylesheet" href="/public/plugins/jquery-confirm/css/jquery-confirm.min.css" />
    <script src="/public/plugins/jquery-confirm/js/jquery-confirm.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/public/css/style.css" />

    <!-- Custom Script -->
    <script src="/public/custom/App.js"></script>

    <style type="text/css">
      body {
        background-color: #f4f3ef;
        padding: 20px;
      }

      .invoice-container {
        background: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
      }

      .invoice-header {
        border-bottom: 3px solid #1976d2;
        padding-bottom: 20px;
        margin-bottom: 30px;
      }

      .invoice-table {
        width: 100%;
        border-collapse: collapse;
      }

      .invoice-table thead {
        background-color: #f5f5f5;
      }

      .invoice-table th {
        padding: 12px;
        text-align: left;
        font-weight: 600;
        color: #333;
      }

      .invoice-table td {
        padding: 12px;
        border-bottom: 1px solid #e0e0e0;
      }

      .btn-group-action {
        display: flex;
        gap: 5px;
      }

      .status-badge {
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
      }

      .status-draft {
        background-color: #e3f2fd;
        color: #1565c0;
      }

      .status-posted {
        background-color: #c8e6c9;
        color: #2e7d32;
      }

      .status-cancelled {
        background-color: #ffcdd2;
        color: #c62828;
      }

      .form-section {
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
      }

      .summary-box {
        background-color: #e3f2fd;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #1976d2;
      }

      .line-items-section {
        margin-top: 30px;
        margin-bottom: 30px;
      }

      .add-item-btn {
        margin-bottom: 20px;
      }

      .charges-section {
        background-color: #fafafa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
      }

      .total-section {
        background-color: #e8f5e9;
        padding: 20px;
        border-radius: 8px;
        margin-top: 20px;
      }

      .total-row {
        display: flex;
        justify-content: space-between;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 10px;
      }

      .total-amount {
        font-size: 24px;
        color: #2e7d32;
        font-weight: 700;
      }
    </style>
  </head>

  <body>
    <div class="container-fluid">
      <!-- Page Header -->
      <div class="invoice-container invoice-header">
        <div class="row align-items-center">
          <div class="col-md-6">
            <h2 class="mb-0">
              <i class="fas fa-file-invoice"></i> Sales Invoices
            </h2>
          </div>
          <div class="col-md-6 text-end">
            <button class="btn btn-primary btn-lg" id="btnCreateInvoice">
              <i class="fas fa-plus"></i> Create New Invoice
            </button>
          </div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item">
              <a class="nav-link active" id="list-tab" data-bs-toggle="tab" href="#list-panel" role="tab">
                <i class="fas fa-list"></i> Invoice List
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="create-tab" data-bs-toggle="tab" href="#create-panel" role="tab">
                <i class="fas fa-plus-circle"></i> Create Invoice
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" id="summary-tab" data-bs-toggle="tab" href="#summary-panel" role="tab">
                <i class="fas fa-chart-bar"></i> Revenue Summary
              </a>
            </li>
          </ul>
        </div>

        <div class="tab-content card-body">
          <!-- Invoice List Tab -->
          <div class="tab-pane fade show active" id="list-panel" role="tabpanel">
            <div class="table-responsive">
              <table id="invoiceTable" class="table table-hover">
                <thead>
                  <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Order Reference</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Posted</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </div>

          <!-- Create Invoice Tab -->
          <div class="tab-pane fade" id="create-panel" role="tabpanel">
            <div class="invoice-container">
              <h4 class="mb-4">Create New Sales Invoice</h4>

              <!-- Invoice Header Form -->
              <div class="form-section">
                <h5 class="mb-3">Invoice Information</h5>
                <div class="row">
                  <div class="col-md-4 mb-3">
                    <label for="invoiceNumber" class="form-label">Invoice Number</label>
                    <input type="text" class="form-control" id="invoiceNumber" readonly />
                  </div>
                  <div class="col-md-4 mb-3">
                    <label for="invoiceDate" class="form-label">Date</label>
                    <input type="date" class="form-control" id="invoiceDate" required />
                  </div>
                  <div class="col-md-4 mb-3">
                    <label for="dueDate" class="form-label">Due Date</label>
                    <input type="date" class="form-control" id="dueDate" required />
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="customerSelect" class="form-label">Customer</label>
                    <select class="form-select" id="customerSelect" required>
                      <option value="">-- Select Customer --</option>
                    </select>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label for="orderReference" class="form-label">Order Reference</label>
                    <input type="text" class="form-control" id="orderReference" />
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6 mb-3">
                    <label for="shippingLocation" class="form-label">Shipping Location</label>
                    <select class="form-select" id="shippingLocation">
                      <option value="">-- Select Location --</option>
                    </select>
                  </div>
                  <div class="col-md-6 mb-3">
                    <label for="invoiceNotes" class="form-label">Notes</label>
                    <textarea class="form-control" id="invoiceNotes" rows="2"></textarea>
                  </div>
                </div>
              </div>

              <!-- Line Items Section -->
              <div class="line-items-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h5>Line Items</h5>
                  <button class="btn btn-sm btn-success add-item-btn" id="btnAddItem">
                    <i class="fas fa-plus"></i> Add Item
                  </button>
                </div>

                <div class="table-responsive">
                  <table class="invoice-table" id="lineItemsTable">
                    <thead>
                      <tr>
                        <th>Product</th>
                        <th>HSN Code</th>
                        <th>Quantity</th>
                        <th>Unit</th>
                        <th>Rate</th>
                        <th>Discount %</th>
                        <th>Amount</th>
                        <th>Tax Rate %</th>
                        <th>Tax Amount</th>
                        <th>Total</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody id="lineItemsBody"></tbody>
                  </table>
                </div>
              </div>

              <!-- Charges Section -->
              <div class="charges-section">
                <h5 class="mb-3">Additional Charges & Adjustments</h5>
                <div class="row">
                  <div class="col-md-3 mb-3">
                    <label for="shippingCharge" class="form-label">Shipping Charge</label>
                    <input type="number" class="form-control" id="shippingCharge" value="0" step="0.01" />
                  </div>
                  <div class="col-md-3 mb-3">
                    <label for="packingCharge" class="form-label">Packing Charge</label>
                    <input type="number" class="form-control" id="packingCharge" value="0" step="0.01" />
                  </div>
                  <div class="col-md-3 mb-3">
                    <label for="otherCharge" class="form-label">Other Charges</label>
                    <input type="number" class="form-control" id="otherCharge" value="0" step="0.01" />
                  </div>
                  <div class="col-md-3 mb-3">
                    <label for="discountAmount" class="form-label">Total Discount</label>
                    <input type="number" class="form-control" id="discountAmount" value="0" step="0.01" />
                  </div>
                </div>
              </div>

              <!-- Total Section -->
              <div class="total-section">
                <div class="total-row">
                  <span>Subtotal:</span>
                  <span id="subtotal">₹ 0.00</span>
                </div>
                <div class="total-row">
                  <span>Total Tax:</span>
                  <span id="totalTax">₹ 0.00</span>
                </div>
                <div class="total-row">
                  <span>Shipping:</span>
                  <span id="shipping">₹ 0.00</span>
                </div>
                <div class="total-row">
                  <span>Total Discount:</span>
                  <span id="discount">₹ 0.00</span>
                </div>
                <hr />
                <div class="total-row">
                  <span class="total-amount">Grand Total:</span>
                  <span class="total-amount" id="grandTotal">₹ 0.00</span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="mt-4">
                <button class="btn btn-primary btn-lg" id="btnSaveInvoice">
                  <i class="fas fa-save"></i> Save Invoice
                </button>
                <button class="btn btn-success btn-lg ms-2" id="btnSaveAndPost">
                  <i class="fas fa-check"></i> Save & Post to GL
                </button>
                <button class="btn btn-secondary btn-lg ms-2" id="btnClearForm">
                  <i class="fas fa-redo"></i> Clear
                </button>
              </div>
            </div>
          </div>

          <!-- Revenue Summary Tab -->
          <div class="tab-pane fade" id="summary-panel" role="tabpanel">
            <div class="invoice-container">
              <h4 class="mb-4">Revenue Summary</h4>

              <div class="row mb-4">
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Total Invoices</div>
                    <div class="h3" id="totalInvoices">0</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Total Revenue</div>
                    <div class="h3" id="totalRevenue">₹ 0.00</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Posted Invoices</div>
                    <div class="h3" id="postedInvoices">0</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Average Invoice Value</div>
                    <div class="h3" id="avgInvoiceValue">₹ 0.00</div>
                  </div>
                </div>
              </div>

              <div id="revenueSummaryContent"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoice Detail Modal -->
    <div class="modal fade" id="invoiceDetailModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="invoiceDetailTitle">Invoice Details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body" id="invoiceDetailContent"></div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary" id="btnPostInvoice">
              <i class="fas fa-paper-plane"></i> Post to GL
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      $(document).ready(function () {
        // Initialize DataTable
        let invoiceTable = $("#invoiceTable").DataTable({
          processing: true,
          serverSide: true,
          ajax: {
            url: "/api/sales/invoices",
            type: "GET",
            data: function (d) {
              return $.extend({}, d, {
                draw: d.draw,
                start: d.start,
                length: d.length,
              });
            },
          },
          columns: [
            { data: "invoice_number" },
            { data: "invoice_date" },
            { data: "customer.customer_name" },
            { data: "order_reference" },
            { data: "total_amount" },
            {
              data: "status",
              render: function (data) {
                let badgeClass = "status-draft";
                if (data === "posted") badgeClass = "status-posted";
                if (data === "cancelled") badgeClass = "status-cancelled";
                return `<span class="status-badge ${badgeClass}">${data.toUpperCase()}</span>`;
              },
            },
            {
              data: "is_posted",
              render: function (data) {
                return data ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>';
              },
            },
            {
              data: null,
              render: function (data) {
                return `
                  <div class="btn-group-action">
                    <button class="btn btn-sm btn-info" onclick="viewInvoice('${data.id}')">
                      <i class="fas fa-eye"></i>
                    </button>
                    ${data.status === "draft" ? `<button class="btn btn-sm btn-warning" onclick="editInvoice('${data.id}')"><i class="fas fa-edit"></i></button>` : ""}
                    ${data.status === "draft" ? `<button class="btn btn-sm btn-danger" onclick="cancelInvoice('${data.id}')"><i class="fas fa-trash"></i></button>` : ""}
                  </div>
                `;
              },
            },
          ],
          pageLength: 10,
          language: {
            emptyTable: "No invoices found",
            loadingRecords: "Loading invoices...",
          },
        });

        // Set today's date as default
        document.getElementById("invoiceDate").valueAsDate = new Date();
        document.getElementById("dueDate").valueAsDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000);

        // Create New Invoice Button
        $("#btnCreateInvoice").on("click", function () {
          $("a[href='#create-panel']").tab("show");
        });

        // Add Line Item
        let itemCount = 0;
        $("#btnAddItem").on("click", function () {
          itemCount++;
          let html = `
            <tr class="line-item" data-item-id="${itemCount}">
              <td><input type="text" class="form-control form-control-sm product-name" placeholder="Product" /></td>
              <td><input type="text" class="form-control form-control-sm hsn-code" placeholder="HSN" readonly /></td>
              <td><input type="number" class="form-control form-control-sm quantity" value="1" step="0.01" /></td>
              <td><input type="text" class="form-control form-control-sm unit" placeholder="Unit" readonly /></td>
              <td><input type="number" class="form-control form-control-sm rate" value="0" step="0.01" /></td>
              <td><input type="number" class="form-control form-control-sm discount-pct" value="0" step="0.01" /></td>
              <td><input type="number" class="form-control form-control-sm amount" readonly /></td>
              <td><input type="number" class="form-control form-control-sm tax-rate" value="0" step="0.01" /></td>
              <td><input type="number" class="form-control form-control-sm tax-amount" readonly /></td>
              <td><input type="number" class="form-control form-control-sm total" readonly /></td>
              <td><button type="button" class="btn btn-sm btn-danger" onclick="removeLineItem(${itemCount})"><i class="fas fa-trash"></i></button></td>
            </tr>
          `;
          $("#lineItemsBody").append(html);
        });

        // Save Invoice
        $("#btnSaveInvoice").on("click", function () {
          let invoiceData = {
            invoice_date: $("#invoiceDate").val(),
            due_date: $("#dueDate").val(),
            customer_id: $("#customerSelect").val(),
            order_reference: $("#orderReference").val(),
            shipping_location_id: $("#shippingLocation").val(),
            notes: $("#invoiceNotes").val(),
          };

          $.ajax({
            url: "/api/sales/invoices",
            method: "POST",
            contentType: "application/json",
            data: JSON.stringify(invoiceData),
            success: function (response) {
              toastr.success("Invoice saved successfully!");
              invoiceTable.ajax.reload();
              $("a[href='#list-panel']").tab("show");
            },
            error: function (err) {
              toastr.error("Error saving invoice: " + err.responseJSON.message);
            },
          });
        });
      });

      function viewInvoice(id) {
        $.ajax({
          url: `/api/sales/invoices/${id}`,
          method: "GET",
          success: function (response) {
            let content = `
              <div class="invoice-detail">
                <p><strong>Invoice #:</strong> ${response.data.invoice_number}</p>
                <p><strong>Date:</strong> ${new Date(response.data.invoice_date).toLocaleDateString()}</p>
                <p><strong>Customer:</strong> ${response.data.customer.customer_name}</p>
                <p><strong>Amount:</strong> ₹ ${response.data.total_amount}</p>
              </div>
            `;
            $("#invoiceDetailContent").html(content);
            $("#invoiceDetailModal").modal("show");
          },
        });
      }

      function removeLineItem(itemId) {
        $(`tr[data-item-id="${itemId}"]`).remove();
      }
    </script>
  </body>
</html>
