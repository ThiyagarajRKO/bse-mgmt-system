<!-- @format -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sales Invoices - BSE</title>

    <!-- title logo -->
    <link rel="icon" href="/public/images/bse.png" type="image/icon type" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <!-- Bootstrap -->
    <link
      href="/public/plugins/bootstrap/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script src="/public/plugins/bootstrap/js/bootstrap.min.js"></script>

    <!-- MDB5 -->
    <link href="/public/plugins/MDB5-7.2.0/css/mdb.min.css" rel="stylesheet" />
    <script src="/public/plugins/MDB5-7.2.0/js/mdb.umd.min.js"></script>

    <!-- jQuery -->
    <script src="/public/plugins/jquery/jquery.min.js"></script>

    <!-- Select2 -->
    <link rel="stylesheet" href="/public/plugins/select2/css/select2.min.css" />
    <script src="/public/plugins/select2/js/select2.min.js"></script>

    <!-- DataTable -->
    <link
      rel="stylesheet"
      href="/public/plugins/dataTables/datatables.min.css"
    />
    <script src="/public/plugins/dataTables/datatables.min.js"></script>
    <script src="/public/plugins/dataTables/dataTables.bootstrap5.min.js"></script>
    <link
      rel="stylesheet"
      href="/public/plugins/dataTables/datatables.responsive.min.css"
    />
    <script src="/public/plugins/dataTables/datatables.responsive.min.js"></script>

    <!-- Toast -->
    <link rel="stylesheet" href="/public/plugins/Toastr/toastr.min.css" />
    <script src="/public/plugins/Toastr/toastr.min.js"></script>

    <!-- jQuery Confirm -->
    <link
      rel="stylesheet"
      href="/public/plugins/jquery-confirm/css/jquery-confirm.min.css"
    />
    <script src="/public/plugins/jquery-confirm/js/jquery-confirm.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="/public/css/style.css" />

    <!-- Custom Script -->
    <script src="/public/custom/App.js"></script>

    <style type="text/css">
      body {
        background-color: #f4f3ef;
        padding: 20px;
      }

      .invoice-container {
        background: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
      }

      .invoice-header {
        border-bottom: 3px solid #1976d2;
        padding-bottom: 20px;
        margin-bottom: 30px;
      }

      .invoice-table {
        width: 100%;
        border-collapse: collapse;
      }

      .invoice-table thead {
        background-color: #f5f5f5;
      }

      .invoice-table th {
        padding: 12px;
        text-align: left;
        font-weight: 600;
        color: #333;
      }

      .invoice-table td {
        padding: 12px;
        border-bottom: 1px solid #e0e0e0;
      }

      .btn-group-action {
        display: flex;
        gap: 5px;
      }

      .status-badge {
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
      }

      .status-draft {
        background-color: #e3f2fd;
        color: #1565c0;
      }

      .status-posted {
        background-color: #c8e6c9;
        color: #2e7d32;
      }

      .status-cancelled {
        background-color: #ffcdd2;
        color: #c62828;
      }

      .form-section {
        background-color: #f9f9f9;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
      }

      .summary-box {
        background-color: #e3f2fd;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #1976d2;
      }

      .line-items-section {
        margin-top: 30px;
        margin-bottom: 30px;
      }

      .add-item-btn {
        margin-bottom: 20px;
      }

      .charges-section {
        background-color: #fafafa;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
      }

      .total-section {
        background-color: #e8f5e9;
        padding: 20px;
        border-radius: 8px;
        margin-top: 20px;
      }

      .total-row {
        display: flex;
        justify-content: space-between;
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 10px;
      }

      .total-amount {
        font-size: 24px;
        color: #2e7d32;
        font-weight: 700;
      }
    </style>
  </head>

  <body>
    <div class="container-fluid">
      <!-- Page Header -->
      <div class="invoice-container invoice-header">
        <div class="row align-items-center">
          <div class="col-md-6">
            <h2 class="mb-0">
              <i class="fas fa-file-invoice"></i> Sales Invoices
            </h2>
          </div>
          <div class="col-md-6 text-end">
            <button class="btn btn-primary btn-lg" id="btnCreateInvoice">
              <i class="fas fa-plus"></i> Create New Invoice
            </button>
          </div>
        </div>
      </div>

      <!-- Tabs -->
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item">
              <a
                class="nav-link active"
                id="list-tab"
                data-bs-toggle="tab"
                href="#list-panel"
                role="tab"
              >
                <i class="fas fa-list"></i> Invoice List
              </a>
            </li>
            <li class="nav-item">
              <a
                class="nav-link"
                id="create-tab"
                data-bs-toggle="tab"
                href="#create-panel"
                role="tab"
              >
                <i class="fas fa-plus-circle"></i> Create Invoice
              </a>
            </li>
            <li class="nav-item">
              <a
                class="nav-link"
                id="summary-tab"
                data-bs-toggle="tab"
                href="#summary-panel"
                role="tab"
              >
                <i class="fas fa-chart-bar"></i> Revenue Summary
              </a>
            </li>
          </ul>
        </div>

        <div class="tab-content card-body">
          <!-- Invoice List Tab -->
          <div
            class="tab-pane fade show active"
            id="list-panel"
            role="tabpanel"
          >
            <div class="table-responsive">
              <table id="invoiceTable" class="table table-hover">
                <thead>
                  <tr>
                    <th>Invoice #</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Order Reference</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Posted</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </div>

          <!-- Generate Invoices Tab -->
          <div class="tab-pane fade" id="create-panel" role="tabpanel">
            <div class="invoice-container">
              <h4 class="mb-4">Generate Invoices from Orders</h4>

              <!-- Pending Orders Section -->
              <div class="form-section">
                <h5 class="mb-3">📋 Pending Orders Ready for Invoicing</h5>
                <p class="text-muted mb-3">
                  Select orders to automatically generate invoices with line
                  items populated from order details.
                </p>

                <div class="table-responsive">
                  <table id="pendingOrdersTable" class="table table-hover">
                    <thead>
                      <tr>
                        <th><input type="checkbox" id="selectAllOrders" /></th>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Total Items</th>
                        <th>Total Value</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div>

              <!-- Generation Options -->
              <div class="form-section">
                <h5 class="mb-3">⚙️ Generation Options</h5>
                <div class="row">
                  <div class="col-md-6 mb-3">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="autoGenerateLines"
                        checked
                      />
                      <label class="form-check-label" for="autoGenerateLines">
                        Auto-populate line items from orders
                      </label>
                    </div>
                  </div>
                  <div class="col-md-6 mb-3">
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="checkbox"
                        id="autoPostToGL"
                      />
                      <label class="form-check-label" for="autoPostToGL">
                        Automatically post to GL after generation
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Bulk Actions -->
              <div class="mt-4">
                <button class="btn btn-success btn-lg" id="btnGenerateSelected">
                  <i class="fas fa-magic"></i> Generate Selected Invoices
                </button>
                <button class="btn btn-info btn-lg ms-2" id="btnGenerateAll">
                  <i class="fas fa-star"></i> Generate All Pending
                </button>
                <button
                  class="btn btn-secondary btn-lg ms-2"
                  id="btnRefreshOrders"
                >
                  <i class="fas fa-sync"></i> Refresh Orders
                </button>
              </div>

              <!-- Generation Status -->
              <div id="generationStatus" class="mt-4" style="display: none">
                <div class="alert alert-info">
                  <i class="fas fa-hourglass-start"></i> Generating invoices...
                  <span id="generationProgress"></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Revenue Summary Tab -->
          <div class="tab-pane fade" id="summary-panel" role="tabpanel">
            <div class="invoice-container">
              <h4 class="mb-4">Revenue Summary</h4>

              <div class="row mb-4">
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Total Invoices</div>
                    <div class="h3" id="totalInvoices">0</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Total Revenue</div>
                    <div class="h3" id="totalRevenue">₹ 0.00</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Posted Invoices</div>
                    <div class="h3" id="postedInvoices">0</div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="summary-box">
                    <div class="text-muted mb-2">Average Invoice Value</div>
                    <div class="h3" id="avgInvoiceValue">₹ 0.00</div>
                  </div>
                </div>
              </div>

              <div id="revenueSummaryContent"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoice Detail Modal -->
    <div class="modal fade" id="invoiceDetailModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="invoiceDetailTitle">Invoice Details</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body" id="invoiceDetailContent"></div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Close
            </button>
            <button type="button" class="btn btn-primary" id="btnPostInvoice">
              <i class="fas fa-paper-plane"></i> Post to GL
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      $(document).ready(function () {
        // Initialize invoice list DataTable
        let invoiceTable = $("#invoiceTable").DataTable({
          processing: true,
          serverSide: true,
          ajax: {
            url: "/api/sales/invoices",
            type: "GET",
          },
          columns: [
            { data: "invoice_number" },
            { data: "invoice_date" },
            { data: "customer.customer_name" },
            { data: "order_reference" },
            { data: "total_amount" },
            {
              data: "status",
              render: function (data) {
                let badgeClass = "status-draft";
                if (data === "posted") badgeClass = "status-posted";
                if (data === "cancelled") badgeClass = "status-cancelled";
                return `<span class="status-badge ${badgeClass}">${data.toUpperCase()}</span>`;
              },
            },
            {
              data: "is_posted",
              render: function (data) {
                return data
                  ? '<i class="fas fa-check text-success"></i>'
                  : '<i class="fas fa-times text-danger"></i>';
              },
            },
            {
              data: null,
              render: function (data) {
                return `
                  <div class="btn-group-action">
                    <button class="btn btn-sm btn-info" onclick="viewInvoice('${data.id}')">
                      <i class="fas fa-eye"></i>
                    </button>
                    ${data.status === "draft" ? `<button class="btn btn-sm btn-warning" onclick="editInvoice('${data.id}')"><i class="fas fa-edit"></i></button>` : ""}
                    ${data.status === "draft" ? `<button class="btn btn-sm btn-danger" onclick="cancelInvoice('${data.id}')"><i class="fas fa-trash"></i></button>` : ""}
                  </div>
                `;
              },
            },
          ],
          pageLength: 10,
        });

        // Initialize pending orders DataTable
        let pendingOrdersTable = $("#pendingOrdersTable").DataTable({
          processing: true,
          serverSide: true,
          ajax: {
            url: "/api/sales/invoices/pending-orders",
            type: "GET",
          },
          columns: [
            {
              data: null,
              render: function (data) {
                return `<input type="checkbox" class="order-select" value="${data.id}" />`;
              },
              orderable: false,
              searchable: false,
            },
            { data: "order_no" },
            { data: "order_date" },
            { data: "customer_master.customer_name" },
            { data: "order_status" },
            { data: "total_items" },
            { data: "total_value" },
            {
              data: null,
              render: function (data) {
                return `<button class="btn btn-sm btn-primary" onclick="generateSingleInvoice('${data.id}')">
                  <i class="fas fa-file-invoice"></i> Generate
                </button>`;
              },
              orderable: false,
            },
          ],
          pageLength: 10,
        });

        // Select all orders checkbox
        $("#selectAllOrders").on("change", function () {
          const isChecked = $(this).is(":checked");
          $(".order-select").prop("checked", isChecked);
        });

        // Generate selected invoices
        $("#btnGenerateSelected").on("click", function () {
          const selectedOrders = $(".order-select:checked")
            .map(function () {
              return $(this).val();
            })
            .get();

          if (selectedOrders.length === 0) {
            toastr.warning("Please select at least one order");
            return;
          }

          generateInvoices(selectedOrders);
        });

        // Generate all pending invoices
        $("#btnGenerateAll").on("click", function () {
          $.confirm({
            title: "Generate All Pending Invoices?",
            content:
              "This will generate invoices for all pending orders. Continue?",
            buttons: {
              confirm: function () {
                generateAllPending();
              },
              cancel: function () {},
            },
          });
        });

        // Refresh orders list
        $("#btnRefreshOrders").on("click", function () {
          pendingOrdersTable.ajax.reload();
          toastr.info("Orders list refreshed");
        });
      });

      function generateInvoices(orderIds) {
        $("#generationStatus").show();
        $("#generationProgress").text(
          `Processing ${orderIds.length} orders...`,
        );

        $.ajax({
          url: "/api/sales/invoices/bulk-generate",
          method: "POST",
          contentType: "application/json",
          data: JSON.stringify({
            order_ids: orderIds,
            auto_generate_lines: $("#autoGenerateLines").is(":checked"),
            post_to_gl: $("#autoPostToGL").is(":checked"),
          }),
          success: function (response) {
            $("#generationStatus").hide();
            toastr.success(
              `Successfully generated ${response.data.length} invoices!`,
            );

            // Reload both tables
            $("#invoiceTable").DataTable().ajax.reload();
            $("#pendingOrdersTable").DataTable().ajax.reload();

            // Clear selections
            $("#selectAllOrders").prop("checked", false);
            $(".order-select").prop("checked", false);
          },
          error: function (err) {
            $("#generationStatus").hide();
            toastr.error(
              "Error generating invoices: " + err.responseJSON.message,
            );
          },
        });
      }

      function generateAllPending() {
        $("#generationStatus").show();
        $("#generationProgress").text("Processing all pending orders...");

        $.ajax({
          url: "/api/sales/invoices/generate-all-pending",
          method: "POST",
          contentType: "application/json",
          data: JSON.stringify({
            auto_generate_lines: $("#autoGenerateLines").is(":checked"),
            post_to_gl: $("#autoPostToGL").is(":checked"),
          }),
          success: function (response) {
            $("#generationStatus").hide();
            toastr.success(
              `Successfully generated ${response.data.generated} invoices!`,
            );

            // Reload tables
            $("#invoiceTable").DataTable().ajax.reload();
            $("#pendingOrdersTable").DataTable().ajax.reload();
          },
          error: function (err) {
            $("#generationStatus").hide();
            toastr.error(
              "Error generating invoices: " + err.responseJSON.message,
            );
          },
        });
      }

      function generateSingleInvoice(orderId) {
        generateInvoices([orderId]);
      }

      function viewInvoice(id) {
        $.ajax({
          url: `/api/sales/invoices/${id}`,
          method: "GET",
          success: function (response) {
            let content = `
              <div class="invoice-detail">
                <p><strong>Invoice #:</strong> ${response.data.invoice_number}</p>
                <p><strong>Date:</strong> ${new Date(response.data.invoice_date).toLocaleDateString()}</p>
                <p><strong>Customer:</strong> ${response.data.customer.customer_name}</p>
                <p><strong>Amount:</strong> ₹ ${parseFloat(response.data.total_amount).toFixed(2)}</p>
                <p><strong>Status:</strong> <span class="status-badge status-${response.data.status}">${response.data.status.toUpperCase()}</span></p>
              </div>
            `;
            $("#invoiceDetailContent").html(content);
            $("#invoiceDetailModal").modal("show");
          },
        });
      }

      function editInvoice(id) {
        toastr.info("Edit functionality coming soon");
      }

      function cancelInvoice(id) {
        $.confirm({
          title: "Cancel Invoice?",
          content: "This will mark the invoice as cancelled. Continue?",
          buttons: {
            confirm: function () {
              $.ajax({
                url: `/api/sales/invoices/${id}/cancel`,
                method: "PUT",
                success: function () {
                  toastr.success("Invoice cancelled successfully");
                  $("#invoiceTable").DataTable().ajax.reload();
                },
                error: function (err) {
                  toastr.error(
                    "Error cancelling invoice: " + err.responseJSON.message,
                  );
                },
              });
            },
            cancel: function () {},
          },
        });
      }
    </script>
  </body>
</html>
