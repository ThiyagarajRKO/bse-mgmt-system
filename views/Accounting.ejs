        <!-- Costing View -->
        <div id="costingView" class="col-12" style="display: none">
          <div class="content-card">
            <div class="content-header">
              <h3>Production Costing</h3>
              <button
                class="btn btn-create btn-action"
                id="calculateCostingBtn"
              >
                <i class="fa-solid fa-calculator"></i> Calculate
              </button>
