    <!-- Create Journal Entry Modal -->
    <div class="modal fade" id="createJournalModal" tabindex="-1">
      <div class="modal-dialog modal-lg">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Create Journal Entry</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="journalForm">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label">Entry Date</label>
                  <input
                    type="date"
                    class="form-control"
                    id="entryDate"
                    required
                  />
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label">Reference Type</label>
                  <select class="form-select" id="refType" required>
                    <option value="">Select...</option>
                    <option value="PROCUREMENT">Procurement</option>
                    <option value="PRODUCTION">Production</option>
                    <option value="SALES">Sales</option>
                    <option value="PAYMENT">Payment</option>
                    <option value="OTHER">Other</option>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label">Description</label>
                <input
                  type="text"
                  class="form-control"
                  id="description"
                  required
                />
              </div>

              <div class="mb-3">
                <label class="form-label">Journal Lines</label>
                <div id="journalLinesContainer">
                  <div class="journal-line mb-3 p-3 border rounded">
                    <div class="row">
                      <div class="col-md-4 mb-2">
                        <label class="form-label">Account</label>
                        <select class="form-select account-select" required>
                          <option value="">Select Account</option>
                        </select>
                      </div>
                      <div class="col-md-4 mb-2">
                        <label class="form-label">Debit</label>
                        <input
                          type="number"
                          class="form-control debit-input"
                          step="0.01"
                        />
                      </div>
                      <div class="col-md-4 mb-2">
                        <label class="form-label">Credit</label>
                        <input
                          type="number"
                          class="form-control credit-input"
                          step="0.01"
                        />
                      </div>
                    </div>
                    <button
                      type="button"
                      class="btn btn-sm btn-danger remove-line"
                    >
                      Remove
                    </button>
                  </div>
                </div>
                <button
                  type="button"
                  class="btn btn-sm btn-secondary"
                  id="addLineBtn"
                >
                  Add Line
                </button>
              </div>

              <div class="mb-3 p-3 bg-light rounded">
                <div class="row">
                  <div class="col-md-6">
                    <strong>Total Debit:</strong>
                    <span id="totalDebitDisplay">0.00</span>
                  </div>
                  <div class="col-md-6">
                    <strong>Total Credit:</strong>
                    <span id="totalCreditDisplay">0.00</span>
                  </div>
                </div>
              </div>
            </form>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button type="button" class="btn btn-primary" id="submitJournalBtn">
              Submit
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Initialize
      $(document).ready(function () {
        toastr.options = {
          closeButton: true,
          progressBar: true,
          positionClass: "toast-top-right",
          timeOut: "4000",
        };

        // Top menu switching
        $(".topMenu-item").click(function () {
          $(".topMenu-item").removeClass("topMenu-item-active");
          $(this).addClass("topMenu-item-active");

          // Hide all views
          $("[id$='View']").hide();

          // Show selected view
          const viewId = $(this).attr("id").replace("Menu", "View");
          $("#" + viewId).show();

          // Load data if needed
          if ($(this).attr("id") === "journalMenu") {
            loadJournalEntries();
          } else if ($(this).attr("id") === "chartMenu") {
            loadChartOfAccounts();
          } else if ($(this).attr("id") === "arMenu") {
            loadAR();
          } else if ($(this).attr("id") === "apMenu") {
            loadAP();
          } else if ($(this).attr("id") === "costingMenu") {
            loadCosting();
          }
        });

        // Create journal entry buttons
        $("#createJournalBtn, #createJournalBtn2").click(function () {
          $("#journalForm")[0].reset();
          $("#journalLinesContainer").html(`
            <div class="journal-line mb-3 p-3 border rounded">
              <div class="row">
                <div class="col-md-4 mb-2">
                  <label class="form-label">Account</label>
                  <select class="form-select account-select" required>
                    <option value="">Select Account</option>
                  </select>
                </div>
                <div class="col-md-4 mb-2">
                  <label class="form-label">Debit</label>
                  <input type="number" class="form-control debit-input" step="0.01" />
                </div>
                <div class="col-md-4 mb-2">
                  <label class="form-label">Credit</label>
                  <input type="number" class="form-control credit-input" step="0.01" />
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-danger remove-line">Remove</button>
            </div>
          `);
          new bootstrap.Modal(
            document.getElementById("createJournalModal"),
          ).show();
        });

        // Add line button
        $(document).on("click", "#addLineBtn", function () {
          const newLine = `
            <div class="journal-line mb-3 p-3 border rounded">
              <div class="row">
                <div class="col-md-4 mb-2">
                  <label class="form-label">Account</label>
                  <select class="form-select account-select" required>
                    <option value="">Select Account</option>
                  </select>
                </div>
                <div class="col-md-4 mb-2">
                  <label class="form-label">Debit</label>
                  <input type="number" class="form-control debit-input" step="0.01" />
                </div>
                <div class="col-md-4 mb-2">
                  <label class="form-label">Credit</label>
                  <input type="number" class="form-control credit-input" step="0.01" />
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-danger remove-line">Remove</button>
            </div>
          `;
          $("#journalLinesContainer").append(newLine);
        });

        // Remove line button
        $(document).on("click", ".remove-line", function () {
          $(this).closest(".journal-line").remove();
        });

        // Calculate totals
        $(document).on(
          "change input",
          ".debit-input, .credit-input",
          function () {
            let totalDebit = 0;
            let totalCredit = 0;
            $(".journal-line").each(function () {
              totalDebit += parseFloat($(this).find(".debit-input").val()) || 0;
              totalCredit +=
                parseFloat($(this).find(".credit-input").val()) || 0;
            });
            $("#totalDebitDisplay").text(totalDebit.toFixed(2));
            $("#totalCreditDisplay").text(totalCredit.toFixed(2));
          },
        );

        // Submit journal entry
        $("#submitJournalBtn").click(function () {
          const totalDebit = parseFloat($("#totalDebitDisplay").text());
          const totalCredit = parseFloat($("#totalCreditDisplay").text());

          if (Math.abs(totalDebit - totalCredit) > 0.01) {
            toastr.error("Total Debit must equal Total Credit");
            return;
          }

          toastr.success("Journal entry created successfully");
          bootstrap.Modal.getInstance(
            document.getElementById("createJournalModal"),
          ).hide();
        });

        // Load dashboard data
        loadDashboardData();
      });

      function loadDashboardData() {
        // Populate dashboard metrics
        $("#totalRevenue").text("₹0.00");
        $("#totalExpense").text("₹0.00");
        $("#grossProfit").text("₹0.00");
        $("#outstandingAR").text("₹0.00");
      }

      function loadJournalEntries() {
        // Load journal entries from API
        console.log("Loading journal entries...");
      }

      function loadChartOfAccounts() {
        // Load chart of accounts from API
        console.log("Loading chart of accounts...");
      }

      function loadAR() {
        // Load AR data from API
        console.log("Loading AR...");
      }

      function loadAP() {
        // Load AP data from API
        console.log("Loading AP...");
      }

      function loadCosting() {
        // Load costing data from API
        console.log("Loading costing...");
      }

      // ===== INVOICES FUNCTIONALITY =====

      // Load invoices on view toggle
      $("#invoicesMenu").click(function () {
        showView("invoices");
        loadInvoices();
      });

      // New Invoice button - switch to create tab
      $("#createInvoiceBtn").click(function () {
        $("#invoiceTabs").find('a[href="#invoiceCreateView"]').tab("show");
        resetInvoiceForm();
        loadInvoiceCustomers();
      });

      // Add Line Item button
      $("#addLineItemBtn").click(function () {
        const lineRow = `
          <tr class="invoice-line">
            <td>
              <select class="form-select product-select" required>
                <option value="">Select Product</option>
              </select>
            </td>
            <td>
              <input type="number" class="form-control qty-input" value="1" min="1" required />
            </td>
            <td>
              <input type="number" class="form-control rate-input" value="0" step="0.01" required />
            </td>
            <td>
              <input type="number" class="form-control amount-input" value="0" step="0.01" readonly />
            </td>
            <td>
              <input type="number" class="form-control tax-input" value="0" step="0.01" min="0" max="100" />
            </td>
            <td>
              <input type="number" class="form-control tax-amt-input" value="0" step="0.01" readonly />
            </td>
            <td>
              <input type="number" class="form-control total-input" value="0" step="0.01" readonly />
            </td>
            <td>
              <button type="button" class="btn btn-sm btn-danger remove-line-btn">
                <i class="fa-solid fa-trash"></i>
              </button>
            </td>
          </tr>
        `;
        $("#invoiceLineBody").append(lineRow);
        loadInvoiceProducts();
      });

      // Calculate line amounts
      $(document).on(
        "change keyup",
        ".qty-input, .rate-input, .tax-input",
        function () {
          const row = $(this).closest("tr");
          const qty = parseFloat(row.find(".qty-input").val()) || 0;
          const rate = parseFloat(row.find(".rate-input").val()) || 0;
          const tax = parseFloat(row.find(".tax-input").val()) || 0;

          const amount = qty * rate;
          const taxAmt = (amount * tax) / 100;
          const total = amount + taxAmt;

          row.find(".amount-input").val(amount.toFixed(2));
          row.find(".tax-amt-input").val(taxAmt.toFixed(2));
          row.find(".total-input").val(total.toFixed(2));

          updateInvoiceTotals();
        },
      );

      // Remove line item
      $(document).on("click", ".remove-line-btn", function () {
        $(this).closest("tr").remove();
        updateInvoiceTotals();
      });

      // Calculate invoice totals
      function updateInvoiceTotals() {
        let subtotal = 0;
        let totalTax = 0;

        $("#invoiceLineBody tr.invoice-line").each(function () {
          subtotal += parseFloat($(this).find(".amount-input").val()) || 0;
          totalTax += parseFloat($(this).find(".tax-amt-input").val()) || 0;
        });

        const shipping = parseFloat($("#shippingCharge").val()) || 0;
        const packing = parseFloat($("#packingCharge").val()) || 0;
        const other = parseFloat($("#otherCharge").val()) || 0;
        const discount = parseFloat($("#totalDiscount").val()) || 0;

        const grandTotal =
          subtotal + totalTax + shipping + packing + other - discount;

        $("#subtotalDisplay").text("₹" + subtotal.toFixed(2));
        $("#totalTaxDisplay").text("₹" + totalTax.toFixed(2));
        $("#grandTotalDisplay").text("₹" + grandTotal.toFixed(2));
      }

      // Charges & adjustments change handler
      $(document).on(
        "change keyup",
        "#shippingCharge, #packingCharge, #otherCharge, #totalDiscount",
        function () {
          updateInvoiceTotals();
        },
      );

      // Save Invoice
      $("#saveInvoiceBtn").click(function () {
        if (!validateInvoiceForm()) return;

        const invoiceData = getInvoiceFormData();
        saveInvoice(invoiceData, false);
      });

      // Save & Post Invoice
      $("#savePostInvoiceBtn").click(function () {
        if (!validateInvoiceForm()) return;

        const invoiceData = getInvoiceFormData();
        saveInvoice(invoiceData, true);
      });

      function validateInvoiceForm() {
        const customer = $("#customerSelect").val();
        const lineItems = $("#invoiceLineBody tr.invoice-line").length;

        if (!customer) {
          toastr.error("Please select a customer");
          return false;
        }

        if (lineItems === 0) {
          toastr.error("Please add at least one line item");
          return false;
        }

        return true;
      }

      function getInvoiceFormData() {
        const lineItems = [];
        $("#invoiceLineBody tr.invoice-line").each(function () {
          lineItems.push({
            product_id: $(this).find(".product-select").val(),
            quantity: parseFloat($(this).find(".qty-input").val()),
            rate: parseFloat($(this).find(".rate-input").val()),
            tax_percent: parseFloat($(this).find(".tax-input").val()),
            amount: parseFloat($(this).find(".amount-input").val()),
            tax_amount: parseFloat($(this).find(".tax-amt-input").val()),
            total: parseFloat($(this).find(".total-input").val()),
          });
        });

        return {
          invoice_date: $("#invDate").val(),
          due_date: $("#dueDate").val(),
          customer_id: $("#customerSelect").val(),
          order_ref: $("#orderRef").val(),
          line_items: lineItems,
          shipping_charge: parseFloat($("#shippingCharge").val()) || 0,
          packing_charge: parseFloat($("#packingCharge").val()) || 0,
          other_charge: parseFloat($("#otherCharge").val()) || 0,
          discount: parseFloat($("#totalDiscount").val()) || 0,
        };
      }

      function saveInvoice(data, shouldPost) {
        $.ajax({
          url: "/api/sales/invoices",
          type: "POST",
          contentType: "application/json",
          data: JSON.stringify(data),
          success: function (response) {
            toastr.success("Invoice saved successfully");
            if (shouldPost) {
              // Post the invoice (update status)
              $.ajax({
                url: `/api/sales/invoices/${response.id}`,
                type: "PUT",
                contentType: "application/json",
                data: JSON.stringify({ status: "posted" }),
                success: function () {
                  toastr.success("Invoice posted successfully");
                  resetInvoiceForm();
                  loadInvoices();
                  $("#invoiceTabs")
                    .find('a[href="#invoiceListView"]')
                    .tab("show");
                },
                error: function () {
                  toastr.error("Error posting invoice");
                },
              });
            } else {
              resetInvoiceForm();
              loadInvoices();
              $("#invoiceTabs").find('a[href="#invoiceListView"]').tab("show");
            }
          },
          error: function () {
            toastr.error("Error saving invoice");
          },
        });
      }

      function resetInvoiceForm() {
        $("#invoiceForm")[0].reset();
        $("#invoiceLineBody").empty();
        updateInvoiceTotals();
        const today = new Date().toISOString().split("T")[0];
        $("#invDate").val(today);
      }

      function loadInvoices() {
        $.ajax({
          url: "/api/sales/invoices",
          type: "GET",
          success: function (response) {
            populateInvoiceList(response);
            updateInvoiceSummary(response);
          },
          error: function () {
            toastr.error("Error loading invoices");
          },
        });
      }

      function populateInvoiceList(invoices) {
        const tbody = $("#invoiceListBody");
        tbody.empty();

        if (invoices.length === 0) {
          tbody.html(
            '<tr><td colspan="6" class="text-center text-muted">No invoices found</td></tr>',
          );
          return;
        }

        invoices.forEach(function (inv) {
          const statusBadge =
            inv.status === "posted"
              ? '<span class="badge bg-success">Posted</span>'
              : '<span class="badge bg-warning">Draft</span>';

          const row = `
            <tr>
              <td>${inv.invoice_number}</td>
              <td>${new Date(inv.invoice_date).toLocaleDateString()}</td>
              <td>${inv.customer_name}</td>
              <td>₹${parseFloat(inv.grand_total).toFixed(2)}</td>
              <td>${statusBadge}</td>
              <td>
                <button class="btn btn-sm btn-info edit-invoice" data-id="${inv.id}">
                  <i class="fa-solid fa-edit"></i>
                </button>
                <button class="btn btn-sm btn-danger delete-invoice" data-id="${inv.id}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
          `;
          tbody.append(row);
        });
      }

      function updateInvoiceSummary(invoices) {
        const totalInvoices = invoices.length;
        const totalRevenue = invoices.reduce(
          (sum, inv) => sum + parseFloat(inv.grand_total),
          0,
        );
        const postedCount = invoices.filter(
          (inv) => inv.status === "posted",
        ).length;
        const avgInvoice = totalInvoices > 0 ? totalRevenue / totalInvoices : 0;

        $("#totalInvoices").text(totalInvoices);
        $("#summaryTotalRevenue").text("₹" + totalRevenue.toFixed(2));
        $("#postedInvoices").text(postedCount);
        $("#avgInvoice").text("₹" + avgInvoice.toFixed(2));
      }

      function loadInvoiceCustomers() {
        $.ajax({
          url: "/api/customers",
          type: "GET",
          success: function (response) {
            const select = $("#customerSelect");
            select.find("option:not(:first)").remove();
            response.forEach(function (customer) {
              select.append(
                `<option value="${customer.id}">${customer.name}</option>`,
              );
            });
          },
        });
      }

      function loadInvoiceProducts() {
        $.ajax({
          url: "/api/products",
          type: "GET",
          success: function (response) {
            $(".product-select").find("option:not(:first)").remove();
            response.forEach(function (product) {
              $(".product-select").append(
                `<option value="${product.id}" data-price="${product.price}">${product.name}</option>`,
              );
            });
          },
        });
      }

      // Edit invoice (placeholder)
      $(document).on("click", ".edit-invoice", function () {
        toastr.info("Edit functionality coming soon");
      });

      // Delete invoice
      $(document).on("click", ".delete-invoice", function () {
        const id = $(this).data("id");
        if (confirm("Are you sure you want to delete this invoice?")) {
          $.ajax({
            url: `/api/sales/invoices/${id}`,
            type: "DELETE",
            success: function () {
              toastr.success("Invoice deleted successfully");
              loadInvoices();
            },
            error: function () {
              toastr.error("Error deleting invoice");
            },
          });
        }
      });
    </script>
  </body>
</html>
