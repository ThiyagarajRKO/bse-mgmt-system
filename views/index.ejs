<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SFE</title>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="/public/plugins/font-awesome/css/all.min.css" />

  <!-- MDB5  -->
  <link href="/public/plugins/MDB5-7.2.0/css/mdb.min.css" rel="stylesheet" />
  <script src="/public/plugins/MDB5-7.2.0/js/mdb.umd.min.js"></script>

  <!-- jQuery -->
  <script src="/public/plugins/jquery/jquery.min.js"></script>

  <!-- Select2 -->
  <link rel="stylesheet" href="/public/plugins/select2/css/select2.min.css" />
  <script src="/public/plugins/select2/js/select2.min.js"></script>

  <!-- Toastr -->
  <link rel="stylesheet" href="/public/plugins/Toastr/toastr.min.css" />
  <script src="/public/plugins/Toastr/toastr.min.js"></script>

  <style>
    /* Custom font faces removed - using system fonts instead */
  </style>
</head>

<body style="
      background-color: rgb(249, 243, 255);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      align-items:center;
      overflow: hidden;
    ">
  <div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="row justify-content-center align-items-center mx-auto">
      <div class="shadow col-sm-8 col-md-10 col-lg-12 p-4 bg-white mx-4" style="border-radius: 7px">
        <div class="d-flex justify-content-center">
          <div class="bg-danger d-flex justify-content-center align-items-center" style="
                margin-top: -5.5rem;
                width: 110px;
                height: 110px;
                border-radius: 50%;
              ">
            <div class="bg-white d-flex justify-content-center align-items-center"
              style="width: 100px; height: 100px; border-radius: 50%">
              <img src="/public/images/bse.png" style="height:8rem; width:6rem" alt="">
              <!-- <i class="fas fa-ambulance text-danger" style="font-size: 2rem"></i> -->
            </div>
          </div>
        </div>
        <div class="d-flex flex-column justify-content-center align-items-center mt-3">
          <label for="emergency label" style="font-family: 'CerebriSansPro-Regular';"
            class="text-danger text-center fs-8 h3">Seafood Exports - ERP</label>
          <hr class="text-muted" style="width: 100%" />
        </div>

        <div class="form-group mx-1 mt-2">
          <label for="username" class="mb-1">Username</label></span></label>
          <input type="text" class="form-control" id="username" placeholder="eg. BSE001" />
        </div>
        <div class="form-group mx-1 mt-2">
          <label for="password class=" mb-1">Password</label>
          <input type="password" class="form-control" id="password" placeholder="Password" />
        </div>

        <div class="form-group mx-1 mt-2">
          <label for="roles" class="mb-1">Role</label><br>
          <select class="form-control w-100" id="roles" name="roles" style="width: 100% !important;">
          </select>
        </div>

        <div class="mx-1 mt-3 pt-2 mb-1">
          <button type="submit" id="signin" class="btn btn-danger w-100">
            Login
          </button>
        </div>
      </div>
    </div>
  </div>
</body>
<script>
  jQuery(document).ready(function ($) {

    // Load Roles
    $.ajax({
      url: "/api/roles",
      method: "GET",
      dataType: "json",
      contentType: "application/json",
      crossDomain: true,
      processData: false,
      success: (resp) => {
        // Support multiple response shapes: { success:true, data: [..] } or
        // { success:true, data: { rows: [...] } } or legacy nested shapes.
        const list =
          (resp && resp.data && Array.isArray(resp.data)
            ? resp.data
            : resp && resp.data && resp.data.rows
            ? resp.data.rows
            : []);

        const select = $("#roles");

        // Populate native <option> elements as a fallback so Select2 has
        // visible options even if initialization timing or data binding
        // behaves unexpectedly in some browsers.
        select.empty();
        select.append('<option></option>');
        list.forEach((item) => {
          select.append(
            `<option value="${item.id}">${item.role_name}</option>`
          );
        });

        // Initialize Select2 using the DOM options (robust) and also set data
        // for search/autocomplete functionality.
        select.select2({
          placeholder: "Select a role (required)",
          allowClear: true,
          data: $.map(list, function (item) {
            return {
              id: item.id,
              text: item.role_name,
            };
          }),
        });
      },
      error: (jqXhr, textStatus, errorThrown) => {
        if (jqXhr["status"] == 420) {
          toastr["warning"](jqXhr["responseJSON"]["message"]);
        } else {
          toastr["error"](jqXhr["responseJSON"]["message"]);
        }
      },
    });


    // Login Function
    $("#signin").on("click", function () {

      const username = $("#username").val()
      const password = $("#password").val()
      const role_id = $("#roles").val()

      if (!username || !password) {
        toastr["warning"]("Username and password are required");
        return
      }

      if (!role_id) {
        toastr["warning"]("Role selection is mandatory");
        return
      }

      const role_name = $("#roles").select2("data")[0].text

      let input_params = {
        username,
        password,
        role_id,
      };
      $.ajax({
        url: "/api/auth/signin",
        method: "POST",
        dataType: "json",
        contentType: "application/json",
        data: JSON.stringify(input_params),
        // Ensure the browser accepts and stores the session cookie set by the server
        // and sends it on subsequent requests.
        xhrFields: { withCredentials: true },
        crossDomain: true,
        processData: false,
        success: function (data) {
          if (role_name == "Admin") {
            window.location.href = "AdminMain";
          } else {
            window.location.href = "citizenMain";
          }

          sessionStorage.setItem("username", Inputusername);
        },
        error: function (jqXhr, textStatus, errorThrown) {
          if (errorThrown == "Forbidden") {
            toastr["warning"]("Invalid login credential!");
          } else {
            toastr["error"](jqXhr["responseJSON"]["message"]);
          }
        },
      });
    })
  })
</script>

</html>